{
	"type": "root",
	"children": [
		{
			"type": "yaml",
			"value": "title: How to use environment variables in Next.js\nnav_title: Environment Variables\ndescription: Learn to add and access environment variables in your Next.js application."
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Next.js comes with built-in support for environment variables, which allows you to do the following:"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "link",
									"title": null,
									"url": "#loading-environment-variables",
									"children": [
										{
											"type": "text",
											"value": "Use "
										},
										{
											"type": "inlineCode",
											"value": ".env"
										},
										{
											"type": "text",
											"value": " to load environment variables"
										}
									]
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "link",
									"title": null,
									"url": "#bundling-environment-variables-for-the-browser",
									"children": [
										{
											"type": "text",
											"value": "Bundle environment variables for the browser by prefixing with "
										},
										{
											"type": "inlineCode",
											"value": "NEXT_PUBLIC_"
										}
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Warning:"
								}
							]
						},
						{
							"type": "text",
							"value": " The default "
						},
						{
							"type": "inlineCode",
							"value": "create-next-app"
						},
						{
							"type": "text",
							"value": " template ensures all "
						},
						{
							"type": "inlineCode",
							"value": ".env"
						},
						{
							"type": "text",
							"value": " files are added to your "
						},
						{
							"type": "inlineCode",
							"value": ".gitignore"
						},
						{
							"type": "text",
							"value": ". You almost never want to commit these files to your repository."
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Loading Environment Variables"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Next.js has built-in support for loading environment variables from "
				},
				{
					"type": "inlineCode",
					"value": ".env*"
				},
				{
					"type": "text",
					"value": " files into "
				},
				{
					"type": "inlineCode",
					"value": "process.env"
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "code",
			"lang": "txt",
			"meta": "filename=\".env\"",
			"value": "DB_HOST=localhost\nDB_USER=myuser\nDB_PASS=mypassword"
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Note"
								}
							]
						},
						{
							"type": "text",
							"value": ": Next.js also supports multiline variables inside of your "
						},
						{
							"type": "inlineCode",
							"value": ".env*"
						},
						{
							"type": "text",
							"value": " files:"
						}
					]
				},
				{
					"type": "code",
					"lang": "bash",
					"meta": null,
					"value": "# .env\n\n# you can write with line breaks\nPRIVATE_KEY=\"-----BEGIN RSA PRIVATE KEY-----\n...\nKh9NV...\n...\n-----END DSA PRIVATE KEY-----\"\n\n# or with `\\n` inside double quotes\nPRIVATE_KEY=\"-----BEGIN RSA PRIVATE KEY-----\\nKh9NV...\\n-----END DSA PRIVATE KEY-----\\n\""
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Note"
								}
							]
						},
						{
							"type": "text",
							"value": ": If you are using a "
						},
						{
							"type": "inlineCode",
							"value": "/src"
						},
						{
							"type": "text",
							"value": " folder, please note that Next.js will load the .env files "
						},
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "only"
								}
							]
						},
						{
							"type": "text",
							"value": " from the parent folder and "
						},
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "not"
								}
							]
						},
						{
							"type": "text",
							"value": " from the "
						},
						{
							"type": "inlineCode",
							"value": "/src"
						},
						{
							"type": "text",
							"value": " folder. This loads "
						},
						{
							"type": "inlineCode",
							"value": "process.env.DB_HOST"
						},
						{
							"type": "text",
							"value": ", "
						},
						{
							"type": "inlineCode",
							"value": "process.env.DB_USER"
						},
						{
							"type": "text",
							"value": ", and "
						},
						{
							"type": "inlineCode",
							"value": "process.env.DB_PASS"
						},
						{
							"type": "text",
							"value": " into the Node.js environment automatically allowing you to use them in "
						},
						{
							"type": "link",
							"title": null,
							"url": "../03-api-reference/03-file-conventions/route.md",
							"children": [
								{
									"type": "text",
									"value": "Route Handlers"
								}
							]
						},
						{
							"type": "text",
							"value": "."
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "For example:"
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"app/api/route.js\"",
			"value": "export async function GET() {\n\tconst db = await myDB.connect({\n\t\thost: process.env.DB_HOST,\n\t\tusername: process.env.DB_USER,\n\t\tpassword: process.env.DB_PASS,\n\t})\n\t// ...\n}"
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Loading Environment Variables with "
				},
				{
					"type": "inlineCode",
					"value": "@next/env"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "If you need to load environment variables outside of the Next.js runtime, such as in a root config file for an ORM or test runner, you can use the "
				},
				{
					"type": "inlineCode",
					"value": "@next/env"
				},
				{
					"type": "text",
					"value": " package."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "This package is used internally by Next.js to load environment variables from "
				},
				{
					"type": "inlineCode",
					"value": ".env*"
				},
				{
					"type": "text",
					"value": " files."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To use it, install the package and use the "
				},
				{
					"type": "inlineCode",
					"value": "loadEnvConfig"
				},
				{
					"type": "text",
					"value": " function to load the environment variables:"
				}
			]
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"pnpm\"",
			"value": "pnpm add @next/env"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"npm\"",
			"value": "npm install @next/env"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"yarn\"",
			"value": "yarn add @next/env"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"bun\"",
			"value": "bun add @next/env"
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"envConfig.ts\" switcher",
			"value": "import { loadEnvConfig } from '@next/env'\n\nconst projectDir = process.cwd()\nloadEnvConfig(projectDir)"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"envConfig.js\" switcher",
			"value": "import { loadEnvConfig } from '@next/env'\n\nconst projectDir = process.cwd()\nloadEnvConfig(projectDir)"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Then, you can import the configuration where needed. For example:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"orm.config.ts\" switcher",
			"value": "import './envConfig.ts'\n\nexport default defineConfig({\n\tdbCredentials: {\n\t\tconnectionString: process.env.DATABASE_URL!,\n\t},\n})"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"orm.config.js\" switcher",
			"value": "import './envConfig.js'\n\nexport default defineConfig({\n\tdbCredentials: {\n\t\tconnectionString: process.env.DATABASE_URL,\n\t},\n})"
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Referencing Other Variables"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Next.js will automatically expand variables that use "
				},
				{
					"type": "inlineCode",
					"value": "$"
				},
				{
					"type": "text",
					"value": " to reference other variables e.g. "
				},
				{
					"type": "inlineCode",
					"value": "$VARIABLE"
				},
				{
					"type": "text",
					"value": " inside of your "
				},
				{
					"type": "inlineCode",
					"value": ".env*"
				},
				{
					"type": "text",
					"value": " files. This allows you to reference other secrets. For example:"
				}
			]
		},
		{
			"type": "code",
			"lang": "txt",
			"meta": "filename=\".env\"",
			"value": "TWITTER_USER=nextjs\nTWITTER_URL=https://x.com/$TWITTER_USER"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "In the above example, "
				},
				{
					"type": "inlineCode",
					"value": "process.env.TWITTER_URL"
				},
				{
					"type": "text",
					"value": " would be set to "
				},
				{
					"type": "inlineCode",
					"value": "https://x.com/nextjs"
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know"
								}
							]
						},
						{
							"type": "text",
							"value": ": If you need to use variable with a "
						},
						{
							"type": "inlineCode",
							"value": "$"
						},
						{
							"type": "text",
							"value": " in the actual value, it needs to be escaped e.g. "
						},
						{
							"type": "inlineCode",
							"value": "\\$"
						},
						{
							"type": "text",
							"value": "."
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Bundling Environment Variables for the Browser"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Non-"
				},
				{
					"type": "inlineCode",
					"value": "NEXT_PUBLIC_"
				},
				{
					"type": "text",
					"value": " environment variables are only available in the Node.js environment, meaning they aren't accessible to the browser (the client runs in a different "
				},
				{
					"type": "emphasis",
					"children": [
						{
							"type": "text",
							"value": "environment"
						}
					]
				},
				{
					"type": "text",
					"value": ")."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "In order to make the value of an environment variable accessible in the browser, Next.js can \"inline\" a value, at build time, into the js bundle that is delivered to the client, replacing all references to "
				},
				{
					"type": "inlineCode",
					"value": "process.env.[variable]"
				},
				{
					"type": "text",
					"value": " with a hard-coded value. To tell it to do this, you just have to prefix the variable with "
				},
				{
					"type": "inlineCode",
					"value": "NEXT_PUBLIC_"
				},
				{
					"type": "text",
					"value": ". For example:"
				}
			]
		},
		{
			"type": "code",
			"lang": "txt",
			"meta": "filename=\".env\"",
			"value": "NEXT_PUBLIC_ANALYTICS_ID=abcdefghijk"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "This will tell Next.js to replace all references to "
				},
				{
					"type": "inlineCode",
					"value": "process.env.NEXT_PUBLIC_ANALYTICS_ID"
				},
				{
					"type": "text",
					"value": " in the Node.js environment with the value from the environment in which you run "
				},
				{
					"type": "inlineCode",
					"value": "next build"
				},
				{
					"type": "text",
					"value": ", allowing you to use it anywhere in your code. It will be inlined into any JavaScript sent to the browser."
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Note"
								}
							]
						},
						{
							"type": "text",
							"value": ": After being built, your app will no longer respond to changes to these environment variables. For instance, if you use a Heroku pipeline to promote slugs built in one environment to another environment, or if you build and deploy a single Docker image to multiple environments, all "
						},
						{
							"type": "inlineCode",
							"value": "NEXT_PUBLIC_"
						},
						{
							"type": "text",
							"value": " variables will be frozen with the value evaluated at build time, so these values need to be set appropriately when the project is built. If you need access to runtime environment values, you'll have to set up your own API to provide them to the client (either on demand or during initialization)."
						}
					]
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"pages/index.js\"",
			"value": "import setupAnalyticsService from '../lib/my-analytics-service'\n\n// 'NEXT_PUBLIC_ANALYTICS_ID' can be used here as it's prefixed by 'NEXT_PUBLIC_'.\n// It will be transformed at build time to `setupAnalyticsService('abcdefghijk')`.\nsetupAnalyticsService(process.env.NEXT_PUBLIC_ANALYTICS_ID)\n\nfunction HomePage() {\n\treturn <h1>Hello World</h1>\n}\n\nexport default HomePage"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Note that dynamic lookups will "
				},
				{
					"type": "emphasis",
					"children": [
						{
							"type": "text",
							"value": "not"
						}
					]
				},
				{
					"type": "text",
					"value": " be inlined, such as:"
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": null,
			"value": "// This will NOT be inlined, because it uses a variable\nconst varName = 'NEXT_PUBLIC_ANALYTICS_ID'\nsetupAnalyticsService(process.env[varName])\n\n// This will NOT be inlined, because it uses a variable\nconst env = process.env\nsetupAnalyticsService(env.NEXT_PUBLIC_ANALYTICS_ID)"
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Runtime Environment Variables"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Next.js can support both build time and runtime environment variables."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "By default, environment variables are only available on the server"
						}
					]
				},
				{
					"type": "text",
					"value": ". To expose an environment variable to the browser, it must be prefixed with "
				},
				{
					"type": "inlineCode",
					"value": "NEXT_PUBLIC_"
				},
				{
					"type": "text",
					"value": ". However, these public environment variables will be inlined into the JavaScript bundle during "
				},
				{
					"type": "inlineCode",
					"value": "next build"
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "You can safely read environment variables on the server during dynamic rendering:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/page.ts\" switcher",
			"value": "import { connection } from 'next/server'\n\nexport default async function Component() {\n\tawait connection()\n\t// cookies, headers, and other Request-time APIs\n\t// will also opt into dynamic rendering, meaning\n\t// this env variable is evaluated at runtime\n\tconst value = process.env.MY_VALUE\n\t// ...\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/page.js\" switcher",
			"value": "import { connection } from 'next/server'\n\nexport default async function Component() {\n\tawait connection()\n\t// cookies, headers, and other Request-time APIs\n\t// will also opt into dynamic rendering, meaning\n\t// this env variable is evaluated at runtime\n\tconst value = process.env.MY_VALUE\n\t// ...\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "This allows you to use a singular Docker image that can be promoted through multiple environments with different values."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "Good to know:"
						}
					]
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "You can run code on server startup using the "
								},
								{
									"type": "link",
									"title": null,
									"url": "./instrumentation.md",
									"children": [
										{
											"type": "inlineCode",
											"value": "register"
										},
										{
											"type": "text",
											"value": " function"
										}
									]
								},
								{
									"type": "text",
									"value": "."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Test Environment Variables"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Apart from "
