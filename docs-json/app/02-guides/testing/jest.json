			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "If your project is using "
				},
				{
					"type": "link",
					"title": null,
					"url": "../../01-getting-started/01-installation.md#set-up-absolute-imports-and-module-path-aliases",
					"children": [
						{
							"type": "text",
							"value": "Module Path Aliases"
						}
					]
				},
				{
					"type": "text",
					"value": ", you will need to configure Jest to resolve the imports by matching the paths option in the "
				},
				{
					"type": "inlineCode",
					"value": "jsconfig.json"
				},
				{
					"type": "text",
					"value": " file with the "
				},
				{
					"type": "inlineCode",
					"value": "moduleNameMapper"
				},
				{
					"type": "text",
					"value": " option in the "
				},
				{
					"type": "inlineCode",
					"value": "jest.config.js"
				},
				{
					"type": "text",
					"value": " file. For example:"
				}
			]
		},
		{
			"type": "code",
			"lang": "json",
			"meta": "filename=\"tsconfig.json or jsconfig.json\"",
			"value": "{\n\t\"compilerOptions\": {\n\t\t\"module\": \"esnext\",\n\t\t\"moduleResolution\": \"bundler\",\n\t\t\"baseUrl\": \"./\",\n\t\t\"paths\": {\n\t\t\t\"@/components/*\": [\"components/*\"]\n\t\t}\n\t}\n}"
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"jest.config.js\"",
			"value": "moduleNameMapper: {\n  // ...\n  '^@/components/(.*)$': '<rootDir>/components/$1',\n}"
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
