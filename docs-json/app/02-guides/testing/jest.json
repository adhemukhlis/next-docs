			"type": "code",
			"lang": "json",
			"meta": "filename=\"package.json\" highlight={6-7}",
			"value": "{\n\t\"scripts\": {\n\t\t\"dev\": \"next dev\",\n\t\t\"build\": \"next build\",\n\t\t\"start\": \"next start\",\n\t\t\"test\": \"jest\",\n\t\t\"test:watch\": \"jest --watch\"\n\t}\n}"
		},
