		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Update your config file to use "
				},
				{
					"type": "inlineCode",
					"value": "next/jest"
				},
				{
					"type": "text",
					"value": ". This transformer has all the necessary configuration options for Jest to work with Next.js:"
