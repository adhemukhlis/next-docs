		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"jest.config.js\" switcher",
			"value": "setupFilesAfterEnv: ['<rootDir>/jest.setup.js']"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Then, inside "
				},
				{
					"type": "inlineCode",
