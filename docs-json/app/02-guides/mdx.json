		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Update the "
				},
				{
					"type": "inlineCode",
					"value": "next.config.mjs"
				},
				{
					"type": "text",
					"value": " file at your project's root to configure it to use MDX:"
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.mjs\"",
			"value": "import createMDX from '@next/mdx'\n\n/** @type {import('next').NextConfig} */\nconst nextConfig = {\n\t// Configure `pageExtensions` to include markdown and MDX files\n\tpageExtensions: ['js', 'jsx', 'md', 'mdx', 'ts', 'tsx'],\n\t// Optionally, add any other Next.js config below\n}\n\nconst withMDX = createMDX({\n\t// Add markdown plugins here, as desired\n})\n\n// Merge MDX config with Next.js config\nexport default withMDX(nextConfig)"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "This allows "
				},
				{
					"type": "inlineCode",
					"value": ".mdx"
				},
				{
					"type": "text",
					"value": " files to act as pages, routes, or imports in your application."
