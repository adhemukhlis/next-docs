		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Install dependencies"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The "
				},
				{
					"type": "inlineCode",
					"value": "@next/mdx"
				},
				{
					"type": "text",
					"value": " package, and related packages, are used to configure Next.js so it can process markdown and MDX. "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "It sources data from local files"
						}
					]
				},
				{
					"type": "text",
					"value": ", allowing you to create pages with a "
				},
				{
					"type": "inlineCode",
					"value": ".md"
				},
				{
					"type": "text",
					"value": " or "
				},
				{
					"type": "inlineCode",
					"value": ".mdx"
				},
				{
					"type": "text",
					"value": " extension, directly in your "
				},
				{
					"type": "inlineCode",
					"value": "/pages"
				},
				{
					"type": "text",
					"value": " or "
				},
				{
					"type": "inlineCode",
					"value": "/app"
				},
				{
					"type": "text",
					"value": " directory."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Install these packages to render MDX with Next.js:"
				}
			]
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"pnpm\"",
			"value": "pnpm add @next/mdx @mdx-js/loader @mdx-js/react @types/mdx"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"npm\"",
			"value": "npm install @next/mdx @mdx-js/loader @mdx-js/react @types/mdx"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"yarn\"",
			"value": "yarn add @next/mdx @mdx-js/loader @mdx-js/react @types/mdx"
		},
		{
			"type": "code",
			"lang": "bash",
