			"lang": "ts",
			"meta": "filename=\"proxy.ts\" switcher",
			"value": "import { NextResponse, NextRequest } from 'next/server'\nimport { get } from '@vercel/global-config'\n\ntype RedirectEntry = {\n\tdestination: string\n\tpermanent: boolean\n}\n\nexport async function proxy(request: NextRequest) {\n\tconst pathname = request.nextUrl.pathname\n\tconst redirectData = await get(pathname)\n\n\tif (redirectData && typeof redirectData === 'string') {\n\t\tconst redirectEntry: RedirectEntry = JSON.parse(redirectData)\n\t\tconst statusCode = redirectEntry.permanent ? 308 : 307\n\t\treturn NextResponse.redirect(redirectEntry.destination, statusCode)\n\t}\n\n\t// No redirect found, continue without redirecting\n\treturn NextResponse.next()\n}"
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"proxy.js\" switcher",
			"value": "import { NextResponse } from 'next/server'\nimport { get } from '@vercel/global-config'\n\nexport async function proxy(request) {\n\tconst pathname = request.nextUrl.pathname\n\tconst redirectData = await get(pathname)\n\n\tif (redirectData) {\n\t\tconst redirectEntry = JSON.parse(redirectData)\n\t\tconst statusCode = redirectEntry.permanent ? 308 : 307\n\t\treturn NextResponse.redirect(redirectEntry.destination, statusCode)\n\t}\n\n\t// No redirect found, continue without redirecting\n\treturn NextResponse.next()\n}"
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "2. Optimizing data lookup performance"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Reading a large dataset for every incoming request can be slow and expensive. There are two ways you can optimize data lookup performance:"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Use a database that is optimized for fast reads"
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Use a data lookup strategy such as a "
								},
								{
									"type": "link",
									"title": null,
									"url": "https://en.wikipedia.org/wiki/Bloom_filter",
									"children": [
										{
											"type": "text",
											"value": "Bloom filter"
										}
									]
								},
								{
									"type": "text",
									"value": " to efficiently check if a redirect exists "
								},
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "before"
										}
									]
								},
								{
									"type": "text",
									"value": " reading the larger redirects file or database."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Considering the previous example, you can import a generated bloom filter file into Proxy, then, check if the incoming request pathname exists in the bloom filter."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "If it does, forward the request to a "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/03-file-conventions/route.md",
					"children": [
						{
							"type": "text",
							"value": "Route Handler"
						}
					]
				},
				{
					"type": "text",
					"value": " which will check the actual file and redirect the user to the appropriate URL. This avoids importing a large redirects file into Proxy, which can slow down every incoming request."
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": "filename=\"proxy.ts\" switcher",
			"value": "import { NextResponse, NextRequest } from 'next/server'\nimport { ScalableBloomFilter } from 'bloom-filters'\nimport GeneratedBloomFilter from './redirects/bloom-filter.json'\n\ntype RedirectEntry = {\n\tdestination: string\n\tpermanent: boolean\n}\n\n// Initialize bloom filter from a generated JSON file\nconst bloomFilter = ScalableBloomFilter.fromJSON(GeneratedBloomFilter as any)\n\nexport async function proxy(request: NextRequest) {\n\t// Get the path for the incoming request\n\tconst pathname = request.nextUrl.pathname\n\n\t// Check if the path is in the bloom filter\n\tif (bloomFilter.has(pathname)) {\n\t\t// Forward the pathname to the Route Handler\n\t\tconst api = new URL(`/api/redirects?pathname=${encodeURIComponent(request.nextUrl.pathname)}`, request.nextUrl.origin)\n\n\t\ttry {\n\t\t\t// Fetch redirect data from the Route Handler\n\t\t\tconst redirectData = await fetch(api)\n\n\t\t\tif (redirectData.ok) {\n\t\t\t\tconst redirectEntry: RedirectEntry | undefined = await redirectData.json()\n\n\t\t\t\tif (redirectEntry) {\n\t\t\t\t\t// Determine the status code\n\t\t\t\t\tconst statusCode = redirectEntry.permanent ? 308 : 307\n\n\t\t\t\t\t// Redirect to the destination\n\t\t\t\t\treturn NextResponse.redirect(redirectEntry.destination, statusCode)\n\t\t\t\t}\n\t\t\t}\n\t\t} catch (error) {\n\t\t\tconsole.error(error)\n\t\t}\n\t}\n\n\t// No redirect found, continue the request without redirecting\n\treturn NextResponse.next()\n}"
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"proxy.js\" switcher",
			"value": "import { NextResponse } from 'next/server'\nimport { ScalableBloomFilter } from 'bloom-filters'\nimport GeneratedBloomFilter from './redirects/bloom-filter.json'\n\n// Initialize bloom filter from a generated JSON file\nconst bloomFilter = ScalableBloomFilter.fromJSON(GeneratedBloomFilter)\n\nexport async function proxy(request) {\n\t// Get the path for the incoming request\n\tconst pathname = request.nextUrl.pathname\n\n\t// Check if the path is in the bloom filter\n\tif (bloomFilter.has(pathname)) {\n\t\t// Forward the pathname to the Route Handler\n\t\tconst api = new URL(`/api/redirects?pathname=${encodeURIComponent(request.nextUrl.pathname)}`, request.nextUrl.origin)\n\n\t\ttry {\n\t\t\t// Fetch redirect data from the Route Handler\n\t\t\tconst redirectData = await fetch(api)\n\n\t\t\tif (redirectData.ok) {\n\t\t\t\tconst redirectEntry = await redirectData.json()\n\n\t\t\t\tif (redirectEntry) {\n\t\t\t\t\t// Determine the status code\n\t\t\t\t\tconst statusCode = redirectEntry.permanent ? 308 : 307\n\n\t\t\t\t\t// Redirect to the destination\n\t\t\t\t\treturn NextResponse.redirect(redirectEntry.destination, statusCode)\n\t\t\t\t}\n\t\t\t}\n\t\t} catch (error) {\n\t\t\tconsole.error(error)\n\t\t}\n\t}\n\n\t// No redirect found, continue the request without redirecting\n\treturn NextResponse.next()\n}"
		},
