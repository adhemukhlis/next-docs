			"children": [
				{
					"type": "text",
					"value": "Configuring CSS-in-JS in "
				},
				{
					"type": "inlineCode",
					"value": "app"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Configuring CSS-in-JS is a three-step opt-in process that involves:"
				}
			]
		},
		{
			"type": "list",
			"ordered": true,
			"start": 1,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "A "
								},
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "style registry"
										}
									]
								},
								{
									"type": "text",
									"value": " to collect all CSS rules in a render."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "The new "
								},
								{
									"type": "inlineCode",
									"value": "useServerInsertedHTML"
								},
								{
									"type": "text",
									"value": " hook to inject rules before any content that might use them."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "A Client Component that wraps your app with the style registry during initial server-side rendering."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "inlineCode",
					"value": "styled-jsx"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Using "
				},
				{
					"type": "inlineCode",
					"value": "styled-jsx"
				},
				{
					"type": "text",
					"value": " in Client Components requires using "
				},
				{
					"type": "inlineCode",
					"value": "v5.1.0"
				},
				{
					"type": "text",
					"value": ". First, create a new registry:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/registry.tsx\" switcher",
			"value": "'use client'\n\nimport React, { useState } from 'react'\nimport { useServerInsertedHTML } from 'next/navigation'\nimport { StyleRegistry, createStyleRegistry } from 'styled-jsx'\n\nexport default function StyledJsxRegistry({ children }: { children: React.ReactNode }) {\n\t// Only create stylesheet once with lazy initial state\n\t// x-ref: https://reactjs.org/docs/hooks-reference.html#lazy-initial-state\n\tconst [jsxStyleRegistry] = useState(() => createStyleRegistry())\n\n\tuseServerInsertedHTML(() => {\n\t\tconst styles = jsxStyleRegistry.styles()\n\t\tjsxStyleRegistry.flush()\n\t\treturn <>{styles}</>\n\t})\n\n\treturn <StyleRegistry registry={jsxStyleRegistry}>{children}</StyleRegistry>\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/registry.js\" switcher",
			"value": "'use client'\n\nimport React, { useState } from 'react'\nimport { useServerInsertedHTML } from 'next/navigation'\nimport { StyleRegistry, createStyleRegistry } from 'styled-jsx'\n\nexport default function StyledJsxRegistry({ children }) {\n\t// Only create stylesheet once with lazy initial state\n\t// x-ref: https://reactjs.org/docs/hooks-reference.html#lazy-initial-state\n\tconst [jsxStyleRegistry] = useState(() => createStyleRegistry())\n\n\tuseServerInsertedHTML(() => {\n\t\tconst styles = jsxStyleRegistry.styles()\n\t\tjsxStyleRegistry.flush()\n\t\treturn <>{styles}</>\n\t})\n\n\treturn <StyleRegistry registry={jsxStyleRegistry}>{children}</StyleRegistry>\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Then, wrap your "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/03-file-conventions/layout.md#root-layout",
					"children": [
						{
							"type": "text",
							"value": "root layout"
						}
					]
				},
				{
					"type": "text",
					"value": " with the registry:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/layout.tsx\" switcher",
			"value": "import StyledJsxRegistry from './registry'\n\nexport default function RootLayout({ children }: { children: React.ReactNode }) {\n\treturn (\n\t\t<html>\n\t\t\t<body>\n\t\t\t\t<StyledJsxRegistry>{children}</StyledJsxRegistry>\n\t\t\t</body>\n\t\t</html>\n\t)\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/layout.js\" switcher",
			"value": "import StyledJsxRegistry from './registry'\n\nexport default function RootLayout({ children }) {\n\treturn (\n\t\t<html>\n\t\t\t<body>\n\t\t\t\t<StyledJsxRegistry>{children}</StyledJsxRegistry>\n\t\t\t</body>\n\t\t</html>\n\t)\n}"
		},
