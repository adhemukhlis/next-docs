			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Styled Components"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Below is an example of how to configure "
				},
				{
					"type": "inlineCode",
					"value": "styled-components@6"
				},
				{
					"type": "text",
					"value": " or newer:"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "First, enable styled-components in "
				},
				{
					"type": "inlineCode",
					"value": "next.config.js"
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\"",
			"value": "module.exports = {\n\tcompiler: {\n\t\tstyledComponents: true,\n\t},\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Then, use the "
				},
				{
					"type": "inlineCode",
					"value": "styled-components"
				},
				{
					"type": "text",
					"value": " API to create a global registry component to collect all CSS style rules generated during a render, and a function to return those rules. Then use the "
				},
				{
					"type": "inlineCode",
					"value": "useServerInsertedHTML"
				},
				{
					"type": "text",
					"value": " hook to inject the styles collected in the registry into the "
				},
				{
					"type": "inlineCode",
					"value": "<head>"
				},
				{
					"type": "text",
					"value": " HTML tag in the root layout."
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"lib/registry.tsx\" switcher",
			"value": "'use client'\n\nimport React, { useState } from 'react'\nimport { useServerInsertedHTML } from 'next/navigation'\nimport { ServerStyleSheet, StyleSheetManager } from 'styled-components'\n\nexport default function StyledComponentsRegistry({ children }: { children: React.ReactNode }) {\n\t// Only create stylesheet once with lazy initial state\n\t// x-ref: https://reactjs.org/docs/hooks-reference.html#lazy-initial-state\n\tconst [styledComponentsStyleSheet] = useState(() => new ServerStyleSheet())\n\n\tuseServerInsertedHTML(() => {\n\t\tconst styles = styledComponentsStyleSheet.getStyleElement()\n\t\tstyledComponentsStyleSheet.instance.clearTag()\n\t\treturn <>{styles}</>\n\t})\n\n\tif (typeof window !== 'undefined') return <>{children}</>\n\n\treturn <StyleSheetManager sheet={styledComponentsStyleSheet.instance}>{children}</StyleSheetManager>\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"lib/registry.js\" switcher",
			"value": "'use client'\n\nimport React, { useState } from 'react'\nimport { useServerInsertedHTML } from 'next/navigation'\nimport { ServerStyleSheet, StyleSheetManager } from 'styled-components'\n\nexport default function StyledComponentsRegistry({ children }) {\n\t// Only create stylesheet once with lazy initial state\n\t// x-ref: https://reactjs.org/docs/hooks-reference.html#lazy-initial-state\n\tconst [styledComponentsStyleSheet] = useState(() => new ServerStyleSheet())\n\n\tuseServerInsertedHTML(() => {\n\t\tconst styles = styledComponentsStyleSheet.getStyleElement()\n\t\tstyledComponentsStyleSheet.instance.clearTag()\n\t\treturn <>{styles}</>\n\t})\n\n\tif (typeof window !== 'undefined') return <>{children}</>\n\n\treturn <StyleSheetManager sheet={styledComponentsStyleSheet.instance}>{children}</StyleSheetManager>\n}"
		},
