		{
			"type": "yaml",
			"value": "title: How to set a Content Security Policy (CSP) for your Next.js application\nnav_title: Content Security Policy\ndescription: Learn how to set a Content Security Policy (CSP) for your Next.js application."
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "link",
					"title": null,
					"url": "https://developer.mozilla.org/docs/Web/HTTP/CSP",
					"children": [
						{
							"type": "text",
							"value": "Content Security Policy (CSP)"
						}
					]
				},
				{
					"type": "text",
					"value": " is important to guard your Next.js application against various security threats such as cross-site scripting (XSS), clickjacking, and other code injection attacks."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "By using CSP, developers can specify which origins are permissible for content sources, scripts, stylesheets, images, fonts, objects, media (audio, video), iframes, and more."
				}
			]
		},
		{
			"type": "html",
			"value": "<details>\n  <summary>Examples</summary>"
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "link",
									"title": null,
									"url": "https://github.com/vercel/next.js/tree/canary/examples/with-strict-csp",
									"children": [
										{
											"type": "text",
											"value": "Strict CSP"
										}
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "html",
			"value": "</details>"
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Nonces"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "A "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://developer.mozilla.org/docs/Web/HTML/Global_attributes/nonce",
					"children": [
						{
							"type": "text",
							"value": "nonce"
						}
					]
				},
				{
					"type": "text",
					"value": " is a unique, random string of characters created for a one-time use. It is used in conjunction with CSP to selectively allow certain inline scripts or styles to execute, bypassing strict CSP directives."
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Why use a nonce?"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "CSP can block both inline and external scripts to prevent attacks. A nonce lets you safely allow specific scripts to run—only if they include the matching nonce value."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "If an attacker wanted to load a script into your page, they'd need to guess the nonce value. That's why the nonce must be unpredictable and unique for every request."
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Adding a nonce with Proxy"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/03-file-conventions/proxy.md",
					"children": [
						{
							"type": "text",
							"value": "Proxy"
						}
					]
				},
				{
					"type": "text",
					"value": " enables you to add headers and generate nonces before the page renders."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Every time a page is viewed, a fresh nonce should be generated. This means that you "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "must use "
						},
						{
							"type": "link",
							"title": null,
							"url": "../04-glossary.md#dynamic-rendering",
							"children": [
								{
									"type": "text",
									"value": "dynamic rendering"
								}
							]
						},
						{
							"type": "text",
							"value": " to add nonces"
						}
					]
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "For example:"
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know"
								}
							]
						},
						{
							"type": "text",
							"value": ": In development, "
						},
						{
							"type": "inlineCode",
							"value": "'unsafe-eval'"
						},
						{
							"type": "text",
							"value": " is required because React uses "
						},
						{
							"type": "inlineCode",
							"value": "eval"
						},
						{
							"type": "text",
							"value": " to provide enhanced debugging information, such as reconstructing server-side error stacks in the browser. "
						},
						{
							"type": "inlineCode",
							"value": "unsafe-eval"
						},
						{
							"type": "text",
							"value": " is not required for production. Neither React nor Next.js use "
						},
						{
							"type": "inlineCode",
							"value": "eval"
						},
						{
							"type": "text",
							"value": " in production by default."
						}
					]
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": "filename=\"proxy.ts\" switcher",
			"value": "import { NextRequest, NextResponse } from 'next/server'\n\nexport function proxy(request: NextRequest) {\n\tconst nonce = Buffer.from(crypto.randomUUID()).toString('base64')\n\tconst isDev = process.env.NODE_ENV === 'development'\n\tconst cspHeader = `\n    default-src 'self';\n    script-src 'self' 'nonce-${nonce}' 'strict-dynamic'${isDev ? \" 'unsafe-eval'\" : ''};\n    style-src 'self' 'nonce-${nonce}';\n    img-src 'self' blob: data:;\n    font-src 'self';\n    object-src 'none';\n    base-uri 'self';\n    form-action 'self';\n    frame-ancestors 'none';\n    upgrade-insecure-requests;\n`\n\t// Replace newline characters and spaces\n\tconst contentSecurityPolicyHeaderValue = cspHeader.replace(/\\s{2,}/g, ' ').trim()\n\n\tconst requestHeaders = new Headers(request.headers)\n\trequestHeaders.set('x-nonce', nonce)\n\n\trequestHeaders.set('Content-Security-Policy', contentSecurityPolicyHeaderValue)\n\n\tconst response = NextResponse.next({\n\t\trequest: {\n\t\t\theaders: requestHeaders,\n\t\t},\n\t})\n\tresponse.headers.set('Content-Security-Policy', contentSecurityPolicyHeaderValue)\n\n\treturn response\n}"
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"proxy.js\" switcher",
			"value": "import { NextResponse } from 'next/server'\n\nexport function proxy(request) {\n\tconst nonce = Buffer.from(crypto.randomUUID()).toString('base64')\n\tconst isDev = process.env.NODE_ENV === 'development'\n\tconst cspHeader = `\n    default-src 'self';\n    script-src 'self' 'nonce-${nonce}' 'strict-dynamic'${isDev ? \" 'unsafe-eval'\" : ''};\n    style-src 'self' 'nonce-${nonce}';\n    img-src 'self' blob: data:;\n    font-src 'self';\n    object-src 'none';\n    base-uri 'self';\n    form-action 'self';\n    frame-ancestors 'none';\n    upgrade-insecure-requests;\n`\n\t// Replace newline characters and spaces\n\tconst contentSecurityPolicyHeaderValue = cspHeader.replace(/\\s{2,}/g, ' ').trim()\n\n\tconst requestHeaders = new Headers(request.headers)\n\trequestHeaders.set('x-nonce', nonce)\n\trequestHeaders.set('Content-Security-Policy', contentSecurityPolicyHeaderValue)\n\n\tconst response = NextResponse.next({\n\t\trequest: {\n\t\t\theaders: requestHeaders,\n\t\t},\n\t})\n\tresponse.headers.set('Content-Security-Policy', contentSecurityPolicyHeaderValue)\n\n\treturn response\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "By default, Proxy runs on all requests. You can filter Proxy to run on specific paths using a "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/03-file-conventions/proxy.md#matcher",
					"children": [
						{
							"type": "inlineCode",
							"value": "matcher"
						}
					]
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "We recommend ignoring matching prefetches (from "
				},
				{
					"type": "inlineCode",
					"value": "next/link"
				},
				{
					"type": "text",
					"value": ") and static assets that don't need the CSP header."
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": "filename=\"proxy.ts\" switcher",
			"value": "export const config = {\n\tmatcher: [\n\t\t/*\n\t\t * Match all request paths except for the ones starting with:\n\t\t * - api (API routes)\n\t\t * - _next/static (static files)\n\t\t * - _next/image (image optimization files)\n\t\t * - favicon.ico (favicon file)\n\t\t */\n\t\t{\n\t\t\tsource: '/((?!api|_next/static|_next/image|favicon.ico).*)',\n\t\t\tmissing: [\n\t\t\t\t{ type: 'header', key: 'next-router-prefetch' },\n\t\t\t\t{ type: 'header', key: 'purpose', value: 'prefetch' },\n\t\t\t],\n\t\t},\n\t],\n}"
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"proxy.js\" switcher",
			"value": "export const config = {\n\tmatcher: [\n\t\t/*\n\t\t * Match all request paths except for the ones starting with:\n\t\t * - api (API routes)\n\t\t * - _next/static (static files)\n\t\t * - _next/image (image optimization files)\n\t\t * - favicon.ico (favicon file)\n\t\t */\n\t\t{\n\t\t\tsource: '/((?!api|_next/static|_next/image|favicon.ico).*)',\n\t\t\tmissing: [\n\t\t\t\t{ type: 'header', key: 'next-router-prefetch' },\n\t\t\t\t{ type: 'header', key: 'purpose', value: 'prefetch' },\n\t\t\t],\n\t\t},\n\t],\n}"
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "How nonces work in Next.js"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To use a nonce, your page must be "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "dynamically rendered"
						}
					]
				},
				{
					"type": "text",
					"value": ". This is because Next.js applies nonces during "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "server-side rendering"
						}
					]
				},
				{
					"type": "text",
					"value": ", based on the CSP header present in the request. Static pages are generated at build time, when no request or response headers exist—so no nonce can be injected."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Here’s how nonce support works in a dynamically rendered page:"
				}
			]
		},
		{
			"type": "list",
			"ordered": true,
			"start": 1,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "Proxy generates a nonce"
										}
									]
								},
								{
									"type": "text",
									"value": ": Your proxy creates a unique nonce for the request, adds it to your "
								},
								{
									"type": "inlineCode",
									"value": "Content-Security-Policy"
								},
								{
									"type": "text",
									"value": " header, and also sets it in a custom "
								},
								{
									"type": "inlineCode",
									"value": "x-nonce"
								},
								{
									"type": "text",
									"value": " header."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "Next.js extracts the nonce"
										}
									]
								},
								{
									"type": "text",
									"value": ": During rendering, Next.js parses the "
								},
								{
									"type": "inlineCode",
									"value": "Content-Security-Policy"
								},
								{
									"type": "text",
									"value": " header and extracts the nonce using the "
								},
								{
									"type": "inlineCode",
									"value": "'nonce-{value}'"
								},
								{
									"type": "text",
									"value": " pattern."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "Nonce is applied automatically"
										}
									]
								},
								{
									"type": "text",
									"value": ": Next.js attaches the nonce to:"
								}
							]
						},
						{
							"type": "list",
							"ordered": false,
							"start": null,
							"spread": false,
							"children": [
								{
									"type": "listItem",
									"spread": false,
									"checked": null,
									"children": [
										{
											"type": "paragraph",
											"children": [
												{
													"type": "text",
													"value": "Framework scripts (React, Next.js runtime)"
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"spread": false,
									"checked": null,
									"children": [
										{
											"type": "paragraph",
											"children": [
												{
													"type": "text",
													"value": "Page-specific JavaScript bundles"
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"spread": false,
									"checked": null,
									"children": [
										{
											"type": "paragraph",
											"children": [
												{
													"type": "text",
													"value": "Inline styles and scripts generated by Next.js"
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"spread": false,
									"checked": null,
									"children": [
										{
											"type": "paragraph",
											"children": [
												{
													"type": "text",
													"value": "Any "
												},
												{
													"type": "inlineCode",
													"value": "<Script>"
												},
												{
													"type": "text",
													"value": " components using the "
												},
												{
													"type": "inlineCode",
													"value": "nonce"
												},
												{
													"type": "text",
													"value": " prop"
												}
											]
										}
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Because of this automatic behavior, you don’t need to manually add a nonce to each tag."
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Forcing dynamic rendering"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "If you're using nonces, you may need to explicitly opt pages into dynamic rendering:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/page.tsx\" switcher",
			"value": "import { connection } from 'next/server'\n\nexport default async function Page() {\n\t// wait for an incoming request to render this page\n\tawait connection()\n\t// Your page content\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/page.jsx\" switcher",
			"value": "import { connection } from 'next/server'\n\nexport default async function Page() {\n\t// wait for an incoming request to render this page\n\tawait connection()\n\t// Your page content\n}"
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Reading the nonce"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "You can read the nonce from a "
				},
				{
					"type": "link",
					"title": null,
					"url": "../01-getting-started/05-server-and-client-components.md",
					"children": [
						{
							"type": "text",
							"value": "Server Component"
						}
					]
				},
				{
					"type": "text",
					"value": " using "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/04-functions/headers.md",
					"children": [
						{
							"type": "inlineCode",
							"value": "headers"
						}
					]
				},
				{
					"type": "text",
					"value": ":"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/page.tsx\" switcher",
			"value": "import { headers } from 'next/headers'\nimport Script from 'next/script'\n\nexport default async function Page() {\n\tconst nonce = (await headers()).get('x-nonce')\n\n\treturn (\n\t\t<Script\n\t\t\tsrc=\"https://www.googletagmanager.com/gtag/js\"\n\t\t\tstrategy=\"afterInteractive\"\n\t\t\tnonce={nonce}\n\t\t/>\n\t)\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/page.jsx\" switcher",
			"value": "import { headers } from 'next/headers'\nimport Script from 'next/script'\n\nexport default async function Page() {\n\tconst nonce = (await headers()).get('x-nonce')\n\n\treturn (\n\t\t<Script\n\t\t\tsrc=\"https://www.googletagmanager.com/gtag/js\"\n\t\t\tstrategy=\"afterInteractive\"\n\t\t\tnonce={nonce}\n\t\t/>\n\t)\n}"
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Static vs Dynamic Rendering with CSP"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Using nonces has important implications for how your Next.js application renders:"
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Dynamic Rendering Requirement"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "When you use nonces in your CSP, "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "all pages must be dynamically rendered"
						}
					]
				},
				{
					"type": "text",
					"value": ". This means:"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Pages will build successfully but may encounter runtime errors if not properly configured for dynamic rendering"
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
