			"meta": "filename=\"next.config.js\"",
			"value": "/** @type {import('next').NextConfig} */\nconst nextConfig = {\n\texperimental: {\n\t\tsri: {\n\t\t\talgorithm: 'sha256', // or 'sha384' or 'sha512'\n\t\t},\n\t},\n}\n\nmodule.exports = nextConfig"
		},
