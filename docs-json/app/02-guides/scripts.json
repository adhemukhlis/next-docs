{
	"type": "root",
	"children": [
		{
			"type": "yaml",
			"value": "title: How to load and optimize scripts\nnav_title: Scripts\ndescription: Optimize 3rd party scripts with the built-in Script component."
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Layout Scripts"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To load a third-party script for multiple routes, import "
				},
				{
					"type": "inlineCode",
					"value": "next/script"
				},
				{
					"type": "text",
					"value": " and include the script directly in your layout component:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/dashboard/layout.tsx\" switcher",
			"value": "import Script from 'next/script'\n\nexport default function DashboardLayout({ children }: { children: React.ReactNode }) {\n\treturn (\n\t\t<>\n\t\t\t<section>{children}</section>\n\t\t\t<Script src=\"https://example.com/script.js\" />\n\t\t</>\n\t)\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/dashboard/layout.js\" switcher",
			"value": "import Script from 'next/script'\n\nexport default function DashboardLayout({ children }) {\n\treturn (\n\t\t<>\n\t\t\t<section>{children}</section>\n\t\t\t<Script src=\"https://example.com/script.js\" />\n\t\t</>\n\t)\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The third-party script is fetched when the folder route (e.g. "
				},
				{
					"type": "inlineCode",
					"value": "dashboard/page.js"
				},
				{
					"type": "text",
					"value": ") or any nested route (e.g. "
				},
				{
					"type": "inlineCode",
					"value": "dashboard/settings/page.js"
				},
				{
					"type": "text",
					"value": ") is accessed by the user. Next.js will ensure the script will "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "only load once"
						}
					]
				},
				{
					"type": "text",
					"value": ", even if a user navigates between multiple routes in the same layout."
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Application Scripts"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To load a third-party script for all routes, import "
				},
				{
					"type": "inlineCode",
					"value": "next/script"
				},
				{
					"type": "text",
					"value": " and include the script directly in your root layout:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/layout.tsx\" switcher",
			"value": "import Script from 'next/script'\n\nexport default function RootLayout({ children }: { children: React.ReactNode }) {\n\treturn (\n\t\t<html lang=\"en\">\n\t\t\t<body>{children}</body>\n\t\t\t<Script src=\"https://example.com/script.js\" />\n\t\t</html>\n\t)\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/layout.js\" switcher",
			"value": "import Script from 'next/script'\n\nexport default function RootLayout({ children }) {\n\treturn (\n\t\t<html lang=\"en\">\n\t\t\t<body>{children}</body>\n\t\t\t<Script src=\"https://example.com/script.js\" />\n\t\t</html>\n\t)\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "This script will load and execute when "
				},
				{
					"type": "emphasis",
					"children": [
						{
							"type": "text",
							"value": "any"
						}
					]
				},
				{
					"type": "text",
					"value": " route in your application is accessed. Next.js will ensure the script will "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "only load once"
						}
					]
				},
				{
					"type": "text",
					"value": ", even if a user navigates between multiple pages."
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Recommendation"
								}
							]
						},
						{
							"type": "text",
							"value": ": We recommend only including third-party scripts in specific pages or layouts in order to minimize any unnecessary impact to performance."
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Strategy"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Although the default behavior of "
				},
				{
					"type": "inlineCode",
					"value": "next/script"
				},
				{
					"type": "text",
					"value": " allows you to load third-party scripts in any page or layout, you can fine-tune its loading behavior by using the "
				},
				{
					"type": "inlineCode",
					"value": "strategy"
				},
				{
					"type": "text",
					"value": " property:"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "inlineCode",
									"value": "beforeInteractive"
								},
								{
									"type": "text",
									"value": ": Load the script before any Next.js code and before any page hydration occurs."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "inlineCode",
									"value": "afterInteractive"
								},
								{
									"type": "text",
									"value": ": ("
								},
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "default"
										}
									]
								},
								{
									"type": "text",
									"value": ") Load the script early but after some hydration on the page occurs."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "inlineCode",
									"value": "lazyOnload"
								},
								{
									"type": "text",
									"value": ": Load the script later during browser idle time."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "inlineCode",
									"value": "worker"
								},
								{
									"type": "text",
									"value": ": (experimental) Load the script in a web worker."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Refer to the "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/02-components/script.md#strategy",
					"children": [
						{
							"type": "inlineCode",
							"value": "next/script"
						}
					]
				},
				{
					"type": "text",
					"value": " API reference documentation to learn more about each strategy and their use cases."
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Offloading Scripts To A Web Worker (experimental)"
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Warning:"
								}
							]
						},
						{
							"type": "text",
							"value": " The "
						},
						{
							"type": "inlineCode",
							"value": "worker"
						},
						{
							"type": "text",
							"value": " strategy is not yet stable and does not yet work with the App Router. Use with caution."
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Scripts that use the "
				},
				{
					"type": "inlineCode",
					"value": "worker"
				},
				{
					"type": "text",
					"value": " strategy are offloaded and executed in a web worker with "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://partytown.qwik.dev/",
					"children": [
						{
							"type": "text",
							"value": "Partytown"
						}
					]
				},
				{
					"type": "text",
					"value": ". This can improve the performance of your site by dedicating the main thread to the rest of your application code."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "This strategy is still experimental and can only be used if the "
				},
				{
					"type": "inlineCode",
					"value": "nextScriptWorkers"
				},
				{
					"type": "text",
					"value": " flag is enabled in "
				},
				{
					"type": "inlineCode",
					"value": "next.config.js"
				},
				{
					"type": "text",
					"value": ":"
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\"",
			"value": "module.exports = {\n\texperimental: {\n\t\tnextScriptWorkers: true,\n\t},\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Then, run the development server and Next.js will guide you through the installation of the required packages to finish the setup:"
				}
			]
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"pnpm\"",
			"value": "pnpm dev"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"npm\"",
			"value": "npm run dev"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"yarn\"",
			"value": "yarn dev"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"bun\"",
			"value": "bun dev"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "You'll see instructions like these: Please install Partytown by running "
				},
				{
					"type": "inlineCode",
					"value": "npm install @qwik.dev/partytown"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Once setup is complete, defining "
				},
				{
					"type": "inlineCode",
					"value": "strategy=\"worker\""
				},
				{
					"type": "text",
					"value": " will automatically instantiate Partytown in your application and offload the script to a web worker."
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"pages/home.tsx\" switcher",
			"value": "import Script from 'next/script'\n\nexport default function Home() {\n\treturn (\n\t\t<>\n\t\t\t<Script\n\t\t\t\tsrc=\"https://example.com/script.js\"\n\t\t\t\tstrategy=\"worker\"\n\t\t\t/>\n\t\t</>\n\t)\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"pages/home.js\" switcher",
			"value": "import Script from 'next/script'\n\nexport default function Home() {\n\treturn (\n\t\t<>\n\t\t\t<Script\n\t\t\t\tsrc=\"https://example.com/script.js\"\n\t\t\t\tstrategy=\"worker\"\n\t\t\t/>\n\t\t</>\n\t)\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "There are a number of trade-offs that need to be considered when loading a third-party script in a web worker. Please see Partytown's "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://partytown.qwik.dev/trade-offs",
					"children": [
						{
							"type": "text",
							"value": "tradeoffs"
						}
					]
				},
				{
					"type": "text",
					"value": " documentation for more information."
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Inline Scripts"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Inline scripts, or scripts not loaded from an external file, are also supported by the Script component. They can be written by placing the JavaScript within curly braces:"
				}
			]
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": null,
			"value": "<Script id=\"show-banner\">{`document.getElementById('banner').classList.remove('hidden')`}</Script>"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Or by using the "
				},
				{
					"type": "inlineCode",
					"value": "dangerouslySetInnerHTML"
				},
				{
					"type": "text",
					"value": " property:"
				}
			]
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": null,
			"value": "<Script\n\tid=\"show-banner\"\n\tdangerouslySetInnerHTML={{\n\t\t__html: `document.getElementById('banner').classList.remove('hidden')`,\n\t}}\n/>"
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Warning"
								}
							]
						},
						{
							"type": "text",
							"value": ": An "
						},
						{
							"type": "inlineCode",
							"value": "id"
						},
						{
							"type": "text",
							"value": " property must be assigned for inline scripts in order for Next.js to track and optimize the script."
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Executing Additional Code"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Event handlers can be used with the Script component to execute additional code after a certain event occurs:"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "inlineCode",
									"value": "onLoad"
								},
								{
									"type": "text",
									"value": ": Execute code after the script has finished loading."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "inlineCode",
									"value": "onReady"
								},
								{
									"type": "text",
									"value": ": Execute code after the script has finished loading and every time the component is mounted."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "inlineCode",
									"value": "onError"
								},
								{
									"type": "text",
									"value": ": Execute code if the script fails to load."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "These handlers will only work when "
				},
				{
					"type": "inlineCode",
					"value": "next/script"
				},
				{
					"type": "text",
					"value": " is imported and used inside of a "
				},
				{
					"type": "link",
					"title": null,
					"url": "../01-getting-started/05-server-and-client-components.md",
					"children": [
						{
							"type": "text",
							"value": "Client Component"
						}
					]
				},
				{
					"type": "text",
					"value": ". To create a client entry point, add "
				},
				{
					"type": "inlineCode",
					"value": "\"use client\""
				},
				{
					"type": "text",
					"value": " at the top of the file, before any imports:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/page.tsx\" switcher",
			"value": "'use client'\n\nimport Script from 'next/script'\n\nexport default function Page() {\n\treturn (\n\t\t<>\n\t\t\t<Script\n\t\t\t\tsrc=\"https://example.com/script.js\"\n\t\t\t\tonLoad={() => {\n\t\t\t\t\tconsole.log('Script has loaded')\n\t\t\t\t}}\n\t\t\t/>\n\t\t</>\n\t)\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/page.js\" switcher",
			"value": "'use client'\n\nimport Script from 'next/script'\n\nexport default function Page() {\n\treturn (\n\t\t<>\n\t\t\t<Script\n\t\t\t\tsrc=\"https://example.com/script.js\"\n\t\t\t\tonLoad={() => {\n\t\t\t\t\tconsole.log('Script has loaded')\n\t\t\t\t}}\n\t\t\t/>\n\t\t</>\n\t)\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Refer to the "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/02-components/script.md#onload",
					"children": [
						{
							"type": "inlineCode",
							"value": "next/script"
						}
					]
				},
				{
					"type": "text",
					"value": " API reference to learn more about each event handler and view examples."
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Additional Attributes"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "There are many DOM attributes that can be assigned to a "
				},
				{
					"type": "inlineCode",
					"value": "<script>"
				},
				{
					"type": "text",
					"value": " element that are not used by the Script component, like "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://developer.mozilla.org/docs/Web/HTML/Global_attributes/nonce",
					"children": [
						{
							"type": "inlineCode",
							"value": "nonce"
						}
					]
				},
				{
					"type": "text",
					"value": " or "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://developer.mozilla.org/docs/Web/HTML/Global_attributes/data-*",
					"children": [
						{
							"type": "text",
							"value": "custom data attributes"
						}
					]
				},
				{
					"type": "text",
					"value": ". Including any additional attributes will automatically forward it to the final, optimized "
				},
				{
					"type": "inlineCode",
					"value": "<script>"
				},
				{
					"type": "text",
					"value": " element that is included in the HTML."
				}
			]
		},
		{
