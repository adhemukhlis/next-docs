		{
			"type": "code",
			"lang": "tsx",
			"meta": null,
			"value": "'use client'\n\nimport Link, { LinkProps } from 'next/link'\n\nfunction NoPrefetchLink({ prefetch, ...rest }: LinkProps & { children: React.ReactNode }) {\n\treturn (\n\t\t<Link\n\t\t\t{...rest}\n\t\t\tprefetch={false}\n\t\t/>\n\t)\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "For example, you may still want to have consistent usage of "
				},
