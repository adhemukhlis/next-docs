						},
						{
							"type": "inlineCode",
							"value": "<Link>"
						},
						{
							"type": "text",
							"value": " defaults to prefetching a per-route "
						},
						{
							"type": "link",
							"title": null,
							"url": "../04-glossary.md#app-shell",
							"children": [
								{
									"type": "text",
									"value": "App Shell"
								}
							]
						},
						{
							"type": "text",
							"value": " rather than the full page. See "
						},
						{
							"type": "link",
							"title": null,
							"url": "#partial-prefetching",
							"children": [
								{
