		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Client cache"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Next.js stores prefetched React Server Component payloads in memory, keyed by route segments. When navigating between sibling routes (e.g. "
				},
				{
					"type": "inlineCode",
					"value": "/dashboard/settings"
				},
				{
					"type": "text",
					"value": " → "
				},
				{
					"type": "inlineCode",
					"value": "/dashboard/analytics"
				},
				{
					"type": "text",
					"value": "), Next.js reuses the parent layout and only fetches the updated leaf page."
				}
			]
		},
		{
			"type": "heading",
