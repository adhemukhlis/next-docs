{
	"type": "root",
	"children": [
		{
			"type": "yaml",
			"value": "title: How to create a static export of your Next.js application\nnav_title: Static Exports\ndescription: Next.js enables starting as a static site or Single-Page Application (SPA), then later optionally upgrading to use features that require a server."
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Next.js enables starting as a static site or Single-Page Application (SPA), then later optionally upgrading to use features that require a server."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "When running "
				},
				{
					"type": "inlineCode",
					"value": "next build"
				},
				{
					"type": "text",
					"value": ", Next.js generates an HTML file per route. By breaking a strict SPA into individual HTML files, Next.js can avoid loading unnecessary JavaScript code on the client-side, reducing the bundle size and enabling faster page loads."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Since Next.js supports this static export, it can be deployed and hosted on any web server that can serve HTML/CSS/JS static assets."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Configuration"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To enable a static export, change the output mode inside "
				},
				{
					"type": "inlineCode",
					"value": "next.config.js"
				},
				{
					"type": "text",
					"value": ":"
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\" highlight={5}",
			"value": "/**\n * @type {import('next').NextConfig}\n */\nconst nextConfig = {\n\toutput: 'export',\n\n\t// Optional: Change links `/me` -> `/me/` and emit `/me.html` -> `/me/index.html`\n\t// trailingSlash: true,\n\n\t// Optional: Prevent automatic `/me` -> `/me/`, instead preserve `href`\n\t// skipTrailingSlashRedirect: true,\n\n\t// Optional: Change the output directory `out` -> `dist`\n\t// distDir: 'dist',\n}\n\nmodule.exports = nextConfig"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "After running "
				},
				{
					"type": "inlineCode",
					"value": "next build"
				},
				{
					"type": "text",
					"value": ", Next.js will create an "
				},
				{
					"type": "inlineCode",
					"value": "out"
				},
				{
					"type": "text",
					"value": " folder with the HTML/CSS/JS assets for your application."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Supported Features"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The core of Next.js has been designed to support static exports."
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Server Components"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "When you run "
				},
				{
					"type": "inlineCode",
					"value": "next build"
				},
				{
					"type": "text",
					"value": " to generate a static export, Server Components consumed inside the "
				},
				{
					"type": "inlineCode",
					"value": "app"
				},
				{
					"type": "text",
					"value": " directory will run during the build, similar to traditional static-site generation."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The resulting component will be rendered into static HTML for the initial page load and a static payload for client navigation between routes. No changes are required for your Server Components when using the static export, unless they consume "
				},
				{
					"type": "link",
					"title": null,
					"url": "#unsupported-features",
					"children": [
						{
							"type": "text",
							"value": "dynamic server functions"
						}
					]
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/page.tsx\" switcher",
			"value": "export default async function Page() {\n\t// This fetch will run on the server during `next build`\n\tconst res = await fetch('https://api.example.com/...')\n\tconst data = await res.json()\n\n\treturn <main>...</main>\n}"
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Client Components"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "If you want to perform data fetching on the client, you can use a Client Component with "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://github.com/vercel/swr",
					"children": [
						{
							"type": "text",
							"value": "SWR"
						}
					]
				},
				{
					"type": "text",
					"value": " to memoize requests."
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/other/page.tsx\" switcher",
			"value": "'use client'\n\nimport useSWR from 'swr'\n\nconst fetcher = (url: string) => fetch(url).then((r) => r.json())\n\nexport default function Page() {\n\tconst { data, error } = useSWR(`https://jsonplaceholder.typicode.com/posts/1`, fetcher)\n\tif (error) return 'Failed to load'\n\tif (!data) return 'Loading...'\n\n\treturn data.title\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/other/page.js\" switcher",
			"value": "'use client'\n\nimport useSWR from 'swr'\n\nconst fetcher = (url) => fetch(url).then((r) => r.json())\n\nexport default function Page() {\n\tconst { data, error } = useSWR(`https://jsonplaceholder.typicode.com/posts/1`, fetcher)\n\tif (error) return 'Failed to load'\n\tif (!data) return 'Loading...'\n\n\treturn data.title\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Since route transitions happen client-side, this behaves like a traditional SPA. For example, the following index route allows you to navigate to different posts on the client:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/page.tsx\" switcher",
			"value": "import Link from 'next/link'\n\nexport default function Page() {\n\treturn (\n\t\t<>\n\t\t\t<h1>Index Page</h1>\n\t\t\t<hr />\n\t\t\t<ul>\n\t\t\t\t<li>\n\t\t\t\t\t<Link href=\"/post/1\">Post 1</Link>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t\t<Link href=\"/post/2\">Post 2</Link>\n\t\t\t\t</li>\n\t\t\t</ul>\n\t\t</>\n\t)\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/page.js\" switcher",
			"value": "import Link from 'next/link'\n\nexport default function Page() {\n\treturn (\n\t\t<>\n\t\t\t<h1>Index Page</h1>\n\t\t\t<p>\n\t\t\t\t<Link href=\"/other\">Other Page</Link>\n\t\t\t</p>\n\t\t</>\n\t)\n}"
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Image Optimization"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/02-components/image.md",
					"children": [
						{
							"type": "text",
							"value": "Image Optimization"
						}
					]
				},
				{
					"type": "text",
					"value": " through "
				},
				{
					"type": "inlineCode",
					"value": "next/image"
				},
				{
					"type": "text",
					"value": " can be used with a static export by defining a custom image loader in "
				},
				{
					"type": "inlineCode",
					"value": "next.config.js"
				},
				{
					"type": "text",
					"value": ". For example, you can optimize images with a service like Cloudinary:"
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\"",
			"value": "/** @type {import('next').NextConfig} */\nconst nextConfig = {\n\toutput: 'export',\n\timages: {\n\t\tloader: 'custom',\n\t\tloaderFile: './my-loader.ts',\n\t},\n}\n\nmodule.exports = nextConfig"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "This custom loader will define how to fetch images from a remote source. For example, the following loader will construct the URL for Cloudinary:"
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": "filename=\"my-loader.ts\" switcher",
			"value": "export default function cloudinaryLoader({ src, width, quality }: { src: string; width: number; quality?: number }) {\n\tconst params = ['f_auto', 'c_limit', `w_${width}`, `q_${quality || 'auto'}`]\n\treturn `https://res.cloudinary.com/demo/image/upload/${params.join(',')}${src}`\n}"
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"my-loader.js\" switcher",
			"value": "export default function cloudinaryLoader({ src, width, quality }) {\n\tconst params = ['f_auto', 'c_limit', `w_${width}`, `q_${quality || 'auto'}`]\n\treturn `https://res.cloudinary.com/demo/image/upload/${params.join(',')}${src}`\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "You can then use "
				},
				{
					"type": "inlineCode",
					"value": "next/image"
				},
				{
					"type": "text",
					"value": " in your application, defining relative paths to the image in Cloudinary:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/page.tsx\" switcher",
			"value": "import Image from 'next/image'\n\nexport default function Page() {\n\treturn (\n\t\t<Image\n\t\t\talt=\"turtles\"\n\t\t\tsrc=\"/turtles.jpg\"\n\t\t\twidth={300}\n\t\t\theight={300}\n\t\t/>\n\t)\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/page.js\" switcher",
			"value": "import Image from 'next/image'\n\nexport default function Page() {\n\treturn (\n\t\t<Image\n\t\t\talt=\"turtles\"\n\t\t\tsrc=\"/turtles.jpg\"\n\t\t\twidth={300}\n\t\t\theight={300}\n\t\t/>\n\t)\n}"
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Route Handlers"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Route Handlers will render a static response when running "
				},
				{
					"type": "inlineCode",
					"value": "next build"
				},
				{
					"type": "text",
					"value": ". Only the "
				},
				{
					"type": "inlineCode",
					"value": "GET"
				},
				{
					"type": "text",
					"value": " HTTP verb is supported. This can be used to generate static HTML, JSON, TXT, or other files from cached or uncached data. To ensure Route Handlers are prerendered, you must explicitly mark the handler as static by adding "
				},
				{
					"type": "inlineCode",
					"value": "export const dynamic = 'force-static'"
				},
				{
					"type": "text",
					"value": " when a static export is enabled. For example:"
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": "filename=\"app/data.json/route.ts\" switcher",
			"value": "export const dynamic = 'force-static'\n\nexport async function GET() {\n\treturn Response.json({ name: 'Lee' })\n}"
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"app/data.json/route.js\" switcher",
			"value": "export const dynamic = 'force-static'\n\nexport async function GET() {\n\treturn Response.json({ name: 'Lee' })\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The above file "
				},
				{
					"type": "inlineCode",
					"value": "app/data.json/route.ts"
				},
				{
					"type": "text",
					"value": " will render to a static file during "
				},
				{
					"type": "inlineCode",
					"value": "next build"
				},
				{
					"type": "text",
					"value": ", producing "
				},
				{
					"type": "inlineCode",
					"value": "data.json"
				},
				{
					"type": "text",
					"value": " containing "
				},
				{
					"type": "inlineCode",
					"value": "{ name: 'Lee' }"
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "If you need to read dynamic values from the incoming request, you cannot use a static export."
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Browser APIs"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Client Components are prerendered to HTML during "
				},
				{
					"type": "inlineCode",
					"value": "next build"
				},
				{
					"type": "text",
					"value": ". Because "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://developer.mozilla.org/docs/Web/API",
					"children": [
						{
							"type": "text",
							"value": "Web APIs"
						}
					]
				},
				{
					"type": "text",
					"value": " like "
				},
				{
					"type": "inlineCode",
					"value": "window"
				},
				{
					"type": "text",
					"value": ", "
				},
				{
					"type": "inlineCode",
					"value": "localStorage"
				},
				{
					"type": "text",
					"value": ", and "
				},
				{
					"type": "inlineCode",
					"value": "navigator"
				},
				{
					"type": "text",
					"value": " are not available on the server, you need to safely access these APIs only when running in the browser. For example:"
				}
			]
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": null,
			"value": "'use client';\n\nimport { useEffect } from 'react';\n\nexport default function ClientComponent() {\n  useEffect(() => {\n    // You now have access to `window`\n    console.log(window.innerHeight);\n  }, [])\n\n  return ...;\n}"
		},
