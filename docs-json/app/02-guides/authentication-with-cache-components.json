			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Migrating an existing app"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "With Cache Components enabled, instant navigation validation flags every route that reads the session, because a request read can't be prerendered into the static shell. You don't have to resolve them all before shipping. Set "
				},
				{
					"type": "link",
					"title": null,
					"url": "./instant-navigation.md#opting-out",
					"children": [
						{
							"type": "inlineCode",
							"value": "export const instant = false"
						}
					]
				},
				{
					"type": "text",
					"value": " on the page or layout to let it keep blocking on the server, then adopt the patterns below one route at a time. For the full migration workflow, see "
				},
				{
					"type": "link",
					"title": null,
					"url": "./migrating-to-cache-components.md#following-validation",
					"children": [
						{
							"type": "text",
							"value": "Migrating to Cache Components"
						}
					]
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Step 1: Read the current user"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Reading the current user reads the session cookie, then looks the user up. A request read can't be part of the static shell, so it always sits behind a "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/03-file-conventions/loading.md",
					"children": [
						{
							"type": "inlineCode",
							"value": "<Suspense>"
						}
					]
				},
				{
					"type": "text",
					"value": " boundary and streams in on every navigation."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Because a user session is valid for a period of time, adding a cache lifetime lets the framework prefetch that content ahead of time."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The server-side directives can't give it that lifetime, though: neither a plain "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/01-directives/use-cache.md",
					"children": [
						{
							"type": "inlineCode",
							"value": "use cache"
						}
					]
				},
				{
					"type": "text",
					"value": " nor "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/01-directives/use-cache-remote.md",
					"children": [
						{
							"type": "inlineCode",
							"value": "use cache: remote"
						}
					]
				},
				{
					"type": "text",
					"value": " can call "
				},
				{
					"type": "inlineCode",
					"value": "cookies()"
				},
				{
					"type": "text",
					"value": ", and you can't "
				},
				{
					"type": "link",
					"title": null,
					"url": "../01-getting-started/08-caching.md#passing-runtime-values-to-cached-functions",
					"children": [
						{
							"type": "text",
							"value": "extract the value and pass it in"
						}
					]
				},
				{
					"type": "text",
					"value": " either, because:"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "A session helper reads the cookie deep inside its own code, so there's nothing to lift out."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Validating it compares a token's expiry against the current time (iron-session's "
								},
								{
									"type": "inlineCode",
									"value": "unsealData"
								},
								{
									"type": "text",
									"value": " rejects an expired seal), so the read is request- and time-dependent."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "That's what "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/01-directives/use-cache-private.md",
					"children": [
						{
							"type": "inlineCode",
							"value": "use cache: private"
						}
					]
				},
				{
					"type": "text",
					"value": " is for: it reads "
				},
				{
					"type": "inlineCode",
					"value": "cookies()"
				},
				{
					"type": "text",
					"value": " and "
				},
				{
					"type": "inlineCode",
					"value": "headers()"
				},
				{
					"type": "text",
					"value": " directly, keeping the result in the browser only, never on the server."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "A private scope stays in the browser, so it never caches on the server. To cache on the server instead, extract a value (the "
				},
				{
					"type": "inlineCode",
					"value": "userId"
				},
				{
					"type": "text",
					"value": ", for example) and pass it into a plain "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/01-directives/use-cache.md",
					"children": [
						{
							"type": "inlineCode",
							"value": "use cache"
						}
					]
				},
				{
					"type": "text",
					"value": " or "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/01-directives/use-cache-remote.md",
					"children": [
						{
							"type": "inlineCode",
							"value": "use cache: remote"
						}
					]
				},
				{
					"type": "text",
					"value": ". The same pattern caches data derived from the session, covered in "
				},
				{
					"type": "link",
					"title": null,
					"url": "#step-4-cache-session-derived-data",
					"children": [
						{
							"type": "text",
							"value": "Step 4"
						}
					]
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"lib/session.ts\"",
			"value": "import 'server-only'\nimport { cookies } from 'next/headers'\nimport { sealData, unsealData } from 'iron-session'\n\nexport type SessionData = {\n\tuserId?: string\n}\n\nconst COOKIE_NAME = 'app_session'\nconst password = process.env.SESSION_PASSWORD!\n\nexport async function getSession(): Promise<SessionData> {\n\tconst cookie = (await cookies()).get(COOKIE_NAME)?.value\n\tif (!cookie) {\n\t\treturn {}\n\t}\n\treturn unsealData<SessionData>(cookie, { password })\n}"
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"lib/auth.ts\"",
			"value": "import 'server-only'\nimport { redirect } from 'next/navigation'\nimport { getSession } from './session'\nimport { findUserById } from './data'\n\nexport type User = {\n\tid: string\n\tname: string\n}\n\nexport async function getCurrentUser(): Promise<User> {\n\t'use cache: private'\n\n\tconst { userId } = await getSession()\n\tif (!userId) {\n\t\tredirect('/login')\n\t}\n\n\tconst user = await findUserById(userId)\n\tif (!user) {\n\t\tredirect('/login')\n\t}\n\n\treturn { id: user.id, name: user.name }\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The "
				},
				{
					"type": "inlineCode",
					"value": "redirect()"
				},
				{
					"type": "text",
					"value": " calls throw to interrupt rendering rather than return a value, so they aren't cached. Only a resolved user is."
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know:"
								}
							]
						},
						{
							"type": "text",
							"value": " "
						},
						{
							"type": "inlineCode",
							"value": "use cache: private"
						},
						{
							"type": "text",
							"value": " accepts "
						},
						{
							"type": "inlineCode",
							"value": "cookies()"
						},
						{
							"type": "text",
							"value": ", "
						},
						{
							"type": "inlineCode",
							"value": "headers()"
						},
						{
							"type": "text",
							"value": ", and "
						},
						{
							"type": "inlineCode",
							"value": "searchParams"
						},
						{
							"type": "text",
							"value": ", but not "
						},
						{
							"type": "link",
							"title": null,
							"url": "../03-api-reference/04-functions/connection.md",
							"children": [
								{
									"type": "inlineCode",
									"value": "connection()"
								}
							]
						},
						{
							"type": "text",
							"value": ". See "
						},
						{
							"type": "link",
							"title": null,
							"url": "../03-api-reference/01-directives/use-cache-private.md",
							"children": [
								{
									"type": "inlineCode",
									"value": "use cache: private"
								}
							]
						},
						{
							"type": "text",
							"value": " for the full list."
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Step 2: Show the user without blocking the page"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "A component that reads the session must sit behind a "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/03-file-conventions/loading.md",
					"children": [
						{
							"type": "inlineCode",
							"value": "<Suspense>"
						}
					]
				},
				{
					"type": "text",
					"value": " boundary. With Cache Components, reading "
				},
				{
					"type": "inlineCode",
					"value": "cookies()"
				},
				{
					"type": "text",
					"value": " outside a boundary is a build error. The boundary is also what keeps the rest of the page fast. Anything outside it prerenders into the "
				},
				{
					"type": "link",
					"title": null,
					"url": "../01-getting-started/08-caching.md#prerendering",
					"children": [
						{
							"type": "text",
							"value": "static shell"
						}
					]
				},
				{
					"type": "text",
					"value": " and loads instantly, as long as it's static or wrapped in "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/01-directives/use-cache.md",
					"children": [
						{
							"type": "inlineCode",
							"value": "use cache"
						}
					]
				},
				{
					"type": "text",
					"value": " and doesn't read runtime data of its own. Only the section behind the boundary waits for the request."
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/page.tsx\"",
			"value": "import { Suspense } from 'react'\nimport { getCurrentUser } from '@/lib/auth'\nimport { getAnnouncements } from '@/lib/data'\n\nexport default function Page() {\n\treturn (\n\t\t<main>\n\t\t\t{/* Cached, so it prerenders into the static shell */}\n\t\t\t<Announcements />\n\n\t\t\t{/* Reads the session, so it streams in behind the boundary */}\n\t\t\t<Suspense fallback={<p>Loading your dashboard…</p>}>\n\t\t\t\t<Dashboard />\n\t\t\t</Suspense>\n\t\t</main>\n\t)\n}\n\nasync function Announcements() {\n\t'use cache'\n\tconst announcements = await getAnnouncements()\n\treturn (\n\t\t<ul>\n\t\t\t{announcements.map((announcement) => (\n\t\t\t\t<li key={announcement}>{announcement}</li>\n\t\t\t))}\n\t\t</ul>\n\t)\n}\n\nasync function Dashboard() {\n\tconst user = await getCurrentUser()\n\treturn <h1>Welcome, {user.name}</h1>\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Keep the session read out of a layout's top level, too. A top-level "
				},
				{
					"type": "inlineCode",
					"value": "await"
				},
				{
					"type": "text",
					"value": " on the session in a layout holds the whole segment, including "
				},
				{
					"type": "inlineCode",
					"value": "{children}"
				},
				{
					"type": "text",
					"value": ", behind that request, so push it into a component inside a boundary. See "
				},
				{
					"type": "link",
					"title": null,
					"url": "./streaming.md#push-dynamic-access-down",
					"children": [
						{
							"type": "text",
							"value": "Push dynamic access down"
						}
					]
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know:"
								}
							]
						},
						{
							"type": "text",
							"value": " "
						},
						{
							"type": "inlineCode",
							"value": "getCurrentUser"
						},
						{
							"type": "text",
							"value": " reads the session, checks it, and returns a narrow user. Centralizing those reads in one function is the "
						},
						{
							"type": "link",
							"title": null,
							"url": "./authentication.md#creating-a-data-access-layer-dal",
							"children": [
								{
									"type": "text",
									"value": "Data Access Layer"
								}
							]
						},
						{
							"type": "text",
							"value": " pattern."
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Step 3: Share the user across components"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "You don't have to read the session again in every component that needs the user. Read it once, then hand it to as many Server and Client Components as you like from inside the same boundary."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Server Components can call "
				},
				{
					"type": "inlineCode",
					"value": "getCurrentUser()"
				},
				{
					"type": "text",
					"value": " directly. To reach Client Components without prop drilling, create the promise once, pass it through context, and unwrap it with "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://react.dev/reference/react/use",
					"children": [
						{
							"type": "inlineCode",
							"value": "use()"
						}
					]
				},
				{
					"type": "text",
					"value": ". For the general pattern, see "
				},
				{
					"type": "link",
					"title": null,
					"url": "./single-page-applications.md#using-reacts-use-within-a-context-provider",
					"children": [
						{
							"type": "text",
							"value": "Using React's "
						},
						{
							"type": "inlineCode",
							"value": "use"
						},
						{
							"type": "text",
							"value": " within a Context Provider"
						}
					]
				},
				{
					"type": "text",
					"value": ". Because "
				},
				{
					"type": "inlineCode",
					"value": "getCurrentUser"
				},
				{
					"type": "text",
					"value": " reads the request, create its promise inside the Suspense boundary, not at the top of a layout."
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/user-provider.tsx\"",
			"value": "'use client'\n\nimport { createContext, use } from 'react'\nimport type { ReactNode } from 'react'\nimport type { User } from '@/lib/auth'\n\nconst UserContext = createContext<Promise<User> | null>(null)\n\nexport function UserProvider({ userPromise, children }: { userPromise: Promise<User>; children: ReactNode }) {\n\treturn <UserContext value={userPromise}>{children}</UserContext>\n}\n\nexport function useUser() {\n\tconst userPromise = use(UserContext)\n\tif (!userPromise) {\n\t\tthrow new Error('useUser must be used within a UserProvider')\n\t}\n\treturn use(userPromise)\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The Server Component behind the boundary creates the promise and hands it to the provider without awaiting it. Each consumer then resolves it behind its own boundary, so the shared chrome renders without waiting on the session:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/page.tsx\"",
			"value": "function Dashboard() {\n\tconst userPromise = getCurrentUser()\n\n\treturn (\n\t\t<UserProvider userPromise={userPromise}>\n\t\t\t<Suspense fallback={<span>Loading…</span>}>\n\t\t\t\t<UserBadge />\n\t\t\t</Suspense>\n\t\t</UserProvider>\n\t)\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Client Components call "
				},
				{
					"type": "inlineCode",
					"value": "useUser()"
				},
				{
					"type": "text",
					"value": " to get the current user. Because "
				},
				{
					"type": "inlineCode",
					"value": "use()"
				},
				{
					"type": "text",
					"value": " suspends until the promise resolves, keep the component behind a "
				},
				{
					"type": "inlineCode",
					"value": "<Suspense>"
				},
				{
					"type": "text",
					"value": " boundary:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/user-badge.tsx\"",
			"value": "'use client'\n\nimport { useUser } from './user-provider'\n\nexport function UserBadge() {\n\tconst user = useUser()\n\treturn <span>Signed in as {user.name}</span>\n}"
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know:"
								}
