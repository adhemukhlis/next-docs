		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"lib/data.ts\"",
			"value": "import 'server-only'\nimport { cacheLife, cacheTag } from 'next/cache'\nimport { getCurrentUser } from './auth'\n\nexport async function getNotes() {\n\tconst user = await getCurrentUser()\n\treturn getNotesByUserId(user.id)\n}\n\nasync function getNotesByUserId(userId: string) {\n\t'use cache'\n\tcacheTag(`notes:${userId}`)\n\tcacheLife('minutes')\n\n\treturn db.query.notes.findMany({\n\t\twhere: (notes, { eq }) => eq(notes.userId, userId),\n\t})\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Keep "
				},
				{
					"type": "inlineCode",
					"value": "getNotesByUserId"
				},
				{
					"type": "text",
					"value": " unexported so a caller can't request another user's notes by passing a different id. Resolving the user inside the exported getter is what makes that safe. See "
