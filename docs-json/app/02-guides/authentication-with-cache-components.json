			"type": "yaml",
			"value": "title: How to implement authentication with Cache Components\nnav_title: Authentication with Cache Components\ndescription: 'Learn how to read the user session, show authenticated UI without slowing down the page, and cache data derived from the session when Cache Components is enabled.'"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "With "
				},
				{
					"type": "link",
					"title": null,
					"url": "../01-getting-started/08-caching.md",
					"children": [
						{
							"type": "text",
							"value": "Cache Components"
						}
					]
				},
				{
					"type": "text",
					"value": " enabled, a session read happens at request time, so it can't be prerendered into the static shell. Authenticated UI streams in behind a "
				},
				{
					"type": "inlineCode",
					"value": "<Suspense>"
				},
				{
					"type": "text",
					"value": " boundary instead, and data derived from the session can still be cached."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The examples use "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://github.com/vvo/iron-session",
					"children": [
						{
							"type": "text",
							"value": "iron-session"
						}
					]
				},
				{
					"type": "text",
					"value": " for encrypted cookie sessions, but the patterns apply to any session or authentication library. For a complete, runnable version, see the "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://github.com/vercel/next.js/tree/canary/examples/with-iron-session-cache-components",
					"children": [
						{
							"type": "text",
							"value": "with-iron-session-cache-components example"
						}
					]
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Prerequisites"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Enable "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/05-config/01-next-config-js/cacheComponents.md",
					"children": [
						{
