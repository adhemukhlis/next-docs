				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Step 4: Cache session-derived data"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Now that you have the user, you can cache the data you fetch for them in one of two ways. Passing the user id into a plain "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/01-directives/use-cache.md",
					"children": [
						{
							"type": "inlineCode",
							"value": "use cache"
						}
					]
				},
				{
					"type": "text",
					"value": " function keeps the result on the server, keyed by the id (it becomes part of the "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/01-directives/use-cache.md#cache-keys",
					"children": [
						{
							"type": "text",
							"value": "cache key"
						}
					]
				},
				{
					"type": "text",
					"value": "), where a "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/04-functions/cacheTag.md",
					"children": [
						{
							"type": "inlineCode",
							"value": "cacheTag"
						}
					]
				},
				{
					"type": "text",
					"value": " can invalidate it later. Reading it inside a "
				},
