							"type": "inlineCode",
							"value": "getCurrentUser"
						},
						{
							"type": "text",
							"value": " helper returns a narrow "
						},
						{
							"type": "inlineCode",
							"value": "{ id, name }"
						},
						{
							"type": "text",
							"value": " rather than the raw session. To keep sensitive fields from reaching the client, see "
						},
						{
							"type": "link",
							"title": null,
							"url": "https://react.dev/reference/react/experimental_taintUniqueValue",
							"children": [
								{
									"type": "inlineCode",
									"value": "taintUniqueValue"
								}
