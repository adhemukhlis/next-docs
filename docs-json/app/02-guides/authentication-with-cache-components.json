		{
			"type": "code",
			"lang": "ts",
			"meta": "filename=\"next.config.ts\"",
			"value": "import type { NextConfig } from 'next'\n\nconst nextConfig: NextConfig = {\n\tcacheComponents: true,\n}\n\nexport default nextConfig"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "This guide covers code patterns for authentication with Cache Components: reading the session at request time, streaming authenticated UI, and caching session-derived data. It assumes you're comfortable with Cache Components (if not, read "
				},
				{
					"type": "link",
					"title": null,
					"url": "../01-getting-started/08-caching.md",
					"children": [
						{
							"type": "text",
							"value": "Caching"
						}
					]
				},
				{
					"type": "text",
					"value": " first) and that you already have a session set on login."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "For the fundamentals this builds on, we recommend two guides:"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
