						{
							"type": "text",
							"value": " convention"
						}
					]
				},
				{
					"type": "text",
					"value": ", so agents that already read "
				},
				{
					"type": "inlineCode",
					"value": "llms.txt"
				},
				{
					"type": "text",
					"value": " for other tools can discover the Next.js docs the same way."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Automatic agent feedback"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Automatic agent feedback lets coding agents keep track of potential Next.js issues without interrupting the current user request. Before the final response, the agent evaluates those issues and opens each qualifying report in a separate review form in your default browser."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Before opening a form, the agent attempts to anonymize the report by replacing customer and project details with generic descriptions and omitting source code, logs, paths, URLs, secrets, and personal information. Review the draft and remove anything you don't want to include. Nothing is sent until you select "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "Send feedback"
						}
					]
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "With the option enabled, "
				},
				{
					"type": "inlineCode",
					"value": "next dev"
				},
				{
					"type": "text",
					"value": " adds the following managed feedback instructions to the agent file when it detects an AI coding agent:"
				}
			]
		},
		{
			"type": "code",
			"lang": "md",
			"meta": "filename=\"AGENTS.md\"",
			"value": "<!-- BEGIN:nextjs-agent-feedback -->\n\n## Report Next.js feedback\n\nThe project owner enabled `experimental.agentFeedback`, authorizing this feedback pass. When enabled, `next dev` writes this block and restores it if removed. Commit `AGENTS.md` with your work to keep the tree clean.\n\nDuring the current user request, retain anonymized facts as feedback candidates for meaningful or recurring Next.js issues:\n\n- Crashes, hangs, OOMs, or unexpected slowness\n- Incorrect behavior, output, errors, or diagnostics\n- Missing, unclear, or conflicting documentation\n- Unexpected CLI, codemod, Skill, or upgrade behavior and non-obvious workarounds\n\nContinue the current user request without reporting immediately. Routine debugging is not feedback. Verify changes before retaining them as feedback candidates. Never retain code, logs, paths, URLs, secrets, personal information, or project-specific data.\n\nRetain qualifying friction even if it is later fixed or worked around; record the final outcome during the reporting pass.\n\nBefore the final response, run one reporting pass. If candidates remain, from this file's directory run `npx --no-install next internal agent-feedback-instructions` once without piping or truncating its output. Follow its output or error guidance. If a network sandbox blocks it, retry with network access; if it still returns no output, continue normally.\n\n<!-- END:nextjs-agent-feedback -->"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Next.js updates only the content between the agent feedback markers and preserves the rest of the file."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Automatic agent feedback is experimental, disabled by default, and available only when "
				},
				{
					"type": "link",
					"title": null,
					"url": "/telemetry",
					"children": [
						{
							"type": "text",
							"value": "Next.js Telemetry"
						}
					]
				},
				{
					"type": "text",
					"value": " is enabled. It does not run in CI. See the "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/05-config/01-next-config-js/agentFeedback.md",
					"children": [
						{
							"type": "inlineCode",
							"value": "agentFeedback"
						},
						{
							"type": "text",
							"value": " API reference"
						}
					]
				},
				{
					"type": "text",
					"value": " to enable it."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Agent-guided upgrades"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "inlineCode",
					"value": "next upgrade --agent"
				},
				{
					"type": "text",
					"value": " checks for an available upgrade, gathers the version-matched migration guides, and hands the task to a coding agent. The agent applies the changes and verifies the app:"
				}
			]
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "filename=\"Terminal\"",
			"value": "npx next@canary upgrade --agent=latest"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The experimental "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/05-config/01-next-config-js/agentUpgrade.md",
					"children": [
						{
							"type": "inlineCode",
							"value": "agentUpgrade"
						}
					]
				},
				{
					"type": "text",
					"value": " option shows security upgrade reminders during "
				},
				{
					"type": "inlineCode",
					"value": "next dev"
				},
				{
					"type": "text",
					"value": " and "
				},
				{
					"type": "inlineCode",
					"value": "next build"
				},
				{
					"type": "text",
					"value": " by default. See "
				},
				{
					"type": "link",
					"title": null,
					"url": "./upgrading/agent-upgrade.md",
					"children": [
						{
							"type": "text",
							"value": "Upgrade with a coding agent"
						}
					]
				},
				{
					"type": "text",
					"value": " for the available policies and workflow."
				}
			]
		},
		{
			"type": "html",
			"value": "<span id=\"step-2-give-agents-runtime-visibility\" />"
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Runtime visibility"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Agents need both framework and browser state to verify a running application. Next.js and its supporting tools expose these complementary views as structured text."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "First, "
				},
				{
					"type": "inlineCode",
					"value": "next dev"
				},
				{
					"type": "text",
					"value": " forwards browser console errors and warnings to the terminal (the "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/05-config/01-next-config-js/logging.md",
					"children": [
						{
							"type": "inlineCode",
							"value": "logging.browserToTerminal"
						}
					]
				},
				{
					"type": "text",
					"value": " config), so the output agents already read carries the client-side failures they're asked to fix."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "inlineCode",
					"value": "next dev"
				},
				{
					"type": "text",
					"value": " also writes its PID, port, and URL to "
				},
				{
					"type": "inlineCode",
					"value": ".next/dev/lock"
				},
				{
					"type": "text",
					"value": ". If you run "
				},
				{
					"type": "inlineCode",
					"value": "next dev"
				},
				{
					"type": "text",
					"value": " while another development server is already running for the project, the command prints the existing server's URL and PID, along with a command to stop it. Continue with the existing server when possible to avoid interrupting the active development session."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "framework's view"
						}
					]
				},
				{
					"type": "text",
					"value": " comes from the "
				},
				{
					"type": "link",
					"title": null,
					"url": "./mcp.md",
					"children": [
						{
							"type": "text",
							"value": "Next.js MCP server"
						}
					]
				},
				{
					"type": "text",
					"value": " at "
				},
				{
					"type": "inlineCode",
					"value": "/_next/mcp"
				},
				{
					"type": "text",
					"value": ", which exposes the running dev server's routes, server logs, and compilation issues. Its "
				},
				{
					"type": "inlineCode",
					"value": "get_compilation_issues"
				},
				{
					"type": "text",
					"value": " and "
				},
				{
					"type": "inlineCode",
					"value": "compile_route"
				},
				{
					"type": "text",
					"value": " tools report whether the code compiles straight from the dev server, so an agent doesn't have to run a full "
				},
				{
					"type": "inlineCode",
					"value": "next build"
				},
				{
					"type": "text",
					"value": " to find out."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The "
				},
				{
					"type": "link",
					"title": null,
					"url": "#next-dev-loop",
					"children": [
