		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/blog/page.tsx\" switcher",
			"value": "export default async function Page() {\n\tconst data = await fetch('https://api.vercel.app/blog', {\n\t\tnext: { tags: ['posts'] },\n\t})\n\tconst posts = await data.json()\n\t// ...\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/blog/page.js\" switcher",
			"value": "export default async function Page() {\n\tconst data = await fetch('https://api.vercel.app/blog', {\n\t\tnext: { tags: ['posts'] },\n\t})\n\tconst posts = await data.json()\n\t// ...\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "If you are using an ORM or connecting to a database, you can use "
				},
				{
					"type": "inlineCode",
					"value": "unstable_cache"
				},
				{
					"type": "text",
					"value": ":"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/blog/page.tsx\" switcher",
			"value": "import { unstable_cache } from 'next/cache'\nimport { db, posts } from '@/lib/db'\n\nconst getCachedPosts = unstable_cache(\n\tasync () => {\n\t\treturn await db.select().from(posts)\n\t},\n\t['posts'],\n\t{ revalidate: 3600, tags: ['posts'] },\n)\n\nexport default async function Page() {\n\tconst posts = getCachedPosts()\n\t// ...\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/blog/page.js\" switcher",
			"value": "import { unstable_cache } from 'next/cache'\nimport { db, posts } from '@/lib/db'\n\nconst getCachedPosts = unstable_cache(\n\tasync () => {\n\t\treturn await db.select().from(posts)\n\t},\n\t['posts'],\n\t{ revalidate: 3600, tags: ['posts'] },\n)\n\nexport default async function Page() {\n\tconst posts = getCachedPosts()\n\t// ...\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "You can then use "
				},
				{
					"type": "inlineCode",
					"value": "revalidateTag"
				},
				{
					"type": "text",
					"value": " in a "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/getting-started/mutating-data",
					"children": [
						{
							"type": "text",
							"value": "Server Actions"
						}
					]
				},
				{
					"type": "text",
					"value": " or "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/api-reference/file-conventions/route",
					"children": [
						{
							"type": "text",
							"value": "Route Handler"
						}
					]
				},
				{
					"type": "text",
					"value": ":"
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": "filename=\"app/actions.ts\" switcher",
			"value": "'use server'\n\nimport { revalidateTag } from 'next/cache'\n\nexport async function createPost() {\n\t// Invalidate all data tagged with 'posts'\n\trevalidateTag('posts', 'max')\n}"
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"app/actions.js\" switcher",
			"value": "'use server'\n\nimport { revalidateTag } from 'next/cache'\n\nexport async function createPost() {\n\t// Invalidate all data tagged with 'posts'\n\trevalidateTag('posts', 'max')\n}"
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Handling uncaught exceptions"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "If an error is thrown while attempting to revalidate data, the last successfully generated data will continue to be served from the cache. On the next subsequent request, Next.js will retry revalidating the data. "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/getting-started/error-handling",
					"children": [
						{
							"type": "text",
							"value": "Learn more about error handling"
						}
					]
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Customizing the cache location"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "You can configure the Next.js cache location if you want to persist cached pages and data to durable storage, or share the cache across multiple containers or instances of your Next.js application. "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/guides/self-hosting#caching-and-isr",
					"children": [
						{
							"type": "text",
							"value": "Learn more"
						}
					]
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Troubleshooting"
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Debugging cached data in local development"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "If you are using the "
				},
				{
					"type": "inlineCode",
					"value": "fetch"
				},
				{
					"type": "text",
					"value": " API, you can add additional logging to understand which requests are cached or uncached. "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/api-reference/config/next-config-js/logging",
					"children": [
						{
							"type": "text",
							"value": "Learn more about the "
						},
						{
							"type": "inlineCode",
							"value": "logging"
						},
						{
							"type": "text",
							"value": " option"
						}
					]
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"next.config.js\"",
			"value": "module.exports = {\n\tlogging: {\n\t\tfetches: {\n\t\t\tfullUrl: true,\n\t\t},\n\t},\n}"
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Verifying correct production behavior"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To verify your pages are cached and revalidated correctly in production, you can test locally by running "
				},
				{
					"type": "inlineCode",
					"value": "next build"
				},
				{
					"type": "text",
					"value": " and then "
				},
				{
					"type": "inlineCode",
					"value": "next start"
				},
				{
					"type": "text",
					"value": " to run the production Next.js server."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "This will allow you to test ISR behavior as it would work in a production environment. For further debugging, add the following environment variable to your "
				},
				{
					"type": "inlineCode",
					"value": ".env"
				},
				{
					"type": "text",
					"value": " file:"
				}
			]
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "filename=\".env\"",
			"value": "NEXT_PRIVATE_DEBUG_CACHE=1"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "This will make the Next.js server console log ISR cache hits and misses. You can inspect the output to see which pages are generated during "
				},
				{
					"type": "inlineCode",
					"value": "next build"
				},
				{
					"type": "text",
					"value": ", as well as how pages are updated as paths are accessed on-demand."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Caveats"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "ISR is only supported when using the Node.js runtime (default)."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "ISR is not supported when creating a "
								},
								{
									"type": "link",
									"title": null,
									"url": "/docs/app/guides/static-exports",
									"children": [
										{
											"type": "text",
											"value": "Static Export"
										}
									]
								},
								{
									"type": "text",
									"value": "."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "If you have multiple "
								},
								{
									"type": "inlineCode",
									"value": "fetch"
								},
								{
									"type": "text",
									"value": " requests in a prerendered route, and each has a different "
								},
								{
									"type": "inlineCode",
									"value": "revalidate"
								},
								{
									"type": "text",
									"value": " frequency, the lowest time will be used for ISR. However, those revalidate frequencies will still be respected by the "
								},
								{
									"type": "link",
									"title": null,
									"url": "/docs/app/getting-started/caching",
									"children": [
										{
											"type": "text",
											"value": "cache"
										}
									]
								},
								{
									"type": "text",
									"value": "."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "If any of the "
								},
								{
									"type": "inlineCode",
									"value": "fetch"
								},
								{
									"type": "text",
									"value": " requests used on a route have a "
								},
								{
									"type": "inlineCode",
									"value": "revalidate"
								},
								{
									"type": "text",
									"value": " time of "
								},
								{
									"type": "inlineCode",
									"value": "0"
								},
								{
									"type": "text",
									"value": ", or an explicit "
								},
								{
									"type": "inlineCode",
									"value": "no-store"
								},
								{
									"type": "text",
									"value": ", the route will be dynamically rendered."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Proxy won't be executed for on-demand ISR requests, meaning any path rewrites or logic in Proxy will not be applied. Ensure you are revalidating the exact path. For example, "
								},
								{
									"type": "inlineCode",
									"value": "/post/1"
								},
								{
									"type": "text",
									"value": " instead of a rewritten "
								},
								{
									"type": "inlineCode",
									"value": "/post-1"
								},
								{
									"type": "text",
									"value": "."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "When running multiple instances, the default file-system cache is per-instance. On-demand revalidation only invalidates the instance that receives the call. Use a shared "
								},
								{
									"type": "link",
									"title": null,
									"url": "/docs/app/api-reference/config/next-config-js/incrementalCacheHandlerPath",
									"children": [
										{
											"type": "text",
											"value": "custom cache handler"
										}
									]
								},
								{
									"type": "text",
									"value": " to coordinate across instances. See "
								},
								{
									"type": "link",
									"title": null,
									"url": "/docs/app/guides/how-revalidation-works",
									"children": [
										{
											"type": "text",
											"value": "How Revalidation Works"
										}
									]
								},
								{
									"type": "text",
									"value": " for the full architecture."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Background regeneration (stale-while-revalidate) runs on the instance that receives the triggering request. On platforms with per-request billing, this background work counts as additional compute."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "You can use the "
								},
								{
									"type": "inlineCode",
									"value": "x-nextjs-cache"
								},
								{
									"type": "text",
									"value": " response header to observe cache behavior. Values are "
								},
								{
									"type": "inlineCode",
									"value": "HIT"
								},
								{
									"type": "text",
									"value": " (served from cache), "
								},
								{
									"type": "inlineCode",
									"value": "STALE"
								},
								{
									"type": "text",
									"value": " (served from cache, revalidating in background), "
								},
								{
									"type": "inlineCode",
									"value": "MISS"
								},
								{
									"type": "text",
									"value": " (not in cache, rendered fresh), or "
								},
								{
									"type": "inlineCode",
									"value": "REVALIDATED"
								},
								{
									"type": "text",
									"value": " (regenerated via on-demand revalidation)."
								}
							]
						}
					]
				}
			]
		},
