		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Update static content without rebuilding the entire site"
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Reduce server load by serving prerendered, static pages for most requests"
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Ensure proper "
								},
								{
									"type": "inlineCode",
									"value": "cache-control"
								},
								{
									"type": "text",
									"value": " headers are automatically added to pages"
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Handle large amounts of content pages without long "
								},
								{
									"type": "inlineCode",
									"value": "next build"
								},
								{
									"type": "text",
									"value": " times"
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Here's a minimal example:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/blog/[id]/page.tsx\" switcher",
			"value": "interface Post {\n\tid: string\n\ttitle: string\n\tcontent: string\n}\n\n// Next.js will invalidate the cache when a\n// request comes in, at most once every 60 seconds.\nexport const revalidate = 60\n\nexport async function generateStaticParams() {\n\tconst posts: Post[] = await fetch('https://api.vercel.app/blog').then((res) => res.json())\n\treturn posts.map((post) => ({\n\t\tid: String(post.id),\n\t}))\n}\n\nexport default async function Page({ params }: { params: Promise<{ id: string }> }) {\n\tconst { id } = await params\n\tconst post: Post = await fetch(`https://api.vercel.app/blog/${id}`).then((res) => res.json())\n\treturn (\n\t\t<main>\n\t\t\t<h1>{post.title}</h1>\n\t\t\t<p>{post.content}</p>\n\t\t</main>\n\t)\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/blog/[id]/page.jsx\" switcher",
			"value": "// Next.js will invalidate the cache when a\n// request comes in, at most once every 60 seconds.\nexport const revalidate = 60\n\nexport async function generateStaticParams() {\n\tconst posts = await fetch('https://api.vercel.app/blog').then((res) => res.json())\n\treturn posts.map((post) => ({\n\t\tid: String(post.id),\n\t}))\n}\n\nexport default async function Page({ params }) {\n\tconst { id } = await params\n\tconst post = await fetch(`https://api.vercel.app/blog/${id}`).then((res) => res.json())\n\treturn (\n\t\t<main>\n\t\t\t<h1>{post.title}</h1>\n\t\t\t<p>{post.content}</p>\n\t\t</main>\n\t)\n}"
		},
