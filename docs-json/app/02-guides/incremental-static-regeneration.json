		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "On-demand revalidation with "
				},
				{
					"type": "inlineCode",
					"value": "revalidateTag"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "For most use cases, prefer revalidating entire paths. If you need more granular control, you can use the "
				},
				{
					"type": "inlineCode",
					"value": "revalidateTag"
				},
				{
					"type": "text",
					"value": " function. For example, you can tag individual "
				},
				{
					"type": "inlineCode",
					"value": "fetch"
				},
