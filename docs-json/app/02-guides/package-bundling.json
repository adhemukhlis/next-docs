			"value": "pnpm next analyze --output"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "filename=\"Terminal\" package=\"bun\"",
			"value": "bunx next analyze --output"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "This command writes the output to "
