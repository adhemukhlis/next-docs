		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Click a module to see its size, inspect its full import chain and see exactly where it’s used in your application:"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "html",
					"value": "<Image\ncaption=\"Next.js Bundle Analyzer import chain view\"\nsrcLight=\"/docs/light/bundle-analyzer.png\"\nsrcDark=\"/docs/dark/bundle-analyzer.png\"\nwidth={1600}\nheight={874}\n/>"
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Step 4: Write output to disk for sharing or diffing"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "If you want to share the analysis with teammates or compare bundle sizes before/after optimizations, you can skip the interactive view and save the analysis as a static file with the "
				},
				{
					"type": "inlineCode",
					"value": "--output"
				},
				{
					"type": "text",
					"value": " flag:"
				}
			]
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "filename=\"Terminal\" package=\"npm\"",
			"value": "npx next analyze --output"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "filename=\"Terminal\" package=\"yarn\"",
			"value": "yarn next analyze --output"
		},
		{
			"type": "code",
			"lang": "bash",
