							]
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "This guide will walk you through how to use each tool and how to "
				},
				{
					"type": "link",
					"title": null,
					"url": "#optimizing-large-bundles",
					"children": [
						{
							"type": "text",
							"value": "optimize large bundles"
						}
					]
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Next.js Bundle Analyzer"
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "Available in v16.1 and later. You can share feedback in the "
						},
						{
							"type": "link",
							"title": null,
							"url": "https://github.com/vercel/next.js/discussions/86731",
							"children": [
								{
									"type": "text",
									"value": "dedicated GitHub discussion"
								}
							]
						},
						{
							"type": "text",
							"value": " and view the demo at "
						},
						{
							"type": "link",
							"title": null,
							"url": "https://turbopack-bundle-analyzer-demo.vercel.sh/",
							"children": [
								{
									"type": "text",
									"value": "turbopack-bundle-analyzer-demo.vercel.sh"
								}
							]
						},
						{
							"type": "text",
							"value": "."
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The Next.js Bundle Analyzer is integrated with Turbopack's module graph. You can inspect server and client modules with precise import tracing, making it easier to find large dependencies. Open the interactive Bundle Analyzer demo to explore the module graph."
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Step 1: Run the Turbopack Bundle Analyzer"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To get started, run the following command and open up the interactive view in your browser."
				}
			]
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "filename=\"Terminal\" package=\"npm\"",
			"value": "npx next analyze"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "filename=\"Terminal\" package=\"yarn\"",
			"value": "yarn next analyze"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "filename=\"Terminal\" package=\"pnpm\"",
			"value": "pnpm next analyze"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "filename=\"Terminal\" package=\"bun\"",
			"value": "bunx next analyze"
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Step 2: Filter and inspect modules"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Within the UI, you can filter by route, environment (client or server), and type (JavaScript, CSS, JSON), or search by file:"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "html",
					"value": "<Video\ncaption=\"Next.js bundle analyzer UI walkthrough\"\nsrc=\"/videos/bundle-analyzer.mp4\"\nwidth={1708}\nheight={1080}\n/>"
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Step 3: Trace modules with import chains"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The treemap shows each module as a rectangle. Where the size of the module is represented by the area of the rectangle."
