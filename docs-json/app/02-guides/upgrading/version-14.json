			"type": "yaml",
			"value": "title: How to upgrade to version 14\nnav_title: Version 14\ndescription: Upgrade your Next.js Application from Version 13 to 14."
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Upgrading from 13 to 14"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To update to Next.js version 14, run the following command using your preferred package manager:"
				}
			]
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "filename=\"Terminal\"",
			"value": "npm i next@next-14 react@18 react-dom@18 && npm i eslint-config-next@next-14 -D"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "filename=\"Terminal\"",
			"value": "yarn add next@next-14 react@18 react-dom@18 && yarn add eslint-config-next@next-14 -D"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "filename=\"Terminal\"",
			"value": "pnpm i next@next-14 react@18 react-dom@18 && pnpm i eslint-config-next@next-14 -D"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "filename=\"Terminal\"",
			"value": "bun add next@next-14 react@18 react-dom@18 && bun add eslint-config-next@next-14 -D"
		},
