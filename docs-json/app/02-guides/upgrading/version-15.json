		{
			"type": "yaml",
			"value": "title: How to upgrade to version 15\nnav_title: Version 15\ndescription: Upgrade your Next.js Application from Version 14 to 15."
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Upgrading from 14 to 15"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To update to Next.js version 15, you can use the "
				},
				{
					"type": "inlineCode",
					"value": "upgrade"
				},
				{
					"type": "text",
					"value": " codemod:"
				}
			]
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"pnpm\"",
			"value": "pnpm dlx @next/codemod@canary upgrade latest"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"npm\"",
			"value": "npx @next/codemod@canary upgrade latest"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"yarn\"",
			"value": "yarn dlx @next/codemod@canary upgrade latest"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"bun\"",
			"value": "bunx @next/codemod@canary upgrade latest"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "If you prefer to do it manually, ensure that you're installing the latest Next & React versions:"
				}
			]
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"pnpm\"",
			"value": "pnpm add next@latest react@latest react-dom@latest eslint-config-next@latest"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"npm\"",
			"value": "npm install next@latest react@latest react-dom@latest eslint-config-next@latest"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"yarn\"",
			"value": "yarn add next@latest react@latest react-dom@latest eslint-config-next@latest"
		},
		{
			"type": "code",
			"lang": "bash",
