										}
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Prepare your routes"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Use "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/04-functions/generate-static-params.md",
					"children": [
						{
							"type": "inlineCode",
							"value": "generateStaticParams"
						}
					]
				},
				{
					"type": "text",
					"value": " to define which param values to prerender. When rendering these routes, the param values are known at build time. The prerender process builds a static shell until it reaches a "
				},
				{
					"type": "link",
					"title": null,
					"url": "../04-glossary.md#request-time-apis",
					"children": [
						{
							"type": "text",
							"value": "Request-time API"
						}
					]
				},
				{
					"type": "text",
					"value": " or uncached data. See "
				},
				{
					"type": "link",
					"title": null,
					"url": "../01-getting-started/08-caching.md#prerendering",
					"children": [
						{
							"type": "text",
							"value": "Prerendering"
						}
					]
				},
				{
					"type": "text",
					"value": " for more details."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The category layout prerenders two categories:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/[category]/layout.tsx\" highlight={5-8}",
			"value": "import Link from 'next/link'\nimport { Suspense } from 'react'\nimport { getCategory, getTopCategories } from '../lib/data'\n\nexport async function generateStaticParams() {\n\tconst categories = await getTopCategories()\n\treturn categories.map((c) => ({ category: c.slug }))\n}\n\nasync function CategoryHeader({ params }: Pick<LayoutProps<'/[category]'>, 'params'>) {\n\tconst { category } = await params\n\tconst data = await getCategory(category)\n\n\treturn (\n\t\t<div>\n\t\t\t<Link href=\"/\">&larr; All categories</Link>\n\t\t\t<h1>{data?.name ?? 'Category'}</h1>\n\t\t\t{data?.description && <p>{data.description}</p>}\n\t\t</div>\n\t)\n}\n\nexport default function CategoryLayout(props: LayoutProps<'/[category]'>) {\n\treturn (\n\t\t<div>\n\t\t\t<Suspense fallback={<div>Loading...</div>}>\n\t\t\t\t<CategoryHeader params={props.params} />\n\t\t\t</Suspense>\n\t\t\t{props.children}\n\t\t</div>\n\t)\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Notice that "
				},
				{
					"type": "inlineCode",
					"value": "CategoryLayout"
				},
				{
					"type": "text",
					"value": " does not "
				},
				{
					"type": "inlineCode",
					"value": "await props.params"
				},
				{
					"type": "text",
					"value": " itself. Instead, it passes the "
				},
				{
					"type": "inlineCode",
					"value": "params"
				},
				{
					"type": "text",
					"value": " promise to "
				},
				{
					"type": "inlineCode",
					"value": "CategoryHeader"
				},
				{
					"type": "text",
					"value": " inside "
				},
				{
					"type": "inlineCode",
					"value": "<Suspense>"
				},
				{
					"type": "text",
					"value": ". The "
				},
				{
					"type": "inlineCode",
					"value": "await"
				},
				{
					"type": "text",
					"value": " happens inside the boundary, so for unknown categories Next.js can still generate the App Shell. Keep the read inside the boundary even for the categories "
				},
				{
					"type": "inlineCode",
					"value": "generateStaticParams"
				},
				{
					"type": "text",
					"value": " covers. A statically known param still belongs to one URL, so awaiting it above the Suspense boundary would tie this layout's App Shell to that URL. See "
				},
				{
					"type": "link",
					"title": null,
					"url": "./instant-navigation.md",
					"children": [
						{
							"type": "text",
							"value": "Instant navigation"
						}
					]
				},
				{
					"type": "text",
					"value": " for structuring routes this way."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The product page prerenders one product per category. "
				},
				{
					"type": "inlineCode",
					"value": "generateStaticParams"
				},
				{
					"type": "text",
					"value": " receives the parent "
				},
				{
					"type": "inlineCode",
					"value": "category"
				},
				{
					"type": "text",
					"value": " param:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/[category]/[product]/page.tsx\" highlight={5-12}",
			"value": "import { Suspense } from 'react'\nimport Link from 'next/link'\nimport { getProduct, getPopularProducts } from '../../lib/data'\n\nexport async function generateStaticParams({ params }: { params: { category: string } }) {\n\tconst products = await getPopularProducts(params.category)\n\treturn products.map((p) => ({ product: p.slug }))\n}\n\nasync function ProductDetails(props: PageProps<'/[category]/[product]'>) {\n\tconst { category, product } = await props.params\n\tconst data = await getProduct(category, product)\n\n\tif (!data) {\n\t\treturn <p>Product not found.</p>\n\t}\n\n\treturn (\n\t\t<>\n\t\t\t<Link\n\t\t\t\thref={`/${category}`}\n\t\t\t\tprefetch={true}>\n\t\t\t\t&larr; Back to products\n\t\t\t</Link>\n\t\t\t<h2>{data.name}</h2>\n\t\t\t<p>${data.price}</p>\n\t\t\t<p>{data.description}</p>\n\t\t</>\n\t)\n}\n\nexport default function ProductPage(props: PageProps<'/[category]/[product]'>) {\n\treturn (\n\t\t<div>\n\t\t\t<Suspense fallback={<div>Loading product...</div>}>\n\t\t\t\t<ProductDetails {...props} />\n\t\t\t</Suspense>\n\t\t</div>\n\t)\n}"
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know:"
								}
							]
						},
						{
							"type": "text",
							"value": " You can also use "
						},
						{
							"type": "link",
							"title": null,
							"url": "../03-api-reference/03-file-conventions/loading.md",
							"children": [
								{
									"type": "inlineCode",
									"value": "loading.tsx"
								}
							]
						},
						{
							"type": "text",
							"value": " files instead of "
						},
						{
							"type": "inlineCode",
							"value": "<Suspense>"
						},
						{
							"type": "text",
							"value": " in JSX. "
						},
						{
							"type": "inlineCode",
							"value": "loading.tsx"
						},
						{
							"type": "text",
							"value": " puts the boundary at the segment edge, while inline "
						},
						{
							"type": "inlineCode",
							"value": "<Suspense>"
						},
						{
							"type": "text",
							"value": " lets you place it anywhere in the tree."
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The data helpers use "
				},
				{
					"type": "inlineCode",
					"value": "'use cache'"
				},
				{
					"type": "text",
					"value": " at the module level so all exported functions are cached. This lets their results be included in the static shell:"
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": "filename=\"app/lib/data.ts\" highlight={1}",
			"value": "'use cache'\n\nconst API = 'https://next-recipe-api.vercel.dev'\n\nexport async function getCategory(slug: string) {\n\tconst res = await fetch(`${API}/categories/${slug}`)\n\tif (!res.ok) return null\n\treturn res.json()\n}\n\nexport async function getProduct(category: string, slug: string) {\n\tconst res = await fetch(`${API}/products/${category}/${slug}`)\n\tif (!res.ok) return null\n\treturn res.json()\n}\n\nexport async function getTopCategories() {\n\tconst res = await fetch(`${API}/categories`)\n\tconst categories = await res.json()\n\treturn categories.slice(0, 2)\n}\n\nexport async function getPopularProducts(category: string) {\n\tconst res = await fetch(`${API}/products?category=${category}`)\n\tconst products = await res.json()\n\treturn products.slice(0, 1)\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "If a component accesses a Request-time API such as "
				},
				{
					"type": "inlineCode",
					"value": "cookies()"
				},
				{
					"type": "text",
					"value": " or "
				},
				{
					"type": "inlineCode",
					"value": "headers()"
				},
				{
					"type": "text",
					"value": ", wrap it in "
				},
				{
					"type": "inlineCode",
					"value": "<Suspense>"
				},
				{
					"type": "text",
					"value": ". During prerendering, Next.js includes the nearest fallback in the static shell. To keep the component out of a "
				},
				{
					"type": "inlineCode",
					"value": "<Link prefetch={true}>"
				},
				{
					"type": "text",
					"value": " as well, await "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/04-functions/navigation.md",
					"children": [
						{
							"type": "inlineCode",
