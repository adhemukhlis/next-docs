									]
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "link",
									"title": null,
									"url": "https://github.com/nextjs/partial-fallbacks",
									"children": [
										{
											"type": "text",
