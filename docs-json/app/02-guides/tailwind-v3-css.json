				{
					"type": "text",
					"value": "Installing Tailwind v3"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Install Tailwind CSS and its peer dependencies, then run the "
				},
				{
					"type": "inlineCode",
					"value": "init"
				},
				{
					"type": "text",
					"value": " command to generate both "
				},
				{
					"type": "inlineCode",
					"value": "tailwind.config.js"
				},
				{
					"type": "text",
					"value": " and "
				},
				{
					"type": "inlineCode",
					"value": "postcss.config.js"
				},
				{
					"type": "text",
					"value": " files:"
				}
			]
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"pnpm\"",
			"value": "pnpm add -D tailwindcss@^3 postcss autoprefixer\nnpx tailwindcss init -p"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"npm\"",
			"value": "npm install -D tailwindcss@^3 postcss autoprefixer\nnpx tailwindcss init -p"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"yarn\"",
			"value": "yarn add -D tailwindcss@^3 postcss autoprefixer\nnpx tailwindcss init -p"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"bun\"",
			"value": "bun add -D tailwindcss@^3 postcss autoprefixer\nbunx tailwindcss init -p"
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Configuring Tailwind v3"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Configure your template paths in your "
				},
				{
					"type": "inlineCode",
					"value": "tailwind.config.js"
				},
				{
					"type": "text",
					"value": " file:"
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"tailwind.config.js\"",
			"value": "/** @type {import('tailwindcss').Config} */\nmodule.exports = {\n\tcontent: ['./app/**/*.{js,ts,jsx,tsx,mdx}', './pages/**/*.{js,ts,jsx,tsx,mdx}', './components/**/*.{js,ts,jsx,tsx,mdx}'],\n\ttheme: {\n\t\textend: {},\n\t},\n\tplugins: [],\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Add the Tailwind directives to your global CSS file:"
				}
			]
		},
		{
			"type": "code",
			"lang": "css",
			"meta": "filename=\"app/globals.css\"",
			"value": "@tailwind base;\n@tailwind components;\n@tailwind utilities;"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Import the CSS file in your root layout:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/layout.tsx\" switcher",
			"value": "import './globals.css'\n\nexport default function RootLayout({ children }: { children: React.ReactNode }) {\n\treturn (\n\t\t<html lang=\"en\">\n\t\t\t<body>{children}</body>\n\t\t</html>\n\t)\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/layout.js\" switcher",
			"value": "import './globals.css'\n\nexport default function RootLayout({ children }) {\n\treturn (\n\t\t<html lang=\"en\">\n\t\t\t<body>{children}</body>\n\t\t</html>\n\t)\n}"
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Using classes"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "After installing Tailwind CSS and adding the global styles, you can use Tailwind's utility classes in your application."
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/page.tsx\" switcher",
