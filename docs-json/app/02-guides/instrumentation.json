{
	"type": "root",
	"children": [
		{
			"type": "yaml",
			"value": "title: How to set up instrumentation\nnav_title: Instrumentation\ndescription: Learn how to use instrumentation to run code at server startup in your Next.js app"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Instrumentation is the process of using code to integrate monitoring and logging tools into your application. This allows you to track the performance and behavior of your application, and to debug issues in production."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Convention"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To set up instrumentation, create "
				},
				{
					"type": "inlineCode",
					"value": "instrumentation.ts|js"
				},
				{
					"type": "text",
					"value": " file in the "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "root directory"
						}
					]
				},
				{
					"type": "text",
					"value": " of your project (or inside the "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/03-file-conventions/src-folder.md",
					"children": [
						{
							"type": "inlineCode",
							"value": "src"
						}
					]
				},
				{
					"type": "text",
					"value": " folder if using one)."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Then, export a "
				},
				{
					"type": "inlineCode",
					"value": "register"
				},
				{
					"type": "text",
					"value": " function in the file. This function will be called "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "once"
						}
					]
				},
				{
					"type": "text",
					"value": " when a new Next.js server instance is initiated, and must complete before the server is ready to handle requests."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "For example, to use Next.js with "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://opentelemetry.io/",
					"children": [
						{
							"type": "text",
							"value": "OpenTelemetry"
						}
					]
				},
				{
					"type": "text",
					"value": " and "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://vercel.com/docs/tracing/instrumentation",
					"children": [
						{
							"type": "text",
							"value": "@vercel/otel"
						}
					]
				},
				{
					"type": "text",
					"value": ":"
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": "filename=\"instrumentation.ts\" switcher",
			"value": "import { registerOTel } from '@vercel/otel'\n\nexport function register() {\n\tregisterOTel('next-app')\n}"
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"instrumentation.js\" switcher",
			"value": "import { registerOTel } from '@vercel/otel'\n\nexport function register() {\n\tregisterOTel('next-app')\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "See the "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://github.com/vercel/next.js/tree/canary/examples/with-opentelemetry",
					"children": [
						{
							"type": "text",
							"value": "Next.js with OpenTelemetry example"
						}
					]
				},
				{
					"type": "text",
					"value": " for a complete implementation."
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know"
								}
							]
						},
						{
							"type": "text",
							"value": ":"
						}
					]
				},
				{
					"type": "list",
					"ordered": false,
					"start": null,
					"spread": false,
					"children": [
						{
							"type": "listItem",
							"spread": false,
							"checked": null,
							"children": [
								{
									"type": "paragraph",
									"children": [
										{
											"type": "text",
											"value": "The "
										},
										{
											"type": "inlineCode",
											"value": "instrumentation"
										},
										{
											"type": "text",
											"value": " file should be in the root of your project and not inside the "
										},
										{
											"type": "inlineCode",
											"value": "app"
										},
										{
											"type": "text",
											"value": " or "
										},
										{
											"type": "inlineCode",
											"value": "pages"
										},
										{
											"type": "text",
											"value": " directory. If you're using the "
										},
										{
											"type": "inlineCode",
											"value": "src"
										},
										{
											"type": "text",
											"value": " folder, then place the file inside "
										},
										{
											"type": "inlineCode",
											"value": "src"
										},
										{
											"type": "text",
											"value": " alongside "
										},
										{
											"type": "inlineCode",
											"value": "pages"
										},
										{
											"type": "text",
											"value": " and "
										},
										{
											"type": "inlineCode",
											"value": "app"
										},
										{
											"type": "text",
											"value": "."
										}
									]
								}
							]
						},
						{
							"type": "listItem",
							"spread": false,
							"checked": null,
							"children": [
								{
									"type": "paragraph",
									"children": [
										{
											"type": "text",
											"value": "If you use the "
										},
										{
											"type": "link",
											"title": null,
											"url": "../03-api-reference/05-config/01-next-config-js/pageExtensions.md",
											"children": [
												{
													"type": "inlineCode",
													"value": "pageExtensions"
												},
												{
													"type": "text",
													"value": " config option"
												}
											]
										},
										{
											"type": "text",
											"value": " to add a suffix, you will also need to update the "
										},
										{
											"type": "inlineCode",
											"value": "instrumentation"
										},
										{
											"type": "text",
											"value": " filename to match."
										}
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Examples"
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Importing files with side effects"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Sometimes, it may be useful to import a file in your code because of the side effects it will cause. For example, you might import a file that defines a set of global variables, but never explicitly use the imported file in your code. You would still have access to the global variables the package has declared."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "We recommend importing files using JavaScript "
				},
				{
					"type": "inlineCode",
					"value": "import"
				},
				{
					"type": "text",
					"value": " syntax within your "
				},
				{
					"type": "inlineCode",
					"value": "register"
				},
				{
					"type": "text",
					"value": " function. The following example demonstrates a basic usage of "
				},
				{
					"type": "inlineCode",
					"value": "import"
				},
				{
					"type": "text",
					"value": " in a "
				},
				{
					"type": "inlineCode",
					"value": "register"
				},
				{
					"type": "text",
					"value": " function:"
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": "filename=\"instrumentation.ts\" switcher",
			"value": "export async function register() {\n\tawait import('package-with-side-effect')\n}"
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"instrumentation.js\" switcher",
			"value": "export async function register() {\n\tawait import('package-with-side-effect')\n}"
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know:"
								}
							]
						}
					]
				},
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "We recommend importing the file from within the "
						},
						{
							"type": "inlineCode",
							"value": "register"
						},
						{
							"type": "text",
							"value": " function, rather than at the top of the file. By doing this, you can colocate all of your side effects in one place in your code, and avoid any unintended consequences from importing globally at the top of the file."
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Importing runtime-specific code"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Next.js calls "
				},
				{
					"type": "inlineCode",
					"value": "register"
				},
				{
					"type": "text",
					"value": " in all environments, so it's important to conditionally import any code that doesn't support specific runtimes (e.g. "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/07-edge.md",
					"children": [
						{
							"type": "text",
							"value": "Edge or Node.js"
						}
					]
				},
				{
					"type": "text",
					"value": "). You can use the "
				},
				{
					"type": "inlineCode",
					"value": "NEXT_RUNTIME"
				},
				{
					"type": "text",
					"value": " environment variable to get the current environment:"
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": "filename=\"instrumentation.ts\" switcher",
			"value": "export async function register() {\n\tif (process.env.NEXT_RUNTIME === 'nodejs') {\n\t\tawait import('./instrumentation-node')\n\t}\n\n\tif (process.env.NEXT_RUNTIME === 'edge') {\n\t\tawait import('./instrumentation-edge')\n\t}\n}"
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"instrumentation.js\" switcher",
			"value": "export async function register() {\n\tif (process.env.NEXT_RUNTIME === 'nodejs') {\n\t\tawait import('./instrumentation-node')\n\t}\n\n\tif (process.env.NEXT_RUNTIME === 'edge') {\n\t\tawait import('./instrumentation-edge')\n\t}\n}"
		},
		{
