{
	"type": "root",
	"children": [
		{
			"type": "yaml",
			"value": "title: env\ndescription: Learn to add and access environment variables in your Next.js application at build time.\nversion: legacy"
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "Since the release of "
						},
						{
							"type": "link",
							"title": null,
							"url": "https://nextjs.org/blog/next-9-4",
							"children": [
								{
									"type": "text",
									"value": "Next.js 9.4"
								}
							]
						},
						{
							"type": "text",
							"value": " we now have a more intuitive and ergonomic experience for "
						},
						{
							"type": "link",
							"title": null,
							"url": "../../../02-guides/environment-variables.md",
							"children": [
								{
									"type": "text",
									"value": "adding environment variables"
								}
							]
						},
						{
							"type": "text",
							"value": ". Give it a try!"
						}
					]
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know"
								}
							]
						},
						{
							"type": "text",
							"value": ": environment variables specified in this way will "
						},
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "always"
								}
							]
						},
						{
							"type": "text",
							"value": " be included in the JavaScript bundle, prefixing the environment variable name with "
						},
						{
							"type": "inlineCode",
							"value": "NEXT_PUBLIC_"
						},
						{
							"type": "text",
							"value": " only has an effect when specifying them "
						},
						{
							"type": "link",
							"title": null,
							"url": "../../../02-guides/environment-variables.md",
							"children": [
								{
									"type": "text",
									"value": "through the environment or .env files"
								}
							]
						},
						{
							"type": "text",
							"value": "."
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To add environment variables to the JavaScript bundle, open "
				},
				{
					"type": "inlineCode",
					"value": "next.config.js"
				},
				{
					"type": "text",
					"value": " and add the "
				},
				{
					"type": "inlineCode",
					"value": "env"
				},
				{
					"type": "text",
					"value": " config:"
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\"",
			"value": "module.exports = {\n\tenv: {\n\t\tcustomKey: 'my-value',\n\t},\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Now you can access "
				},
				{
					"type": "inlineCode",
					"value": "process.env.customKey"
				},
				{
					"type": "text",
					"value": " in your code. For example:"
				}
			]
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": null,
			"value": "function Page() {\n\treturn <h1>The value of customKey is: {process.env.customKey}</h1>\n}\n\nexport default Page"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Next.js will replace "
				},
				{
					"type": "inlineCode",
					"value": "process.env.customKey"
				},
				{
					"type": "text",
					"value": " with "
				},
				{
					"type": "inlineCode",
					"value": "'my-value'"
				},
				{
					"type": "text",
					"value": " at build time. Trying to destructure "
				},
				{
					"type": "inlineCode",
					"value": "process.env"
				},
				{
					"type": "text",
					"value": " variables won't work due to the nature of webpack "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://webpack.js.org/plugins/define-plugin/",
					"children": [
						{
							"type": "text",
							"value": "DefinePlugin"
						}
					]
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "For example, the following line:"
				}
			]
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": null,
			"value": "return <h1>The value of customKey is: {process.env.customKey}</h1>"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Will end up being:"
				}
			]
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": null,
			"value": "return <h1>The value of customKey is: {'my-value'}</h1>"
		}
	]
}
