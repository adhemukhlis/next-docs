			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The "
				},
				{
					"type": "inlineCode",
					"value": "turbopack.ignoreIssue"
				},
				{
					"type": "text",
					"value": " option allows you to filter out specific "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/api-reference/turbopack",
					"children": [
						{
							"type": "text",
							"value": "Turbopack"
						}
					]
				},
				{
					"type": "text",
					"value": " errors and warnings so they do not appear in the CLI output or the error overlay. This is useful for suppressing known warnings that do not affect your application, such as intentionally unresolved optional dependencies."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "This option is only available when using Turbopack ("
				},
				{
					"type": "inlineCode",
					"value": "next dev --turbopack"
				},
				{
					"type": "text",
					"value": ")."
				}
			]
		},
		{
