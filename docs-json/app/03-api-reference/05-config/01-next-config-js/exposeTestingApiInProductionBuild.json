{
	"type": "root",
	"children": [
		{
			"type": "yaml",
			"value": "title: exposeTestingApiInProductionBuild\ndescription: Expose the Instant Navigation testing API in production builds for end-to-end tests.\nversion: experimental\nrelated:\n title: Related\n description: Learn how to inspect and test instant navigation.\n links:\n  - app/api-reference/file-conventions/route-segment-config/instant\n  - app/guides/instant-navigation"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "inlineCode",
					"value": "experimental.exposeTestingApiInProductionBuild"
				},
				{
					"type": "text",
					"value": " includes the Instant Navigation testing API in a production build. The "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/guides/instant-navigation#prevent-regressions-with-e2e-tests",
					"children": [
						{
							"type": "inlineCode",
							"value": "instant()"
						},
						{
							"type": "text",
							"value": " helper from "
						},
						{
							"type": "inlineCode",
							"value": "@next/playwright"
						}
					]
				},
				{
					"type": "text",
					"value": " uses this API to pause request-time content while an end-to-end test asserts on the UI available immediately."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Enable the option only for a dedicated test build:"
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": "filename=\"next.config.ts\" switcher highlight={3,8}",
			"value": "import type { NextConfig } from 'next'\n\nconst exposeTestingApi = process.env.EXPOSE_TESTING_API === '1'\n\nconst nextConfig: NextConfig = {\n\tcacheComponents: true,\n\texperimental: {\n\t\texposeTestingApiInProductionBuild: exposeTestingApi,\n\t},\n}\n\nexport default nextConfig"
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\" switcher highlight={1,7}",
			"value": "const exposeTestingApi = process.env.EXPOSE_TESTING_API === '1'\n\n/** @type {import('next').NextConfig} */\nconst nextConfig = {\n\tcacheComponents: true,\n\texperimental: {\n\t\texposeTestingApiInProductionBuild: exposeTestingApi,\n\t},\n}\n\nmodule.exports = nextConfig"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Set the condition when running "
				},
				{
					"type": "inlineCode",
					"value": "next build"
				},
				{
					"type": "text",
					"value": ", then serve that build with "
				},
				{
					"type": "inlineCode",
					"value": "next start"
				},
				{
					"type": "text",
					"value": ":"
				}
			]
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "filename=\"Terminal\"",
			"value": "EXPOSE_TESTING_API=1 pnpm build\npnpm start"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Setting the condition only for "
				},
				{
					"type": "inlineCode",
					"value": "next start"
				},
				{
					"type": "text",
					"value": " does not add the testing API to an existing build."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
