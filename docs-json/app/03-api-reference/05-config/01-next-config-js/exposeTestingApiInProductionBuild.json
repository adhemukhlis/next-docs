							"type": "tableCell",
							"children": [
								{
									"type": "text",
									"value": "Includes the testing API in the production build."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The option requires "
				},
