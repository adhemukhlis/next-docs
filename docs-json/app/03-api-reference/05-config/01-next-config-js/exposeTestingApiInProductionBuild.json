					"type": "link",
					"title": null,
					"url": "./cacheComponents.md",
					"children": [
						{
							"type": "inlineCode",
							"value": "cacheComponents"
						}
					]
				},
				{
					"type": "text",
					"value": ". Development builds expose the testing API automatically when Cache Components is enabled."
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
