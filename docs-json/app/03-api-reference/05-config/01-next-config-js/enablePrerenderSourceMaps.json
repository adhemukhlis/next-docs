{
	"type": "root",
	"children": [
		{
			"type": "yaml",
			"value": "title: enablePrerenderSourceMaps\ndescription: Enable source maps for errors during prerendering in next build."
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The "
				},
				{
					"type": "inlineCode",
					"value": "enablePrerenderSourceMaps"
				},
				{
					"type": "text",
					"value": " option lets Node.js use existing source maps during the prerender phase of "
				},
				{
					"type": "inlineCode",
					"value": "next build"
				},
				{
					"type": "text",
					"value": ". When source maps are available, error stack traces point to the original source code. It defaults to "
				},
				{
					"type": "inlineCode",
					"value": "true"
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "This option does not generate source maps. Webpack does not generate server source maps by default. To generate them when investigating prerender errors, use "
				},
				{
					"type": "link",
					"title": null,
					"url": "../../06-cli/next.md#debugging-prerender-errors",
					"children": [
						{
							"type": "inlineCode",
							"value": "next build --debug-prerender"
						}
					]
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To disable it, set "
				},
				{
					"type": "inlineCode",
					"value": "enablePrerenderSourceMaps"
				},
				{
					"type": "text",
					"value": " to "
				},
				{
					"type": "inlineCode",
					"value": "false"
				},
				{
					"type": "text",
					"value": ":"
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": "filename=\"next.config.ts\" switcher highlight={4}",
			"value": "import type { NextConfig } from 'next'\n\nconst nextConfig: NextConfig = {\n\tenablePrerenderSourceMaps: false,\n}\n\nexport default nextConfig"
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\" switcher highlight={3}",
			"value": "/** @type {import('next').NextConfig} */\nconst nextConfig = {\n\tenablePrerenderSourceMaps: false,\n}\n\nmodule.exports = nextConfig"
		},
		{
