{
	"type": "root",
	"children": [
		{
			"type": "yaml",
			"value": "title: basePath\ndescription: Use `basePath` to deploy a Next.js application under a sub-path of a domain."
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To deploy a Next.js application under a sub-path of a domain you can use the "
				},
				{
					"type": "inlineCode",
					"value": "basePath"
				},
				{
					"type": "text",
					"value": " config option."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "inlineCode",
					"value": "basePath"
				},
				{
					"type": "text",
					"value": " allows you to set a path prefix for the application. For example, to use "
				},
				{
					"type": "inlineCode",
					"value": "/docs"
				},
				{
					"type": "text",
					"value": " instead of "
				},
				{
					"type": "inlineCode",
					"value": "''"
				},
				{
					"type": "text",
					"value": " (an empty string, the default), open "
				},
				{
					"type": "inlineCode",
					"value": "next.config.js"
				},
				{
					"type": "text",
					"value": " and add the "
				},
				{
					"type": "inlineCode",
					"value": "basePath"
				},
				{
					"type": "text",
					"value": " config:"
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\"",
			"value": "module.exports = {\n\tbasePath: '/docs',\n}"
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know"
								}
							]
						},
						{
							"type": "text",
							"value": ": This value must be set at build time and cannot be changed without re-building as the value is inlined in the client-side bundles."
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Links"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "When linking to other pages using "
				},
				{
					"type": "inlineCode",
					"value": "next/link"
				},
				{
					"type": "text",
					"value": " and "
				},
				{
					"type": "inlineCode",
					"value": "next/router"
				},
				{
					"type": "text",
					"value": " the "
				},
				{
					"type": "inlineCode",
					"value": "basePath"
				},
				{
					"type": "text",
					"value": " will be automatically applied."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "For example, using "
				},
				{
					"type": "inlineCode",
					"value": "/about"
				},
				{
					"type": "text",
					"value": " will automatically become "
				},
				{
					"type": "inlineCode",
					"value": "/docs/about"
				},
				{
					"type": "text",
					"value": " when "
				},
				{
					"type": "inlineCode",
					"value": "basePath"
				},
				{
					"type": "text",
					"value": " is set to "
				},
				{
					"type": "inlineCode",
					"value": "/docs"
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": null,
			"value": "export default function HomePage() {\n\treturn (\n\t\t<>\n\t\t\t<Link href=\"/about\">About Page</Link>\n\t\t</>\n\t)\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Output html:"
				}
			]
		},
		{
			"type": "code",
			"lang": "html",
			"meta": null,
			"value": "<a href=\"/docs/about\">About Page</a>"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "This makes sure that you don't have to change all links in your application when changing the "
				},
				{
					"type": "inlineCode",
					"value": "basePath"
				},
				{
					"type": "text",
					"value": " value."
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Images"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "When using the "
				},
				{
					"type": "link",
					"title": null,
					"url": "../../02-components/image.md",
					"children": [
						{
							"type": "inlineCode",
							"value": "next/image"
						}
					]
				},
				{
					"type": "text",
					"value": " component, you will need to add the "
				},
				{
					"type": "inlineCode",
					"value": "basePath"
				},
				{
					"type": "text",
					"value": " in front of "
				},
				{
					"type": "inlineCode",
					"value": "src"
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "For example, using "
				},
				{
					"type": "inlineCode",
					"value": "/docs/me.png"
				},
				{
					"type": "text",
					"value": " will properly serve your image when "
				},
				{
					"type": "inlineCode",
					"value": "basePath"
				},
				{
					"type": "text",
					"value": " is set to "
				},
				{
					"type": "inlineCode",
					"value": "/docs"
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": null,
			"value": "import Image from 'next/image'\n\nfunction Home() {\n\treturn (\n\t\t<>\n\t\t\t<h1>My Homepage</h1>\n\t\t\t<Image\n\t\t\t\tsrc=\"/docs/me.png\"\n\t\t\t\talt=\"Picture of the author\"\n\t\t\t\twidth={500}\n\t\t\t\theight={500}\n\t\t\t/>\n\t\t\t<p>Welcome to my homepage!</p>\n\t\t</>\n\t)\n}\n\nexport default Home"
		}
	]
}
