{
	"type": "root",
	"children": [
		{
			"type": "yaml",
			"value": "title: cacheLife\ndescription: Learn how to set up cacheLife configurations in Next.js."
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The "
				},
				{
					"type": "inlineCode",
					"value": "cacheLife"
				},
				{
					"type": "text",
					"value": " option allows you to define "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "custom cache profiles"
						}
					]
				},
				{
					"type": "text",
					"value": " when using the "
				},
				{
					"type": "link",
					"title": null,
					"url": "../../04-functions/cacheLife.md",
					"children": [
						{
							"type": "inlineCode",
							"value": "cacheLife"
						}
					]
				},
				{
					"type": "text",
					"value": " function inside components or functions, and within the scope of the "
				},
				{
					"type": "link",
					"title": null,
					"url": "../../01-directives/use-cache.md",
					"children": [
						{
							"type": "inlineCode",
							"value": "use cache"
						},
						{
							"type": "text",
							"value": " directive"
						}
					]
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Usage"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To define a profile, enable the "
				},
				{
					"type": "link",
					"title": null,
					"url": "./cacheComponents.md",
					"children": [
						{
							"type": "inlineCode",
							"value": "cacheComponents"
						},
						{
							"type": "text",
							"value": " flag"
						}
					]
				},
				{
					"type": "text",
					"value": " and add the cache profile in the "
				},
				{
					"type": "inlineCode",
					"value": "cacheLife"
				},
				{
					"type": "text",
					"value": " object in the "
				},
				{
					"type": "inlineCode",
					"value": "next.config.js"
				},
				{
					"type": "text",
					"value": " file. For example, a "
				},
				{
					"type": "inlineCode",
					"value": "blog"
				},
				{
					"type": "text",
					"value": " profile:"
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": "filename=\"next.config.ts\" switcher",
			"value": "import type { NextConfig } from 'next'\n\nconst nextConfig: NextConfig = {\n\tcacheComponents: true,\n\tcacheLife: {\n\t\tblog: {\n\t\t\tstale: 3600, // 1 hour\n\t\t\trevalidate: 900, // 15 minutes\n\t\t\texpire: 86400, // 1 day\n\t\t},\n\t},\n}\n\nexport default nextConfig"
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\" switcher",
			"value": "module.exports = {\n\tcacheComponents: true,\n\tcacheLife: {\n\t\tblog: {\n\t\t\tstale: 3600, // 1 hour\n\t\t\trevalidate: 900, // 15 minutes\n\t\t\texpire: 86400, // 1 day\n\t\t},\n\t},\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "You can now use this custom "
				},
				{
					"type": "inlineCode",
					"value": "blog"
				},
				{
					"type": "text",
					"value": " configuration in your component or function as follows:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/actions.ts\" highlight={4,5} switcher",
			"value": "import { cacheLife } from 'next/cache'\n\nexport async function getCachedData() {\n\t'use cache'\n\tcacheLife('blog')\n\tconst res = await fetch('https://api.example.com/data')\n\tconst data = await res.json()\n\treturn data\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/actions.js\" highlight={4,5} switcher",
			"value": "import { cacheLife } from 'next/cache'\n\nexport async function getCachedData() {\n\t'use cache'\n\tcacheLife('blog')\n\tconst res = await fetch('https://api.example.com/data')\n\tconst data = await res.json()\n\treturn data\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "You can also override a built-in profile by defining one with the same name ("
				},
				{
					"type": "inlineCode",
					"value": "default"
				},
				{
					"type": "text",
					"value": ", "
				},
				{
					"type": "inlineCode",
					"value": "seconds"
				},
				{
					"type": "text",
					"value": ", "
				},
				{
					"type": "inlineCode",
					"value": "minutes"
				},
				{
					"type": "text",
					"value": ", "
				},
				{
					"type": "inlineCode",
					"value": "hours"
				},
				{
					"type": "text",
					"value": ", "
				},
				{
					"type": "inlineCode",
					"value": "days"
				},
				{
					"type": "text",
					"value": ", "
				},
				{
					"type": "inlineCode",
					"value": "weeks"
				},
				{
					"type": "text",
					"value": ", or "
				},
				{
					"type": "inlineCode",
					"value": "max"
				},
				{
					"type": "text",
					"value": "). See "
				},
				{
					"type": "link",
					"title": null,
					"url": "../../04-functions/cacheLife.md#overriding-the-default-cache-profiles",
					"children": [
