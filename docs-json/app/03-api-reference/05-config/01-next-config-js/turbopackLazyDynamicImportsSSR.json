			"value": "title: turbopackLazyDynamicImportsSSR\ndescription: Compile dynamic imports when server rendering first reaches them during development.\nversion: experimental"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The "
				},
				{
					"type": "inlineCode",
					"value": "experimental.turbopackLazyDynamicImportsSSR"
				},
				{
					"type": "text",
					"value": " option defers compiling dynamic imports until server rendering first reaches them during "
				},
				{
					"type": "inlineCode",
					"value": "next dev"
				},
				{
					"type": "text",
					"value": "."
				}
