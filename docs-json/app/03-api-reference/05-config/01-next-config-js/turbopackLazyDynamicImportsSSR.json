		},
		{
			"type": "code",
			"lang": "ts",
			"meta": "filename=\"next.config.ts\" switcher highlight={5}",
			"value": "import type { NextConfig } from 'next'\n\nconst nextConfig: NextConfig = {\n\texperimental: {\n\t\tturbopackLazyDynamicImportsSSR: true,\n\t},\n}\n\nexport default nextConfig"
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\" switcher highlight={4}",
			"value": "/** @type {import('next').NextConfig} */\nconst nextConfig = {\n\texperimental: {\n\t\tturbopackLazyDynamicImportsSSR: true,\n\t},\n}\n\nmodule.exports = nextConfig"
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "How it works"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Client Components can use "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://react.dev/reference/react/lazy",
					"children": [
						{
							"type": "inlineCode",
							"value": "lazy"
						}
					]
				},
				{
					"type": "text",
					"value": " to load a component dynamically. With "
				},
				{
					"type": "inlineCode",
					"value": "turbopackLazyDynamicImportsSSR"
				},
				{
					"type": "text",
					"value": " enabled, Turbopack compiles the imported component when a server render first reaches it. A target that is not rendered remains uncompiled."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "In the following example, Turbopack compiles "
