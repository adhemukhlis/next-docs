					"value": "Preview"
				},
				{
					"type": "text",
					"value": " when "
				},
				{
					"type": "inlineCode",
					"value": "showPreview"
				},
				{
					"type": "text",
					"value": " is "
				},
				{
					"type": "inlineCode",
					"value": "true"
				},
				{
					"type": "text",
					"value": " during server rendering:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/preview.tsx\" switcher",
			"value": "'use client'\n\nimport { lazy } from 'react'\n\nconst Preview = lazy(() => import('./preview-panel'))\n\nexport function MaybePreview({ showPreview }: { showPreview: boolean }) {\n\treturn showPreview ? <Preview /> : null\n}"
		},
		{
