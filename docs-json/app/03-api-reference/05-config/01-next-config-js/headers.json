					"children": [
						{
							"type": "text",
							"value": "This header"
						}
					]
				},
				{
					"type": "text",
					"value": " allows you to control which features and APIs can be used in the browser. It was previously named "
				},
				{
					"type": "inlineCode",
					"value": "Feature-Policy"
				},
				{
					"type": "text",
					"value": "."
