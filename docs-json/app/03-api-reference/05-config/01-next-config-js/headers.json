					"children": [
						{
							"type": "text",
							"value": "This header"
						}
					]
				},
				{
					"type": "text",
					"value": " prevents the browser from attempting to guess the type of content if the "
				},
				{
					"type": "inlineCode",
					"value": "Content-Type"
				},
				{
					"type": "text",
					"value": " header is not explicitly set. This can prevent XSS exploits for websites that allow users to upload and share files."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "For example, a user trying to download an image, but having it treated as a different "
				},
				{
					"type": "inlineCode",
					"value": "Content-Type"
				},
				{
					"type": "text",
					"value": " like an executable, which could be malicious. This header also applies to downloading browser extensions. The only valid value for this header is "
				},
				{
					"type": "inlineCode",
					"value": "nosniff"
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": null,
			"value": "{\n  key: 'X-Content-Type-Options',\n  value: 'nosniff'\n}"
		},
