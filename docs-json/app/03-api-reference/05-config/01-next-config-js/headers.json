		},
		{
			"type": "code",
			"lang": "js",
			"meta": null,
			"value": "{\n  key: 'Permissions-Policy',\n  value: 'camera=(), microphone=(), geolocation=(), browsing-topics=()'\n}"
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "X-Content-Type-Options"
