		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Cache-Control"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Next.js sets the "
				},
				{
					"type": "inlineCode",
					"value": "Cache-Control"
				},
				{
					"type": "text",
					"value": " header of "
				},
				{
					"type": "inlineCode",
					"value": "public, max-age=31536000, immutable"
				},
				{
					"type": "text",
					"value": " for truly immutable assets. It cannot be overridden. These immutable files contain a SHA-hash in the file name, so they can be safely cached indefinitely. For example, "
				},
				{
					"type": "link",
					"title": null,
					"url": "../../../01-getting-started/12-images.md#local-images",
					"children": [
						{
							"type": "text",
							"value": "Static Image Imports"
						}
					]
				},
				{
					"type": "text",
					"value": ". You cannot set "
				},
				{
					"type": "inlineCode",
					"value": "Cache-Control"
				},
				{
					"type": "text",
					"value": " headers in "
				},
				{
					"type": "inlineCode",
					"value": "next.config.js"
				},
				{
					"type": "text",
					"value": " for these assets."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "However, you can set "
				},
				{
					"type": "inlineCode",
					"value": "Cache-Control"
				},
				{
					"type": "text",
					"value": " headers for other responses or data."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Learn more about "
				},
				{
					"type": "link",
					"title": null,
					"url": "../../../01-getting-started/08-caching.md",
					"children": [
						{
							"type": "text",
							"value": "caching"
						}
					]
				},
				{
					"type": "text",
					"value": " with the App Router."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Options"
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "CORS"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "link",
					"title": null,
					"url": "https://developer.mozilla.org/docs/Web/HTTP/CORS",
					"children": [
						{
							"type": "text",
							"value": "Cross-Origin Resource Sharing (CORS)"
						}
					]
				},
				{
					"type": "text",
					"value": " is a security feature that allows you to control which sites can access your resources. You can set the "
				},
				{
					"type": "inlineCode",
					"value": "Access-Control-Allow-Origin"
				},
				{
					"type": "text",
					"value": " header to allow a specific origin to access your Route Handlers."
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": null,
			"value": "headers() {\n    return [\n      {\n        source: \"/api/:path*\",\n        headers: [\n          {\n            key: \"Access-Control-Allow-Origin\",\n            value: \"*\", // Set your origin\n          },\n          {\n            key: \"Access-Control-Allow-Methods\",\n            value: \"GET, POST, PUT, DELETE, OPTIONS\",\n          },\n          {\n            key: \"Access-Control-Allow-Headers\",\n            value: \"Content-Type, Authorization\",\n          },\n        ],\n      },\n    ];\n  },"
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "X-DNS-Prefetch-Control"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "link",
					"title": null,
					"url": "https://developer.mozilla.org/docs/Web/HTTP/Headers/X-DNS-Prefetch-Control",
					"children": [
						{
							"type": "text",
							"value": "This header"
						}
					]
				},
				{
					"type": "text",
					"value": " controls DNS prefetching, allowing browsers to proactively perform domain name resolution on external links, images, CSS, JavaScript, and more. This prefetching is performed in the background, so the "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://developer.mozilla.org/docs/Glossary/DNS",
					"children": [
						{
							"type": "text",
							"value": "DNS"
						}
					]
				},
				{
					"type": "text",
					"value": " is more likely to be resolved by the time the referenced items are needed. This reduces latency when the user clicks a link."
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": null,
			"value": "{\n  key: 'X-DNS-Prefetch-Control',\n  value: 'on'\n}"
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Strict-Transport-Security"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "link",
					"title": null,
					"url": "https://developer.mozilla.org/docs/Web/HTTP/Headers/Strict-Transport-Security",
					"children": [
						{
							"type": "text",
							"value": "This header"
						}
					]
				},
				{
					"type": "text",
					"value": " informs browsers it should only be accessed using HTTPS, instead of using HTTP. Using the configuration below, all present and future subdomains will use HTTPS for a "
				},
				{
					"type": "inlineCode",
					"value": "max-age"
				},
				{
					"type": "text",
					"value": " of 2 years. This blocks access to pages or subdomains that can only be served over HTTP."
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": null,
			"value": "{\n  key: 'Strict-Transport-Security',\n  value: 'max-age=63072000; includeSubDomains; preload'\n}"
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "X-Frame-Options"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "link",
					"title": null,
					"url": "https://developer.mozilla.org/docs/Web/HTTP/Headers/X-Frame-Options",
					"children": [
						{
							"type": "text",
							"value": "This header"
						}
					]
				},
				{
					"type": "text",
					"value": " indicates whether the site should be allowed to be displayed within an "
				},
				{
					"type": "inlineCode",
					"value": "iframe"
				},
				{
					"type": "text",
					"value": ". This can prevent against clickjacking attacks."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "This header has been superseded by CSP's "
						},
						{
							"type": "inlineCode",
							"value": "frame-ancestors"
						},
						{
							"type": "text",
							"value": " option"
						}
					]
				},
				{
					"type": "text",
					"value": ", which has better support in modern browsers (see "
				},
				{
