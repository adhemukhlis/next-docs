{
	"type": "root",
	"children": [
		{
			"type": "yaml",
			"value": "title: deploymentId\ndescription: Configure a deployment identifier used for version skew protection and cache busting."
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The "
				},
				{
					"type": "inlineCode",
					"value": "deploymentId"
				},
				{
					"type": "text",
					"value": " option allows you to set an identifier for your deployment. This identifier is used for "
				},
				{
					"type": "link",
					"title": null,
					"url": "../../../02-guides/self-hosting.md#version-skew",
					"children": [
						{
							"type": "text",
							"value": "version skew"
						}
					]
				},
				{
					"type": "text",
					"value": " protection and cache busting during rolling deployments."
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\"",
			"value": "module.exports = {\n\tdeploymentId: 'my-deployment-id',\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "You can also set the deployment ID using the "
				},
				{
					"type": "inlineCode",
					"value": "NEXT_DEPLOYMENT_ID"
				},
				{
					"type": "text",
					"value": " environment variable:"
				}
			]
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": null,
			"value": "NEXT_DEPLOYMENT_ID=my-deployment-id next build"
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know:"
								}
							]
						},
						{
							"type": "text",
							"value": " If both are set, the "
						},
						{
							"type": "inlineCode",
							"value": "deploymentId"
						},
						{
							"type": "text",
							"value": " value in "
						},
						{
							"type": "inlineCode",
							"value": "next.config.js"
						},
						{
							"type": "text",
							"value": " takes precedence over the "
						},
						{
							"type": "inlineCode",
							"value": "NEXT_DEPLOYMENT_ID"
						},
						{
							"type": "text",
							"value": " environment variable."
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "How it works"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "When a "
				},
				{
					"type": "inlineCode",
					"value": "deploymentId"
				},
				{
					"type": "text",
					"value": " is configured, Next.js:"
				}
			]
		},
		{
			"type": "list",
			"ordered": true,
			"start": 1,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Appends "
								},
								{
									"type": "inlineCode",
									"value": "?dpl=<deploymentId>"
								},
								{
									"type": "text",
									"value": " to static asset URLs (JavaScript, CSS, images)"
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Adds an "
								},
								{
									"type": "inlineCode",
									"value": "x-deployment-id"
								},
								{
									"type": "text",
									"value": " header to client-side navigation requests"
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Adds an "
								},
								{
									"type": "inlineCode",
									"value": "x-nextjs-deployment-id"
								},
								{
									"type": "text",
									"value": " header to navigation responses"
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Injects a "
								},
								{
									"type": "inlineCode",
									"value": "data-dpl-id"
								},
								{
									"type": "text",
									"value": " attribute on the "
								},
								{
									"type": "inlineCode",
									"value": "<html>"
								},
								{
									"type": "text",
									"value": " element"
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Includes the "
								},
								{
									"type": "inlineCode",
									"value": "deploymentId"
								},
								{
									"type": "text",
									"value": " in the "
								},
								{
									"type": "link",
									"title": null,
									"url": "../../01-directives/use-cache.md#cache-keys",
									"children": [
										{
											"type": "inlineCode",
											"value": "'use cache'"
										},
										{
											"type": "text",
											"value": " cache key"
										}
									]
								},
								{
									"type": "text",
									"value": ", invalidating cache entries when the deployment ID changes"
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "When the client detects a mismatch between its deployment ID and the server's (via the response header), it triggers a hard navigation (full page reload) instead of a client-side navigation. This ensures users always receive assets and Server Functions from a consistent deployment version."
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know:"
								}
							]
						},
						{
							"type": "text",
							"value": " Next.js does not read the "
						},
						{
							"type": "inlineCode",
							"value": "?dpl="
						},
						{
							"type": "text",
							"value": " query parameter on incoming requests. The query parameter is for cache busting (ensuring browsers and CDNs fetch fresh assets), not for routing. If you need version-aware routing, consult your hosting provider or CDN's documentation for implementing deployment-based routing."
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Use cases"
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Rolling deployments"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "During a rolling deployment, some server instances may be running the new version while others are still running the old version. Without a deployment ID, users might receive a mix of old and new assets, causing errors."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Setting a consistent "
				},
				{
					"type": "inlineCode",
					"value": "deploymentId"
				},
				{
					"type": "text",
					"value": " per deployment ensures:"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Clients always request assets from a matching deployment version"
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Mismatches trigger a full reload to fetch the correct assets"
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Server Functions work correctly across deployment boundaries"
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Multi-server environments"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "When running multiple instances of your Next.js application behind a load balancer, all instances for the same deployment should use the same "
				},
				{
					"type": "inlineCode",
					"value": "deploymentId"
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\"",
			"value": "module.exports = {\n\tdeploymentId: process.env.DEPLOYMENT_VERSION || process.env.GIT_SHA,\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "A per-deployment value only avoids skew if requests are also routed by deployment. Next.js does not route on "
				},
				{
					"type": "inlineCode",
					"value": "?dpl="
				},
				{
					"type": "text",
					"value": ", so that routing comes from your host or CDN. Without it, clients that reach an instance from another deployment during a rollout will reload rather than navigate."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Version History"
				}
			]
		},
		{
			"type": "table",
			"align": [
				null,
				null
			],
			"children": [
				{
					"type": "tableRow",
					"children": [
						{
							"type": "tableCell",
							"children": [
								{
									"type": "text",
									"value": "Version"
								}
							]
						},
						{
							"type": "tableCell",
							"children": [
								{
									"type": "text",
									"value": "Changes"
								}
							]
						}
					]
				},
				{
					"type": "tableRow",
					"children": [
						{
							"type": "tableCell",
							"children": [
								{
									"type": "inlineCode",
									"value": "v16.2.0"
								}
							]
						},
						{
							"type": "tableCell",
							"children": [
								{
									"type": "text",
									"value": "Pages Router detects version skew from the response header rather than the build ID, and the build ID is constant when "
								},
								{
									"type": "inlineCode",
									"value": "deploymentId"
								},
								{
									"type": "text",
									"value": " is set."
								}
							]
						}
					]
				},
				{
					"type": "tableRow",
					"children": [
						{
							"type": "tableCell",
							"children": [
								{
									"type": "inlineCode",
									"value": "v14.1.4"
								}
							]
						},
						{
							"type": "tableCell",
							"children": [
								{
									"type": "inlineCode",
									"value": "deploymentId"
								},
								{
									"type": "text",
									"value": " stabilized as top-level config option."
								}
							]
						}
					]
				},
				{
					"type": "tableRow",
					"children": [
						{
							"type": "tableCell",
							"children": [
								{
									"type": "inlineCode",
									"value": "v13.4.10"
								}
							]
						},
						{
							"type": "tableCell",
							"children": [
								{
									"type": "inlineCode",
									"value": "experimental.deploymentId"
								},
								{
									"type": "text",
									"value": " introduced."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Related"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
