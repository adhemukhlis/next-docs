			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\"",
			"value": "module.exports = {\n\trewrites() {\n\t\treturn [\n\t\t\t{\n\t\t\t\tsource: '/docs/:path*',\n\t\t\t\tdestination: '/:path*', // The :path parameter is used here so will not be automatically passed in the query\n\t\t\t},\n\t\t]\n\t},\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "You can still pass the parameters manually in the query if one is already used in the destination by specifying the query in the "
