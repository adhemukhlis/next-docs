		{
			"type": "yaml",
			"value": "title: rewrites\ndescription: Add rewrites to your Next.js app."
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Rewrites allow you to map an incoming request path to a different destination path."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Rewrites act as a URL proxy and mask the destination path, making it appear the user hasn't changed their location on the site. In contrast, "
				},
				{
					"type": "link",
					"title": null,
					"url": "./redirects.md",
					"children": [
						{
							"type": "text",
							"value": "redirects"
						}
					]
				},
				{
					"type": "text",
					"value": " will reroute to a new page and show the URL changes."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To use rewrites you can use the "
				},
				{
					"type": "inlineCode",
					"value": "rewrites"
				},
				{
					"type": "text",
					"value": " key in "
				},
				{
					"type": "inlineCode",
					"value": "next.config.js"
				},
				{
					"type": "text",
					"value": ":"
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\"",
			"value": "module.exports = {\n\trewrites() {\n\t\treturn [\n\t\t\t{\n\t\t\t\tsource: '/about',\n\t\t\t\tdestination: '/',\n\t\t\t},\n\t\t]\n\t},\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Rewrites are applied to client-side routing. In the example above, navigating to "
				},
				{
					"type": "inlineCode",
					"value": "<Link href=\"/about\">"
				},
				{
					"type": "text",
					"value": " will serve content from "
				},
				{
					"type": "inlineCode",
					"value": "/"
				},
				{
					"type": "text",
					"value": " while keeping the URL as "
				},
				{
					"type": "inlineCode",
					"value": "/about"
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
