		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\"",
			"value": "module.exports = {\n\trewrites() {\n\t\treturn [\n\t\t\t{\n\t\t\t\tsource: '/old-about/:path*',\n\t\t\t\tdestination: '/about', // The :path parameter isn't used here so will be automatically passed in the query\n\t\t\t},\n\t\t]\n\t},\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "If a parameter is used in the destination none of the parameters will be automatically passed in the query."
