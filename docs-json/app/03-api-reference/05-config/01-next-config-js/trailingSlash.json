{
	"type": "root",
	"children": [
		{
			"type": "yaml",
			"value": "title: trailingSlash\ndescription: Configure Next.js pages to resolve with or without a trailing slash."
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "By default Next.js will redirect URLs with trailing slashes to their counterpart without a trailing slash. For example "
				},
				{
					"type": "inlineCode",
					"value": "/about/"
				},
				{
					"type": "text",
					"value": " will redirect to "
				},
				{
					"type": "inlineCode",
					"value": "/about"
				},
				{
					"type": "text",
					"value": ". You can configure this behavior to act the opposite way, where URLs without trailing slashes are redirected to their counterparts with trailing slashes."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Open "
				},
				{
					"type": "inlineCode",
					"value": "next.config.js"
				},
				{
					"type": "text",
					"value": " and add the "
				},
				{
					"type": "inlineCode",
					"value": "trailingSlash"
				},
				{
					"type": "text",
					"value": " config:"
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\"",
			"value": "module.exports = {\n\ttrailingSlash: true,\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "With this option set, URLs like "
				},
				{
					"type": "inlineCode",
					"value": "/about"
				},
				{
					"type": "text",
					"value": " will redirect to "
				},
				{
					"type": "inlineCode",
					"value": "/about/"
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "When using "
				},
				{
					"type": "inlineCode",
					"value": "trailingSlash: true"
				},
				{
					"type": "text",
					"value": ", certain URLs are exceptions and will not have a trailing slash appended:"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Static file URLs, such as files with extensions."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Any paths under "
								},
								{
									"type": "inlineCode",
									"value": ".well-known/"
								},
								{
									"type": "text",
									"value": "."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "For example, the following URLs will remain unchanged: "
				},
				{
					"type": "inlineCode",
					"value": "/file.txt"
				},
				{
					"type": "text",
					"value": ", "
				},
				{
					"type": "inlineCode",
					"value": "images/photos/picture.png"
				},
				{
					"type": "text",
					"value": ", and "
				},
				{
					"type": "inlineCode",
					"value": ".well-known/subfolder/config.json"
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "When used with "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/guides/static-exports",
					"children": [
						{
							"type": "inlineCode",
							"value": "output: \"export\""
						}
					]
				},
				{
					"type": "text",
					"value": " configuration, the "
				},
				{
