					"value": "/about"
				},
				{
					"type": "text",
					"value": " page will output "
				},
				{
					"type": "inlineCode",
					"value": "/about/index.html"
				},
				{
					"type": "text",
					"value": " (instead of the default "
				},
				{
					"type": "inlineCode",
					"value": "/about.html"
				},
				{
					"type": "text",
					"value": ")."
				}
			]
		},
