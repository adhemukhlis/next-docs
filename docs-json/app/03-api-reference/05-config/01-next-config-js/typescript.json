									"value": "false"
								}
							]
						},
						{
							"type": "tableCell",
							"children": [
								{
									"type": "text",
									"value": "Allow production builds to complete even with TypeScript errors."
								}
							]
						}
					]
				},
				{
					"type": "tableRow",
					"children": [
						{
							"type": "tableCell",
							"children": [
								{
									"type": "inlineCode",
									"value": "tsconfigPath"
								}
							]
						},
						{
							"type": "tableCell",
							"children": [
								{
									"type": "inlineCode",
									"value": "string"
								}
							]
						},
						{
							"type": "tableCell",
							"children": [
								{
									"type": "inlineCode",
									"value": "'tsconfig.json'"
								}
							]
						},
						{
							"type": "tableCell",
							"children": [
								{
									"type": "text",
									"value": "Path to a custom "
								},
								{
									"type": "inlineCode",
									"value": "tsconfig.json"
								},
								{
									"type": "text",
									"value": " file."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "inlineCode",
					"value": "ignoreBuildErrors"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Next.js fails your "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "production build"
						}
					]
				},
				{
					"type": "text",
					"value": " ("
				},
				{
					"type": "inlineCode",
					"value": "next build"
				},
				{
					"type": "text",
					"value": ") when TypeScript errors are present in your project."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "If you'd like Next.js to dangerously produce production code even when your application has errors, you can disable the built-in type checking step."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Note that this completely skips the TypeScript type checking step. It does not run TypeScript and suppress errors, it bypasses the check entirely."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "If disabled, be sure you are running type checks as part of your build or deploy process, otherwise this can be very dangerous."
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\"",
			"value": "module.exports = {\n\ttypescript: {\n\t\t// !! WARN !!\n\t\t// Dangerously allow production builds to successfully complete even if\n\t\t// your project has type errors.\n\t\t// !! WARN !!\n\t\tignoreBuildErrors: true,\n\t},\n}"
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "inlineCode",
					"value": "tsconfigPath"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Use a different TypeScript configuration file for builds or tooling:"
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\"",
			"value": "module.exports = {\n\ttypescript: {\n\t\ttsconfigPath: 'tsconfig.build.json',\n\t},\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "See the "
				},
				{
