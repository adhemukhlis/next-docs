		{
			"type": "yaml",
			"value": "title: typescript\ndescription: Configure how Next.js handles TypeScript errors during production builds and specify a custom tsconfig file."
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Configure TypeScript behavior with the "
				},
				{
					"type": "inlineCode",
					"value": "typescript"
				},
				{
					"type": "text",
					"value": " option in "
				},
				{
					"type": "inlineCode",
					"value": "next.config.js"
				},
				{
					"type": "text",
					"value": ":"
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\"",
			"value": "module.exports = {\n\ttypescript: {\n\t\tignoreBuildErrors: false,\n\t\ttsconfigPath: 'tsconfig.json',\n\t},\n}"
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Options"
				}
			]
		},
