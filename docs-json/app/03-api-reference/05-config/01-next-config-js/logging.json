{
	"type": "root",
	"children": [
		{
			"type": "yaml",
			"value": "title: logging\ndescription: Configure logging behavior in the terminal when running Next.js in development mode, including fetch logging, incoming requests, and forwarding browser console logs to the terminal."
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Options"
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Fetching"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "You can configure the logging level and whether the full URL is logged to the console when running Next.js in development mode."
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\"",
			"value": "module.exports = {\n\tlogging: {\n\t\tfetches: {\n\t\t\tfullUrl: true,\n\t\t},\n\t},\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Any "
				},
				{
					"type": "inlineCode",
					"value": "fetch"
				},
				{
					"type": "text",
					"value": " requests that are restored from the "
				},
				{
					"type": "link",
					"title": null,
					"url": "./serverComponentsHmrCache.md",
					"children": [
						{
							"type": "text",
							"value": "Server Components HMR cache"
						}
					]
				},
				{
					"type": "text",
					"value": " are not logged by default. However, this can be enabled by setting "
				},
				{
					"type": "inlineCode",
					"value": "logging.fetches.hmrRefreshes"
				},
				{
					"type": "text",
					"value": " to "
				},
				{
					"type": "inlineCode",
					"value": "true"
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\"",
			"value": "module.exports = {\n\tlogging: {\n\t\tfetches: {\n\t\t\thmrRefreshes: true,\n\t\t},\n\t},\n}"
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Server Functions"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "link",
					"title": null,
					"url": "https://react.dev/reference/rsc/server-functions",
					"children": [
						{
							"type": "text",
							"value": "Server Function"
						}
					]
				},
				{
					"type": "text",
					"value": " invocations are logged by default during development. You can disable this by setting "
				},
				{
					"type": "inlineCode",
					"value": "logging.serverFunctions"
				},
				{
					"type": "text",
					"value": " to "
				},
				{
					"type": "inlineCode",
					"value": "false"
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\"",
			"value": "module.exports = {\n\tlogging: {\n\t\tserverFunctions: false,\n\t},\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "When enabled, the terminal displays each Server Function call with its function name, arguments, and duration:"
				}
			]
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "filename=\"Terminal\"",
			"value": "POST /\n  └─ ƒ myAction(arg1, arg2) in 5ms app/actions.ts"
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Incoming Requests"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "By default all the incoming requests will be logged in the console during development. You can use the "
				},
				{
					"type": "inlineCode",
					"value": "incomingRequests"
				},
				{
					"type": "text",
					"value": " option to decide which requests to ignore. Since this is only logged in development, this option doesn't affect production builds."
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\"",
			"value": "module.exports = {\n\tlogging: {\n\t\tincomingRequests: {\n\t\t\tignore: [/\\/api\\/v1\\/health/],\n\t\t},\n\t},\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Or you can disable incoming request logging by setting "
				},
				{
					"type": "inlineCode",
					"value": "incomingRequests"
				},
				{
					"type": "text",
					"value": " to "
				},
				{
					"type": "inlineCode",
					"value": "false"
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\"",
			"value": "module.exports = {\n\tlogging: {\n\t\tincomingRequests: false,\n\t},\n}"
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Browser Console Logs"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "You can forward browser console logs (such as "
				},
				{
					"type": "inlineCode",
					"value": "console.log"
				},
				{
					"type": "text",
					"value": ", "
				},
				{
					"type": "inlineCode",
					"value": "console.warn"
				},
				{
					"type": "text",
					"value": ", "
				},
				{
					"type": "inlineCode",
					"value": "console.error"
				},
				{
					"type": "text",
					"value": ") to the terminal during development. This is useful for debugging client-side code without needing to check the browser's developer tools."
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\"",
			"value": "module.exports = {\n\tlogging: {\n\t\tbrowserToTerminal: true,\n\t},\n}"
		},
		{
			"type": "heading",
			"depth": 4,
			"children": [
				{
					"type": "text",
					"value": "Options"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The "
				},
				{
					"type": "inlineCode",
					"value": "browserToTerminal"
				},
				{
					"type": "text",
					"value": " option accepts the following values:"
				}
			]
		},
		{
			"type": "table",
			"align": [
				null,
				null
			],
			"children": [
				{
					"type": "tableRow",
					"children": [
						{
							"type": "tableCell",
							"children": [
								{
									"type": "text",
									"value": "Value"
								}
							]
						},
						{
							"type": "tableCell",
							"children": [
								{
									"type": "text",
									"value": "Description"
								}
							]
						}
					]
				},
				{
					"type": "tableRow",
					"children": [
						{
							"type": "tableCell",
							"children": [
								{
									"type": "inlineCode",
									"value": "'warn'"
								}
							]
						},
						{
							"type": "tableCell",
							"children": [
								{
									"type": "text",
									"value": "Forward only warnings and errors, by default"
								}
							]
						}
					]
				},
				{
					"type": "tableRow",
					"children": [
						{
							"type": "tableCell",
							"children": [
								{
									"type": "inlineCode",
									"value": "'error'"
								}
							]
						},
						{
							"type": "tableCell",
							"children": [
								{
									"type": "text",
									"value": "Forward only errors"
								}
							]
						}
					]
				},
				{
					"type": "tableRow",
					"children": [
						{
							"type": "tableCell",
							"children": [
								{
									"type": "inlineCode",
									"value": "true"
								}
							]
						},
						{
							"type": "tableCell",
							"children": [
								{
									"type": "text",
									"value": "Forward all console output (log, info, warn, error)"
								}
							]
						}
					]
				},
				{
					"type": "tableRow",
					"children": [
						{
							"type": "tableCell",
							"children": [
								{
									"type": "inlineCode",
									"value": "false"
								}
							]
						},
						{
							"type": "tableCell",
							"children": [
								{
									"type": "text",
									"value": "Disable browser log forwarding"
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\"",
			"value": "module.exports = {\n\tlogging: {\n\t\tbrowserToTerminal: 'warn',\n\t},\n}"
		},
		{
			"type": "heading",
			"depth": 4,
			"children": [
				{
					"type": "text",
					"value": "Source Location"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "When enabled, browser logs include source location information (file path and line number) by default. For example:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/page.tsx\" highlight={8}",
			"value": "'use client'\n\nexport default function Home() {\n\treturn (\n\t\t<button\n\t\t\ttype=\"button\"\n\t\t\tonClick={() => {\n\t\t\t\tconsole.log('Hello World')\n\t\t\t}}>\n\t\t\tClick me\n\t\t</button>\n\t)\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Clicking the button prints this message to the terminal:"
				}
			]
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "filename=\"Terminal\"",
			"value": "[browser] Hello World (app/page.tsx:8:17)"
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Disabling Logging"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "In addition, you can disable the development logging by setting "
				},
				{
					"type": "inlineCode",
					"value": "logging"
				},
				{
					"type": "text",
					"value": " to "
				},
				{
					"type": "inlineCode",
					"value": "false"
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\"",
			"value": "module.exports = {\n\tlogging: false,\n}"
		},
