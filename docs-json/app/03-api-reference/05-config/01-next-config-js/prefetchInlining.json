							"children": [
								{
									"type": "text",
									"value": "Default"
								}
							]
						},
						{
							"type": "tableCell",
							"children": [
								{
									"type": "text",
									"value": "Description"
								}
							]
						}
					]
				},
				{
					"type": "tableRow",
					"children": [
						{
							"type": "tableCell",
							"children": [
								{
									"type": "inlineCode",
									"value": "maxSize"
								}
							]
						},
						{
							"type": "tableCell",
							"children": [
								{
									"type": "inlineCode",
									"value": "number"
								}
							]
						},
						{
							"type": "tableCell",
							"children": [
								{
									"type": "inlineCode",
									"value": "2048"
								}
							]
						},
						{
							"type": "tableCell",
							"children": [
								{
									"type": "text",
									"value": "Largest a single segment response can be to still be eligible for inlining."
								}
							]
						}
					]
				},
				{
					"type": "tableRow",
					"children": [
						{
							"type": "tableCell",
							"children": [
								{
									"type": "inlineCode",
									"value": "maxBundleSize"
								}
							]
						},
						{
							"type": "tableCell",
							"children": [
								{
									"type": "inlineCode",
									"value": "number"
								}
							]
						},
						{
							"type": "tableCell",
							"children": [
								{
									"type": "inlineCode",
									"value": "10240"
								}
							]
						},
						{
							"type": "tableCell",
							"children": [
								{
									"type": "text",
									"value": "Largest total size that can be inlined into one bundled prefetch response along a path."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Lower thresholds keep more per-segment deduplication; higher thresholds inline more data and cut request count further."
				}
			]
		},
