			"value": "title: turbopackRustReactCompiler\ndescription: Use the native Rust port of the React Compiler with Turbopack instead of the Babel transform.\nversion: experimental"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The "
				},
				{
					"type": "inlineCode",
					"value": "experimental.turbopackRustReactCompiler"
				},
				{
					"type": "text",
					"value": " option enables the native Rust version of the "
				},
				{
					"type": "link",
					"title": null,
					"url": "./reactCompiler.md",
					"children": [
						{
							"type": "text",
							"value": "React Compiler"
						}
					]
				},
				{
					"type": "text",
					"value": ", running it directly inside Turbopack as native code instead of through Node.js as it does with the standard Babel version. This typically results in a noticeable performance improvement."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "This option is released as experimental to gather feedback before it becomes the default."
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": "filename=\"next.config.ts\" switcher",
			"value": "import type { NextConfig } from 'next'\n\nconst nextConfig: NextConfig = {\n\t// Enable the React Compiler\n\treactCompiler: true,\n\texperimental: {\n\t\t// Use the Rust port instead of the Babel transform\n\t\tturbopackRustReactCompiler: true,\n\t},\n}\n\nexport default nextConfig"
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\" switcher",
			"value": "/** @type {import('next').NextConfig} */\nconst nextConfig = {\n\t// Enable the React Compiler\n\treactCompiler: true,\n\texperimental: {\n\t\t// Use the Rust port instead of the Babel transform\n\t\tturbopackRustReactCompiler: true,\n\t},\n}\n\nmodule.exports = nextConfig"
		},
