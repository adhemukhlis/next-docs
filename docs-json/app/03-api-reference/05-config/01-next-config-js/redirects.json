					"type": "text",
					"value": "Wildcard Path Matching"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To match a wildcard path you can use "
				},
				{
					"type": "inlineCode",
