				},
				{
					"type": "text",
					"value": ", "
				},
				{
					"type": "inlineCode",
					"value": "/blog/a"
				},
				{
					"type": "text",
					"value": ", and "
				},
				{
					"type": "inlineCode",
					"value": "/blog/a/b/c"
				},
