		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Why does Next.js use 307 and 308?"
								}
							]
						},
						{
							"type": "text",
							"value": " Traditionally a 302 was used for a temporary redirect, and a 301 for a permanent redirect, but many browsers changed the request method of the redirect to "
						},
						{
							"type": "inlineCode",
							"value": "GET"
						},
						{
							"type": "text",
							"value": ", regardless of the original method. For example, if the browser made a request to "
						},
						{
							"type": "inlineCode",
							"value": "POST /v1/users"
						},
						{
							"type": "text",
							"value": " which returned status code "
						},
						{
							"type": "inlineCode",
							"value": "302"
						},
						{
							"type": "text",
							"value": " with location "
						},
						{
							"type": "inlineCode",
							"value": "/v2/users"
						},
						{
							"type": "text",
							"value": ", the subsequent request might be "
						},
						{
							"type": "inlineCode",
							"value": "GET /v2/users"
						},
						{
							"type": "text",
							"value": " instead of the expected "
						},
						{
							"type": "inlineCode",
							"value": "POST /v2/users"
						},
						{
							"type": "text",
							"value": ". Next.js uses the 307 temporary redirect, and 308 permanent redirect status codes to explicitly preserve the request method used."
						}
					]
				}
			]
		},
