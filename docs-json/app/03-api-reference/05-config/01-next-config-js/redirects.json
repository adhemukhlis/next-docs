			"value": "module.exports = {\n\tredirects() {\n\t\treturn [\n\t\t\t{\n\t\t\t\tsource: '/blog/:slug*',\n\t\t\t\tdestination: '/news/:slug*', // Matched parameters can be used in the destination\n\t\t\t\tpermanent: true,\n\t\t\t},\n\t\t]\n\t},\n}"
