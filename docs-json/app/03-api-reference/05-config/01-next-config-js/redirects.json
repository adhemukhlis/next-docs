		{
			"type": "code",
			"lang": "js",
			"meta": null,
			"value": "{\n  source: '/old-blog/:path*',\n  destination: '/blog/:path*',\n  permanent: false\n}"
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know"
								}
							]
						},
						{
							"type": "text",
							"value": ": Remember to include the forward slash "
						},
						{
							"type": "inlineCode",
							"value": "/"
						},
						{
							"type": "text",
							"value": " before the colon "
						},
						{
							"type": "inlineCode",
							"value": ":"
						},
						{
							"type": "text",
							"value": " in path parameters of the "
						},
						{
							"type": "inlineCode",
							"value": "source"
						},
						{
							"type": "text",
							"value": " and "
						},
						{
							"type": "inlineCode",
							"value": "destination"
						},
						{
							"type": "text",
							"value": " paths, otherwise the path will be treated as a literal string and you run the risk of causing infinite redirects."
						}
