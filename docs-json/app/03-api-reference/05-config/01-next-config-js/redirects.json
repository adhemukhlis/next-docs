			"meta": "filename=\"next.config.js\"",
			"value": "module.exports = {\n\tredirects() {\n\t\treturn [\n\t\t\t{\n\t\t\t\tsource: '/about',\n\t\t\t\tdestination: '/',\n\t\t\t\tpermanent: true,\n\t\t\t},\n\t\t]\n\t},\n}"
		},
