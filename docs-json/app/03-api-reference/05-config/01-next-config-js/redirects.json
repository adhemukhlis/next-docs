		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Path Matching"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Path matches are allowed, for example "
				},
				{
					"type": "inlineCode",
					"value": "/old-blog/:slug"
				},
				{
					"type": "text",
					"value": " will match "
				},
				{
					"type": "inlineCode",
					"value": "/old-blog/first-post"
				},
				{
					"type": "text",
					"value": " (no nested paths):"
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\"",
			"value": "module.exports = {\n\tredirects() {\n\t\treturn [\n\t\t\t{\n\t\t\t\tsource: '/old-blog/:slug',\n\t\t\t\tdestination: '/news/:slug', // Matched parameters can be used in the destination\n\t\t\t\tpermanent: true,\n\t\t\t},\n\t\t]\n\t},\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The pattern "
				},
				{
					"type": "inlineCode",
					"value": "/old-blog/:slug"
				},
				{
					"type": "text",
					"value": " matches "
				},
				{
					"type": "inlineCode",
					"value": "/old-blog/first-post"
				},
				{
					"type": "text",
					"value": " and "
				},
				{
					"type": "inlineCode",
					"value": "/old-blog/post-1"
				},
				{
					"type": "text",
					"value": " but not "
				},
				{
					"type": "inlineCode",
					"value": "/old-blog/a/b"
				},
				{
					"type": "text",
					"value": " (no nested paths). Patterns are anchored to the start: "
				},
				{
					"type": "inlineCode",
					"value": "/old-blog/:slug"
				},
				{
					"type": "text",
					"value": " will not match "
				},
				{
					"type": "inlineCode",
					"value": "/archive/old-blog/first-post"
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "You can use modifiers on parameters: "
				},
				{
					"type": "inlineCode",
					"value": "*"
				},
				{
					"type": "text",
					"value": " (zero or more), "
				},
				{
					"type": "inlineCode",
					"value": "+"
				},
				{
					"type": "text",
					"value": " (one or more), "
				},
				{
					"type": "inlineCode",
					"value": "?"
				},
				{
					"type": "text",
					"value": " (zero or one). For example, "
				},
				{
					"type": "inlineCode",
