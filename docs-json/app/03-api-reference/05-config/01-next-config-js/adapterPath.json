{
	"type": "root",
	"children": [
		{
			"type": "yaml",
			"value": "title: adapterPath\ndescription: Configure a custom adapter for Next.js to hook into the build process."
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Next.js provides a built-in adapters API. It allows deployment platforms or build systems to integrate with the Next.js build process."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "For a full reference implementation, see the "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://github.com/nextjs/adapter-vercel",
					"children": [
						{
							"type": "inlineCode",
							"value": "nextjs/adapter-vercel"
						}
					]
				},
				{
					"type": "text",
					"value": " adapter."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Configuration"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To use an adapter, specify the path to your adapter module in "
				},
				{
					"type": "inlineCode",
					"value": "adapterPath"
				},
				{
					"type": "text",
					"value": ":"
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\"",
			"value": "/** @type {import('next').NextConfig} */\nconst nextConfig = {\n\tadapterPath: require.resolve('./my-adapter.js'),\n}\n\nmodule.exports = nextConfig"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Alternatively "
				},
				{
					"type": "inlineCode",
					"value": "NEXT_ADAPTER_PATH"
				},
				{
					"type": "text",
					"value": " can be set to enable zero-config usage in deployment platforms."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Adapters"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "For full adapter implementation details, use the dedicated Adapters section:"
