									"type": "inlineCode",
									"value": "experimental.reactCompiler"
								},
								{
									"type": "text",
									"value": " to the top-level "
								},
								{
									"type": "inlineCode",
									"value": "reactCompiler"
								},
								{
									"type": "text",
									"value": " option."
								}
							]
						}
					]
				}
			]
		}
	]
