		{
			"type": "paragraph",
			"children": [
				{
					"type": "inlineCode",
					"value": "create-next-app"
				},
				{
					"type": "text",
					"value": " scaffolds a Next.js application from the default template into a new directory: it generates the project files, applies the selected options (router, language, source layout, import alias, bundler, styling, linter), and installs the dependencies."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Basic usage:"
				}
			]
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"pnpm\"",
			"value": "pnpm create next-app [project-name] [options]"
		},
