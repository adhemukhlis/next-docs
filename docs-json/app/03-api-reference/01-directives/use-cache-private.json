		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Private Cache Functions contribute their "
				},
				{
					"type": "inlineCode",
					"value": "stale"
				},
				{
					"type": "text",
					"value": " time to the route's "
				},
				{
					"type": "link",
					"title": null,
					"url": "../../04-glossary.md#client-cache",
					"children": [
						{
							"type": "text",
							"value": "Client Cache"
						}
					]
				},
				{
					"type": "text",
					"value": ". If a function only needs request-scoped deduplication, use "
				},
				{
					"type": "inlineCode",
					"value": "cacheLife({ stale: Infinity })"
				},
				{
					"type": "text",
					"value": " to keep it from lowering the route's stale time."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Next.js uses the shortest stale time from the route's cache entries, so another cache or route setting can still set a finite value. Setting "
				},
				{
					"type": "inlineCode",
					"value": "stale"
				},
				{
					"type": "text",
					"value": " to "
				},
				{
					"type": "inlineCode",
					"value": "Infinity"
				},
				{
					"type": "text",
					"value": " does not store the private result on the server across production requests. Use a finite value when the client router should revalidate personalized output after a known interval."
				}
			]
		},
