	"children": [
		{
			"type": "yaml",
			"value": "title: Dynamic Route Segments\nnav_title: Dynamic Segments\ndescription: Use Dynamic Segments to read URL path params and generate routes from dynamic data."
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "A URL path is a sequence of path segments. In the App Router, a segment may be "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "static"
						}
					]
				},
				{
					"type": "text",
					"value": " (a literal value matched exactly) or "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "dynamic"
						}
					]
				},
				{
					"type": "text",
					"value": " (a placeholder that captures a value from the URL). When you don't know a segment's value ahead of time, define a Dynamic Segment to create routes from dynamic data. Next.js passes the captured values to your page via the path "
				},
				{
					"type": "inlineCode",
					"value": "params"
				},
				{
					"type": "text",
					"value": " prop, either filled in at request time or prerendered at build time."
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know"
								}
							]
						},
						{
							"type": "text",
							"value": ": Dynamic Segments are often referred to as path params, route params, or URL params."
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Convention"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "A Dynamic Segment can be created by wrapping a folder's name in square brackets: "
				},
				{
					"type": "inlineCode",
					"value": "[folderName]"
				},
				{
					"type": "text",
					"value": ". For example, a blog could include the following route "
				},
				{
					"type": "inlineCode",
					"value": "app/blog/[slug]/page.js"
				},
				{
					"type": "text",
					"value": " where "
				},
				{
					"type": "inlineCode",
					"value": "[slug]"
				},
				{
					"type": "text",
					"value": " is the Dynamic Segment for blog posts."
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/blog/[slug]/page.tsx\" switcher",
			"value": "export default async function Page({ params }: { params: Promise<{ slug: string }> }) {\n\tconst { slug } = await params\n\treturn <div>My Post: {slug}</div>\n}"
		},
