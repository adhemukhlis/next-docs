						}
					]
				},
				{
					"type": "text",
					"value": " documentation for a step-by-step example, or see our "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://github.com/nextjs/nextgram",
					"children": [
						{
							"type": "text",
							"value": "image gallery example"
						}
					]
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know:"
								}
							]
						}
					]
				},
				{
