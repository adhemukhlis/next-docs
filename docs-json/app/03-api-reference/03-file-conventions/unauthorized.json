				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Before streaming starts, Next.js returns a "
				},
				{
					"type": "inlineCode",
					"value": "401"
				},
				{
					"type": "text",
					"value": " status code. After streaming starts, the status code remains "
				},
				{
					"type": "inlineCode",
					"value": "200"
				},
				{
					"type": "text",
					"value": " and the unauthorized UI renders in the response. Next.js injects a "
				},
				{
					"type": "inlineCode",
					"value": "<meta name=\"robots\" content=\"noindex\" />"
				},
				{
					"type": "text",
					"value": " tag in both cases. See "
				},
				{
					"type": "link",
					"title": null,
					"url": "./loading.md#status-codes",
					"children": [
						{
							"type": "text",
							"value": "Status codes"
						}
					]
				},
				{
					"type": "text",
					"value": " for details."
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/unauthorized.tsx\" switcher",
			"value": "import Login from '@/app/components/Login'\n\nexport default function Unauthorized() {\n\treturn (\n\t\t<main>\n\t\t\t<h1>401 - Unauthorized</h1>\n\t\t\t<p>Please log in to access this page.</p>\n\t\t\t<Login />\n\t\t</main>\n\t)\n}"
		},
