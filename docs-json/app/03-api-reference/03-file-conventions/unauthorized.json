			"value": "title: unauthorized.js\ndescription: API reference for the unauthorized.js special file.\nversion: experimental"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "unauthorized"
						}
					]
				},
				{
					"type": "text",
					"value": " file renders UI when the "
				},
				{
					"type": "link",
