									"type": "inlineCode",
									"value": "sitemap.(xml|js|ts)"
								},
								{
									"type": "text",
									"value": " inside multiple route segments e.g. "
								},
								{
									"type": "inlineCode",
									"value": "app/sitemap.xml"
								},
								{
									"type": "text",
									"value": " and "
								},
								{
									"type": "inlineCode",
									"value": "app/products/sitemap.xml"
								},
								{
									"type": "text",
									"value": "."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "By using the "
								},
								{
									"type": "link",
									"title": null,
									"url": "../../04-functions/generate-sitemaps.md",
									"children": [
										{
											"type": "inlineCode",
											"value": "generateSitemaps"
										}
									]
								},
								{
									"type": "text",
									"value": " function."
