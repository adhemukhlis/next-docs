		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "For example, to split a sitemap using "
				},
				{
					"type": "inlineCode",
					"value": "generateSitemaps"
				},
				{
					"type": "text",
					"value": ", return an array of objects with the sitemap "
				},
				{
					"type": "inlineCode",
					"value": "id"
				},
				{
					"type": "text",
					"value": ". Then, use the "
				},
				{
					"type": "inlineCode",
					"value": "id"
				},
				{
					"type": "text",
					"value": " to generate the unique sitemaps."
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": "filename=\"app/product/sitemap.ts\" switcher",
			"value": "import type { MetadataRoute } from 'next'\nimport { BASE_URL } from '@/app/lib/constants'\n\nexport async function generateSitemaps() {\n\t// Fetch the total number of products and calculate the number of sitemaps needed\n\treturn [{ id: 0 }, { id: 1 }, { id: 2 }, { id: 3 }]\n}\n\nexport default async function sitemap(props: { id: Promise<string> }): Promise<MetadataRoute.Sitemap> {\n\tconst id = await props.id\n\t// Google's limit is 50,000 URLs per sitemap\n\tconst start = id * 50000\n\tconst end = start + 50000\n\tconst products = await getProducts(`SELECT id, date FROM products WHERE id BETWEEN ${start} AND ${end}`)\n\treturn products.map((product) => ({\n\t\turl: `${BASE_URL}/product/${product.id}`,\n\t\tlastModified: product.date,\n\t}))\n}"
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"app/product/sitemap.js\" switcher",
			"value": "import { BASE_URL } from '@/app/lib/constants'\n\nexport async function generateSitemaps() {\n\t// Fetch the total number of products and calculate the number of sitemaps needed\n\treturn [{ id: 0 }, { id: 1 }, { id: 2 }, { id: 3 }]\n}\n\nexport default async function sitemap(props) {\n\tconst id = await props.id\n\t// Google's limit is 50,000 URLs per sitemap\n\tconst start = id * 50000\n\tconst end = start + 50000\n\tconst products = await getProducts(`SELECT id, date FROM products WHERE id BETWEEN ${start} AND ${end}`)\n\treturn products.map((product) => ({\n\t\turl: `${BASE_URL}/product/${product.id}`,\n\t\tlastModified: product.date,\n\t}))\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Your generated sitemaps will be available at "
