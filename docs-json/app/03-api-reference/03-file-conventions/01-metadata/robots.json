				{
					"type": "inlineCode",
					"value": "rules"
				},
				{
					"type": "text",
					"value": " property. For example:"
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": "filename=\"app/robots.ts\" switcher",
			"value": "import type { MetadataRoute } from 'next'\n\nexport default function robots(): MetadataRoute.Robots {\n\treturn {\n\t\trules: [\n\t\t\t{\n\t\t\t\tuserAgent: 'Googlebot',\n\t\t\t\tallow: ['/'],\n\t\t\t\tdisallow: '/private/',\n\t\t\t},\n\t\t\t{\n\t\t\t\tuserAgent: ['Applebot', 'Bingbot'],\n\t\t\t\tdisallow: ['/'],\n\t\t\t},\n\t\t],\n\t\tsitemap: 'https://acme.com/sitemap.xml',\n\t}\n}"
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"app/robots.js\" switcher",
			"value": "export default function robots() {\n\treturn {\n\t\trules: [\n\t\t\t{\n\t\t\t\tuserAgent: 'Googlebot',\n\t\t\t\tallow: ['/'],\n\t\t\t\tdisallow: ['/private/'],\n\t\t\t},\n\t\t\t{\n\t\t\t\tuserAgent: ['Applebot', 'Bingbot'],\n\t\t\t\tdisallow: ['/'],\n\t\t\t},\n\t\t],\n\t\tsitemap: 'https://acme.com/sitemap.xml',\n\t}\n}"
		},
