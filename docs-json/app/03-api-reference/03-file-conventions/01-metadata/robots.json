			"value": "import type { MetadataRoute } from 'next'\n\nexport default function robots(): MetadataRoute.Robots {\n\treturn {\n\t\trules: [\n\t\t\t{ userAgent: '*', allow: '/' },\n\t\t\t{\n\t\t\t\tuserAgent: 'SeznamBot',\n\t\t\t\tallow: '/',\n\t\t\t\tother: {\n\t\t\t\t\t'Request-Rate': '10/1m',\n\t\t\t\t},\n\t\t\t},\n\t\t],\n\t}\n}"
