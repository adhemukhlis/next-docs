			"meta": "filename=\"app/layout.js\" switcher",
			"value": "'use client'\n\nimport { useSelectedLayoutSegment } from 'next/navigation'\n\nexport default function Layout({ auth }) {\n\tconst loginSegment = useSelectedLayoutSegment('auth')\n\t// ...\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "When a user navigates to "
