{
	"type": "root",
	"children": [
		{
			"type": "yaml",
			"value": "title: Parallel Routes\ndescription: Simultaneously render one or more pages in the same view that can be navigated independently. A pattern for highly dynamic applications.\nrelated:\n links:\n  - app/api-reference/file-conventions/default\n  - app/guides/authentication"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Parallel Routes allows you to simultaneously or conditionally render one or more pages within the same layout. They are useful for highly dynamic sections of an app, such as dashboards and feeds on social sites."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "For example, considering a dashboard, you can use parallel routes to simultaneously render the "
				},
				{
					"type": "inlineCode",
					"value": "team"
				},
				{
					"type": "text",
					"value": " and "
				},
				{
					"type": "inlineCode",
					"value": "analytics"
				},
				{
					"type": "text",
					"value": " pages:"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "html",
					"value": "<Image\nalt=\"Parallel Routes Diagram\"\nsrcLight=\"/docs/light/parallel-routes.png\"\nsrcDark=\"/docs/dark/parallel-routes.png\"\nwidth=\"1600\"\nheight=\"942\"\n/>"
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Convention"
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Slots"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Parallel routes are created using named "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "slots"
						}
					]
				},
				{
					"type": "text",
					"value": ". Slots are defined with the "
				},
				{
					"type": "inlineCode",
					"value": "@folder"
				},
				{
					"type": "text",
					"value": " convention. For example, the following file structure defines two slots: "
				},
				{
					"type": "inlineCode",
					"value": "@analytics"
				},
				{
					"type": "text",
					"value": " and "
				},
				{
					"type": "inlineCode",
					"value": "@team"
				},
				{
					"type": "text",
					"value": ":"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "html",
					"value": "<Image\nalt=\"Parallel Routes File-system Structure\"\nsrcLight=\"/docs/light/parallel-routes-file-system.png\"\nsrcDark=\"/docs/dark/parallel-routes-file-system.png\"\nwidth=\"1600\"\nheight=\"687\"\n/>"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Slots are passed as props to the shared parent layout. For the example above, the component in "
				},
				{
					"type": "inlineCode",
					"value": "app/layout.js"
				},
				{
					"type": "text",
					"value": " now accepts the "
				},
				{
					"type": "inlineCode",
					"value": "@analytics"
				},
				{
					"type": "text",
					"value": " and "
				},
				{
					"type": "inlineCode",
					"value": "@team"
				},
				{
					"type": "text",
					"value": " slots props, and can render them in parallel alongside the "
				},
				{
					"type": "inlineCode",
					"value": "children"
				},
				{
					"type": "text",
					"value": " prop:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/layout.tsx\" switcher",
			"value": "export default function Layout({ children, team, analytics }: { children: React.ReactNode; analytics: React.ReactNode; team: React.ReactNode }) {\n\treturn (\n\t\t<>\n\t\t\t{children}\n\t\t\t{team}\n\t\t\t{analytics}\n\t\t</>\n\t)\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/layout.js\" switcher",
			"value": "export default function Layout({ children, team, analytics }) {\n\treturn (\n\t\t<>\n\t\t\t{children}\n\t\t\t{team}\n\t\t\t{analytics}\n\t\t</>\n\t)\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "However, slots are "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "not"
						}
					]
				},
				{
					"type": "text",
					"value": " route segments and do not affect the URL structure. For example, for "
				},
				{
					"type": "inlineCode",
					"value": "/@analytics/views"
				},
				{
					"type": "text",
					"value": ", the URL will be "
				},
				{
					"type": "inlineCode",
					"value": "/views"
				},
				{
					"type": "text",
					"value": " since "
				},
				{
					"type": "inlineCode",
					"value": "@analytics"
				},
				{
					"type": "text",
					"value": " is a slot. Slots are combined with the regular "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/api-reference/file-conventions/page",
					"children": [
						{
							"type": "text",
							"value": "Page"
						}
					]
				},
				{
					"type": "text",
					"value": " component to form the final page associated with the route segment. Because of this, you cannot have separate "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/glossary#prerendering",
					"children": [
						{
							"type": "text",
							"value": "prerendered"
						}
					]
				},
				{
					"type": "text",
					"value": " and "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/glossary#dynamic-rendering",
					"children": [
						{
							"type": "text",
							"value": "dynamically rendered"
						}
					]
				},
				{
					"type": "text",
					"value": " slots at the same route segment level. If one slot is dynamic, all slots at that level must be dynamic."
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know"
								}
							]
						},
						{
							"type": "text",
							"value": ":"
						}
					]
				},
				{
					"type": "list",
					"ordered": false,
					"start": null,
					"spread": false,
					"children": [
						{
							"type": "listItem",
							"spread": false,
							"checked": null,
							"children": [
								{
									"type": "paragraph",
									"children": [
										{
											"type": "text",
											"value": "The "
										},
										{
											"type": "inlineCode",
											"value": "children"
										},
										{
											"type": "text",
											"value": " prop is an implicit slot that does not need to be mapped to a folder. This means "
										},
										{
											"type": "inlineCode",
											"value": "app/page.js"
										},
										{
											"type": "text",
											"value": " is equivalent to "
										},
										{
											"type": "inlineCode",
											"value": "app/@children/page.js"
										},
										{
											"type": "text",
											"value": "."
										}
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "inlineCode",
					"value": "default.js"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "You can define a "
				},
				{
					"type": "inlineCode",
					"value": "default.js"
				},
				{
					"type": "text",
					"value": " file to render as a fallback for unmatched slots during the initial load or full-page reload."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Consider the following folder structure. The "
				},
				{
					"type": "inlineCode",
					"value": "@team"
				},
				{
					"type": "text",
					"value": " slot has a "
				},
				{
					"type": "inlineCode",
					"value": "/settings"
				},
				{
					"type": "text",
					"value": " page, but "
				},
				{
					"type": "inlineCode",
					"value": "@analytics"
				},
				{
					"type": "text",
					"value": " does not."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "html",
					"value": "<Image\nalt=\"Parallel Routes unmatched routes\"\nsrcLight=\"/docs/light/parallel-routes-unmatched-routes.png\"\nsrcDark=\"/docs/dark/parallel-routes-unmatched-routes.png\"\nwidth=\"1600\"\nheight=\"930\"\n/>"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "When navigating to "
				},
				{
					"type": "inlineCode",
					"value": "/settings"
				},
				{
					"type": "text",
					"value": ", the "
				},
				{
					"type": "inlineCode",
					"value": "@team"
				},
				{
					"type": "text",
					"value": " slot will render the "
				},
				{
					"type": "inlineCode",
					"value": "/settings"
				},
				{
					"type": "text",
					"value": " page while maintaining the currently active page for the "
				},
				{
					"type": "inlineCode",
					"value": "@analytics"
				},
				{
					"type": "text",
					"value": " slot."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "On refresh, Next.js will render a "
				},
				{
					"type": "inlineCode",
					"value": "default.js"
				},
				{
					"type": "text",
					"value": " for "
				},
				{
					"type": "inlineCode",
					"value": "@analytics"
				},
				{
					"type": "text",
					"value": ". If "
				},
				{
					"type": "inlineCode",
					"value": "default.js"
				},
				{
					"type": "text",
					"value": " doesn't exist, a "
				},
				{
					"type": "inlineCode",
					"value": "404"
				},
				{
					"type": "text",
					"value": " is rendered instead."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Additionally, since "
				},
				{
					"type": "inlineCode",
					"value": "children"
				},
				{
					"type": "text",
					"value": " is an implicit slot, you also need to create a "
				},
				{
					"type": "inlineCode",
					"value": "default.js"
				},
				{
					"type": "text",
					"value": " file to render a fallback for "
				},
				{
					"type": "inlineCode",
					"value": "children"
				},
				{
					"type": "text",
					"value": " when Next.js cannot recover the active state of the parent page."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Behavior"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "By default, Next.js keeps track of the active "
				},
				{
					"type": "emphasis",
					"children": [
						{
							"type": "text",
							"value": "state"
						}
					]
				},
				{
					"type": "text",
					"value": " (or subpage) for each slot. However, the content rendered within a slot will depend on the type of navigation:"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "link",
									"title": null,
									"url": "/docs/app/getting-started/linking-and-navigating#client-side-transitions",
									"children": [
										{
											"type": "strong",
											"children": [
												{
													"type": "text",
													"value": "Soft Navigation"
												}
											]
										}
									]
								},
								{
									"type": "text",
									"value": ": During client-side navigation, Next.js will perform a "
								},
								{
									"type": "link",
									"title": null,
									"url": "/docs/app/getting-started/linking-and-navigating#client-side-transitions",
									"children": [
										{
											"type": "text",
											"value": "partial render"
										}
									]
								},
								{
									"type": "text",
									"value": ", changing the subpage within the slot, while maintaining the other slot's active subpages, even if they don't match the current URL."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "Hard Navigation"
										}
									]
								},
								{
									"type": "text",
									"value": ": After a full-page load (browser refresh), Next.js cannot determine the active state for the slots that don't match the current URL. Instead, it will render a "
								},
								{
									"type": "link",
									"title": null,
									"url": "#defaultjs",
									"children": [
										{
											"type": "inlineCode",
											"value": "default.js"
										}
									]
								},
								{
									"type": "text",
									"value": " file for the unmatched slots, or "
								},
								{
									"type": "inlineCode",
									"value": "404"
								},
								{
									"type": "text",
									"value": " if "
								},
								{
									"type": "inlineCode",
									"value": "default.js"
								},
								{
									"type": "text",
									"value": " doesn't exist."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know"
								}
							]
						},
						{
							"type": "text",
							"value": ":"
						}
					]
				},
				{
					"type": "list",
					"ordered": false,
					"start": null,
					"spread": false,
					"children": [
						{
							"type": "listItem",
							"spread": false,
							"checked": null,
							"children": [
								{
									"type": "paragraph",
									"children": [
										{
											"type": "text",
											"value": "The "
										},
										{
											"type": "inlineCode",
											"value": "404"
										},
										{
											"type": "text",
											"value": " for unmatched routes helps ensure that you don't accidentally render a parallel route on a page that it was not intended for."
										}
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Examples"
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "With "
				},
				{
					"type": "inlineCode",
					"value": "useSelectedLayoutSegment(s)"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Both "
