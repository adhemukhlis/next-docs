		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Conditional Routes"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "You can use Parallel Routes to conditionally render routes based on certain conditions, such as user role. For example, to render a different dashboard page for the "
				},
				{
					"type": "inlineCode",
					"value": "/admin"
				},
				{
					"type": "text",
					"value": " or "
				},
				{
					"type": "inlineCode",
					"value": "/user"
				},
				{
					"type": "text",
					"value": " roles:"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "html",
					"value": "<Image\nalt=\"Conditional routes diagram\"\nsrcLight=\"/docs/light/conditional-routes-ui.png\"\nsrcDark=\"/docs/dark/conditional-routes-ui.png\"\nwidth=\"1600\"\nheight=\"898\"\n/>"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/dashboard/layout.tsx\" switcher",
			"value": "import { checkUserRole } from '@/lib/auth'\n\nexport default function Layout({ user, admin }: { user: React.ReactNode; admin: React.ReactNode }) {\n\tconst role = checkUserRole()\n\treturn role === 'admin' ? admin : user\n}"
		},
		{
			"type": "code",
