								{
									"type": "inlineCode",
									"value": "error"
								},
								{
									"type": "text",
									"value": ": The caught value is typed as "
								},
								{
									"type": "inlineCode",
									"value": "unknown"
								},
								{
									"type": "text",
									"value": ". Narrow it before reading properties like "
								},
								{
									"type": "inlineCode",
									"value": "message"
								},
								{
									"type": "text",
									"value": " or "
