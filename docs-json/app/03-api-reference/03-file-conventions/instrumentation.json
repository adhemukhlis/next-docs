				{
					"type": "inlineCode",
					"value": "instrumentation.js"
				},
				{
					"type": "text",
					"value": " file works in both the Node.js and Edge runtime, however, you can use "
				},
				{
					"type": "inlineCode",
					"value": "process.env.NEXT_RUNTIME"
				},
				{
					"type": "text",
					"value": " to target a specific runtime."
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"instrumentation.js\"",
			"value": "export function register() {\n\tif (process.env.NEXT_RUNTIME === 'edge') {\n\t\treturn require('./register.edge')\n\t} else {\n\t\treturn require('./register.node')\n\t}\n}\n\nexport function onRequestError() {\n\tif (process.env.NEXT_RUNTIME === 'edge') {\n\t\treturn require('./on-request-error.edge')\n\t} else {\n\t\treturn require('./on-request-error.node')\n\t}\n}"
		},
