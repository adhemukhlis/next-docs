								{
									"type": "text",
									"value": ": Read-only request information associated with the error."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "inlineCode",
									"value": "context"
								},
								{
									"type": "text",
									"value": ": The context in which the error occurred. This can be the type of router (App or Pages Router), and/or (Server Components ("
								},
								{
									"type": "inlineCode",
									"value": "'render'"
								},
								{
									"type": "text",
									"value": "), Route Handlers ("
								},
								{
									"type": "inlineCode",
									"value": "'route'"
								},
								{
									"type": "text",
									"value": "), Server Actions ("
								},
								{
									"type": "inlineCode",
									"value": "'action'"
								},
								{
									"type": "text",
									"value": "), or Proxy ("
								},
								{
									"type": "inlineCode",
									"value": "'proxy'"
								},
								{
									"type": "text",
									"value": "))."
								}
							]
