		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "These abstractions use the Web APIs to create a stream. You can also use the underlying Web APIs directly."
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": "filename=\"app/api/route.ts\" switcher",
			"value": "// https://developer.mozilla.org/docs/Web/API/ReadableStream#convert_async_iterator_to_stream\nfunction iteratorToStream(iterator: any) {\n\treturn new ReadableStream({\n\t\tasync pull(controller) {\n\t\t\tconst { value, done } = await iterator.next()\n\n\t\t\tif (done) {\n\t\t\t\tcontroller.close()\n\t\t\t} else {\n\t\t\t\tcontroller.enqueue(value)\n\t\t\t}\n\t\t},\n\t})\n}\n\nfunction sleep(time: number) {\n\treturn new Promise((resolve) => {\n\t\tsetTimeout(resolve, time)\n\t})\n}\n\nconst encoder = new TextEncoder()\n\nasync function* makeIterator() {\n\tyield encoder.encode('<p>One</p>')\n\tawait sleep(200)\n\tyield encoder.encode('<p>Two</p>')\n\tawait sleep(200)\n\tyield encoder.encode('<p>Three</p>')\n}\n\nexport async function GET() {\n\tconst iterator = makeIterator()\n\tconst stream = iteratorToStream(iterator)\n\n\treturn new Response(stream)\n}"
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"app/api/route.js\" switcher",
			"value": "// https://developer.mozilla.org/docs/Web/API/ReadableStream#convert_async_iterator_to_stream\nfunction iteratorToStream(iterator) {\n\treturn new ReadableStream({\n\t\tasync pull(controller) {\n\t\t\tconst { value, done } = await iterator.next()\n\n\t\t\tif (done) {\n\t\t\t\tcontroller.close()\n\t\t\t} else {\n\t\t\t\tcontroller.enqueue(value)\n\t\t\t}\n\t\t},\n\t})\n}\n\nfunction sleep(time) {\n\treturn new Promise((resolve) => {\n\t\tsetTimeout(resolve, time)\n\t})\n}\n\nconst encoder = new TextEncoder()\n\nasync function* makeIterator() {\n\tyield encoder.encode('<p>One</p>')\n\tawait sleep(200)\n\tyield encoder.encode('<p>Two</p>')\n\tawait sleep(200)\n\tyield encoder.encode('<p>Three</p>')\n}\n\nexport async function GET() {\n\tconst iterator = makeIterator()\n\tconst stream = iteratorToStream(iterator)\n\n\treturn new Response(stream)\n}"
		},
