{
	"type": "root",
	"children": [
		{
			"type": "yaml",
			"value": "title: default.js\ndescription: API Reference for the default.js file."
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The "
				},
				{
					"type": "inlineCode",
					"value": "default.js"
				},
				{
					"type": "text",
					"value": " file is used to render a fallback within "
				},
				{
					"type": "link",
					"title": null,
					"url": "./parallel-routes.md",
					"children": [
						{
							"type": "text",
							"value": "Parallel Routes"
						}
					]
				},
				{
					"type": "text",
					"value": " when Next.js cannot recover a "
				},
				{
					"type": "link",
					"title": null,
					"url": "./parallel-routes.md#slots",
					"children": [
						{
							"type": "text",
							"value": "slot's"
						}
					]
				},
				{
					"type": "text",
					"value": " active state after a full-page load."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "During "
				},
				{
					"type": "link",
					"title": null,
					"url": "../../01-getting-started/04-linking-and-navigating.md#client-side-transitions",
					"children": [
						{
							"type": "text",
							"value": "soft navigation"
						}
					]
				},
				{
					"type": "text",
					"value": ", Next.js keeps track of the active "
				},
				{
					"type": "emphasis",
					"children": [
						{
							"type": "text",
							"value": "state"
						}
					]
				},
				{
					"type": "text",
					"value": " (subpage) for each slot. However, for hard navigations (full-page load), Next.js cannot recover the active state. In this case, a "
				},
				{
					"type": "inlineCode",
					"value": "default.js"
				},
				{
					"type": "text",
					"value": " file can be rendered for subpages that don't match the current URL."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Consider the following folder structure. The "
				},
				{
					"type": "inlineCode",
					"value": "@team"
				},
				{
					"type": "text",
					"value": " slot has a "
				},
				{
					"type": "inlineCode",
					"value": "settings"
				},
				{
					"type": "text",
					"value": " page, but "
				},
				{
					"type": "inlineCode",
					"value": "@analytics"
				},
				{
					"type": "text",
					"value": " does not."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "html",
					"value": "<Image\nalt=\"Parallel Routes unmatched routes\"\nsrcLight=\"/docs/light/parallel-routes-unmatched-routes.png\"\nsrcDark=\"/docs/dark/parallel-routes-unmatched-routes.png\"\nwidth=\"1600\"\nheight=\"930\"\n/>"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "When navigating to "
				},
				{
					"type": "inlineCode",
					"value": "/settings"
				},
				{
					"type": "text",
					"value": ", the "
				},
				{
					"type": "inlineCode",
					"value": "@team"
				},
				{
					"type": "text",
					"value": " slot will render the "
				},
				{
					"type": "inlineCode",
					"value": "settings"
				},
				{
					"type": "text",
					"value": " page while maintaining the currently active page for the "
				},
				{
					"type": "inlineCode",
					"value": "@analytics"
				},
				{
					"type": "text",
					"value": " slot."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "On refresh, Next.js will render a "
				},
				{
					"type": "inlineCode",
					"value": "default.js"
				},
				{
					"type": "text",
					"value": " for "
				},
				{
					"type": "inlineCode",
					"value": "@analytics"
				},
				{
					"type": "text",
					"value": ". If "
				},
				{
					"type": "inlineCode",
					"value": "default.js"
				},
				{
					"type": "text",
					"value": " doesn't exist, an error is returned for named slots ("
				},
				{
					"type": "inlineCode",
					"value": "@team"
				},
				{
					"type": "text",
					"value": ", "
				},
				{
					"type": "inlineCode",
					"value": "@analytics"
				},
				{
					"type": "text",
					"value": ", etc) and requires you to define a "
				},
				{
					"type": "inlineCode",
					"value": "default.js"
				},
				{
					"type": "text",
					"value": " in order to continue. If you want to preserve the old behavior of returning a 404 in these situations, you can create a "
				},
				{
					"type": "inlineCode",
					"value": "default.js"
				},
				{
					"type": "text",
					"value": " that contains:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/@team/default.js\"",
			"value": "import { notFound } from 'next/navigation'\n\nexport default function Default() {\n\tnotFound()\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Additionally, since "
				},
				{
					"type": "inlineCode",
					"value": "children"
				},
				{
					"type": "text",
					"value": " is an implicit slot, you also need to create a "
				},
				{
					"type": "inlineCode",
					"value": "default.js"
				},
				{
					"type": "text",
					"value": " file to render a fallback for "
				},
				{
					"type": "inlineCode",
					"value": "children"
				},
				{
					"type": "text",
					"value": " when Next.js cannot recover the active state of the parent page. If you don't create a "
				},
				{
					"type": "inlineCode",
					"value": "default.js"
				},
				{
					"type": "text",
					"value": " for the "
				},
				{
					"type": "inlineCode",
					"value": "children"
				},
				{
					"type": "text",
					"value": " slot, it will return a 404 page for the route."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Reference"
				}
			]
		},
		{
			"type": "heading",
