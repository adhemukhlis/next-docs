				},
				{
					"type": "text",
					"value": " (optional)"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "A promise that resolves to an object containing the "
				},
				{
					"type": "link",
					"title": null,
					"url": "./dynamic-routes.md",
					"children": [
						{
							"type": "text",
							"value": "dynamic route parameters"
						}
					]
				},
				{
					"type": "text",
					"value": " from the root segment down to the slot's subpages. For example:"
				}
			]
