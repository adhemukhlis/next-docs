			"meta": "filename=\"/app/page.tsx\" switcher",
			"value": "import Form from 'next/form'\n\nexport default function Page() {\n\treturn (\n\t\t<Form action=\"/search\">\n\t\t\t<input name=\"query\" />\n\t\t\t<button type=\"submit\">Submit</button>\n\t\t</Form>\n\t)\n}"
		},
