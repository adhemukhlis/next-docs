						{
							"type": "inlineCode",
							"value": "action"
						},
						{
							"type": "text",
							"value": ", the form will navigate to the same route with updated search params."
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "On the results page, you can access the query using the "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-file-conventions/page.md#searchparams-optional",
					"children": [
						{
							"type": "inlineCode",
							"value": "searchParams"
						}
					]
				},
				{
					"type": "text",
					"value": " "
				},
				{
					"type": "inlineCode",
					"value": "page.js"
				},
