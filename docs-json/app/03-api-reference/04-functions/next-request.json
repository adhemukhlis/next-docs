{
	"type": "root",
	"children": [
		{
			"type": "yaml",
			"value": "title: NextRequest\ndescription: API Reference for NextRequest."
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "NextRequest extends the "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://developer.mozilla.org/docs/Web/API/Request",
					"children": [
						{
							"type": "text",
							"value": "Web Request API"
						}
					]
				},
				{
					"type": "text",
					"value": " with additional convenience methods."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "inlineCode",
					"value": "cookies"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Read or mutate the "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://developer.mozilla.org/docs/Web/HTTP/Headers/Set-Cookie",
					"children": [
						{
							"type": "inlineCode",
							"value": "Set-Cookie"
						}
					]
				},
				{
					"type": "text",
					"value": " header of the request."
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "inlineCode",
					"value": "set(name, value)"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Given a name, set a cookie with the given value on the request."
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": null,
			"value": "// Given incoming request /home\n// Set a cookie to hide the banner\n// request will have a `Set-Cookie:show-banner=false;path=/home` header\nrequest.cookies.set('show-banner', 'false')"
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "inlineCode",
					"value": "get(name)"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Given a cookie name, return the value of the cookie. If the cookie is not found, "
				},
				{
					"type": "inlineCode",
					"value": "undefined"
				},
				{
					"type": "text",
					"value": " is returned. If multiple cookies are found, the first one is returned."
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": null,
			"value": "// Given incoming request /home\n// { name: 'show-banner', value: 'false', Path: '/home' }\nrequest.cookies.get('show-banner')"
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "inlineCode",
					"value": "getAll()"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Given a cookie name, return the values of the cookie. If no name is given, return all cookies on the request."
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": null,
			"value": "// Given incoming request /home\n// [\n//   { name: 'experiments', value: 'new-pricing-page', Path: '/home' },\n//   { name: 'experiments', value: 'winter-launch', Path: '/home' },\n// ]\nrequest.cookies.getAll('experiments')\n// Alternatively, get all cookies for the request\nrequest.cookies.getAll()"
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "inlineCode",
					"value": "delete(name)"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Given a cookie name, delete the cookie from the request."
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": null,
			"value": "// Returns true for deleted, false is nothing is deleted\nrequest.cookies.delete('experiments')"
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "inlineCode",
					"value": "has(name)"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Given a cookie name, return "
				},
				{
					"type": "inlineCode",
					"value": "true"
				},
				{
					"type": "text",
					"value": " if the cookie exists on the request."
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": null,
			"value": "// Returns true if cookie exists, false if it does not\nrequest.cookies.has('experiments')"
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "inlineCode",
					"value": "clear()"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Remove all cookies from the request."
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": null,
			"value": "request.cookies.clear()"
		},
		{
