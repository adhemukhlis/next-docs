			"children": [
				{
					"type": "text",
					"value": "The "
				},
				{
					"type": "inlineCode",
					"value": "permanentRedirect"
				},
				{
					"type": "text",
					"value": " function allows you to redirect the user to another URL. "
				},
				{
					"type": "inlineCode",
					"value": "permanentRedirect"
				},
				{
					"type": "text",
					"value": " can be used in Server Components, Client Components, "
				},
				{
					"type": "link",
					"title": null,
