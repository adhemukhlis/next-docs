					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "Routes with dynamic params not covered by "
										},
										{
											"type": "inlineCode",
											"value": "generateStaticParams"
										}
									]
								},
								{
									"type": "text",
									"value": ": the param is not known until request time. "
								},
								{
									"type": "inlineCode",
									"value": "useParams"
								},
								{
									"type": "text",
									"value": " suspends. Wrap the component (or a parent) in a "
