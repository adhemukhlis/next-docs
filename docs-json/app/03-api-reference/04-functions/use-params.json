			"children": [
				{
					"type": "inlineCode",
					"value": "useParams"
				},
				{
					"type": "text",
					"value": " is a "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "Client Component"
						}
					]
				},
				{
					"type": "text",
					"value": " hook that lets you read a route's "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-file-conventions/dynamic-routes.md",
					"children": [
						{
							"type": "text",
							"value": "dynamic params"
						}
					]
				},
				{
					"type": "text",
					"value": " filled in by the current URL."
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/example-client-component.tsx\" switcher",
			"value": "'use client'\n\nimport { useParams } from 'next/navigation'\n\nexport default function ExampleClientComponent() {\n\tconst params = useParams<{ tag: string; item: string }>()\n\n\t// Route -> /shop/[tag]/[item]\n\t// URL -> /shop/shoes/nike-air-max-97\n\t// `params` -> { tag: 'shoes', item: 'nike-air-max-97' }\n\tconsole.log(params)\n\n\treturn '...'\n}"
		},
