									"children": [
										{
											"type": "text",
											"value": "Static routes and routes with "
										},
										{
											"type": "link",
											"title": null,
											"url": "./generate-static-params.md",
											"children": [
												{
													"type": "inlineCode",
													"value": "generateStaticParams"
