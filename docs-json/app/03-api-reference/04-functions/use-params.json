			"type": "paragraph",
			"children": [
				{
					"type": "inlineCode",
					"value": "useParams"
				},
				{
					"type": "text",
					"value": " returns an object containing the current route's filled in "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-file-conventions/dynamic-routes.md",
					"children": [
						{
							"type": "text",
							"value": "dynamic parameters"
						}
					]
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Each property in the object is an active dynamic segment."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "The properties name is the segment's name, and the properties value is what the segment is filled in with."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "The properties value will either be a "
								},
								{
									"type": "inlineCode",
									"value": "string"
								},
								{
									"type": "text",
									"value": " or array of "
								},
								{
									"type": "inlineCode",
									"value": "string"
								},
								{
									"type": "text",
									"value": "'s depending on the "
								},
								{
									"type": "link",
									"title": null,
									"url": "../03-file-conventions/dynamic-routes.md",
									"children": [
										{
											"type": "text",
											"value": "type of dynamic segment"
										}
									]
								},
								{
									"type": "text",
									"value": "."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "If the route contains no dynamic parameters, "
								},
								{
									"type": "inlineCode",
									"value": "useParams"
								},
								{
									"type": "text",
									"value": " returns an empty object."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "If used in Pages Router, "
								},
								{
									"type": "inlineCode",
									"value": "useParams"
								},
								{
									"type": "text",
									"value": " will return "
								},
								{
									"type": "inlineCode",
									"value": "null"
								},
								{
									"type": "text",
									"value": " on the initial render and updates with properties following the rules above once the router is ready."
								}
							]
						}
					]
				}
			]
		},
