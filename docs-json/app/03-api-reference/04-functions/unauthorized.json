		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Invoking "
				},
				{
					"type": "inlineCode",
					"value": "unauthorized()"
				},
				{
					"type": "text",
					"value": " throws a "
				},
				{
					"type": "inlineCode",
					"value": "NEXT_HTTP_ERROR_FALLBACK;401"
				},
				{
					"type": "text",
					"value": " error and terminates rendering of the route segment where it was thrown. Next.js also injects a "
				},
				{
					"type": "inlineCode",
					"value": "<meta name=\"robots\" content=\"noindex\" />"
				},
				{
					"type": "text",
					"value": " tag so the page is not indexed. Because it works by throwing, call it in the render path: a component, or a function a component "
				},
				{
					"type": "inlineCode",
					"value": "await"
				},
				{
					"type": "text",
					"value": "s. A call left in an un-awaited promise throws where nothing catches it, and no unauthorized UI renders."
				}
			]
		},
