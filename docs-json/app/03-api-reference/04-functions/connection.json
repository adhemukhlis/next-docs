{
	"type": "root",
	"children": [
		{
			"type": "yaml",
			"value": "title: connection\ndescription: API Reference for the connection function."
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The "
				},
				{
					"type": "inlineCode",
					"value": "connection()"
				},
				{
					"type": "text",
					"value": " function allows you to indicate rendering should wait for an incoming user request before continuing."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "It's useful when a component doesn't use "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/glossary#request-time-apis",
					"children": [
						{
							"type": "text",
							"value": "Request-time APIs"
						}
					]
				},
				{
					"type": "text",
					"value": " like "
				},
				{
					"type": "inlineCode",
					"value": "cookies"
				},
				{
					"type": "text",
					"value": " or "
				},
				{
					"type": "inlineCode",
					"value": "headers"
				},
				{
					"type": "text",
					"value": ", but still needs to produce different output per request, such as "
				},
				{
					"type": "inlineCode",
					"value": "Math.random()"
				},
				{
					"type": "text",
					"value": " or "
				},
				{
					"type": "inlineCode",
					"value": "new Date()"
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": "filename=\"app/page.tsx\" switcher",
			"value": "import { connection } from 'next/server'\n\nexport default async function Page() {\n  await connection() // prerendering stops here\n  // the following code only runs at request time\n  const rand = Math.random()\n  return <span>{rand}</span>\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/page.js\" switcher",
			"value": "import { connection } from 'next/server'\n\nexport default async function Page() {\n\tawait connection() // prerendering stops here\n\t// the following code only runs at request time\n\tconst rand = Math.random()\n\treturn <span>{rand}</span>\n}"
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Examples"
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Synchronous database drivers"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Queries from synchronous database drivers like "
				},
				{
					"type": "inlineCode",
					"value": "better-sqlite3"
				},
				{
					"type": "text",
					"value": " complete during prerendering. If you are not already using Request-time APIs, call "
				},
				{
					"type": "inlineCode",
					"value": "connection()"
				},
				{
					"type": "text",
					"value": " before your query to exclude them from prerendering:"
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": "filename=\"app/lib/data.ts\" switcher",
			"value": "import { connection } from 'next/server'\nimport Database from 'better-sqlite3'\n\nconst db = new Database('app.db')\n\nexport async function getVisitorCount() {\n\tawait connection()\n\treturn db.prepare('SELECT value FROM counters WHERE name = ?').get('visitors')\n}"
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"app/lib/data.js\" switcher",
			"value": "import { connection } from 'next/server'\nimport Database from 'better-sqlite3'\n\nconst db = new Database('app.db')\n\nexport async function getVisitorCount() {\n\tawait connection()\n\treturn db.prepare('SELECT value FROM counters WHERE name = ?').get('visitors')\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Now any component that calls "
				},
				{
					"type": "inlineCode",
					"value": "getVisitorCount()"
				},
				{
					"type": "text",
					"value": " will be excluded from prerendering, along with the rest of its output."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
