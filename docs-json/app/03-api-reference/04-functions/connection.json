							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "The function is only necessary when dynamic rendering is required and common Request-time APIs are not used."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "With "
								},
								{
									"type": "link",
									"title": null,
									"url": "/docs/app/api-reference/config/next-config-js/cacheComponents",
									"children": [
										{
											"type": "text",
											"value": "Cache Components"
										}
									]
								},
								{
									"type": "text",
									"value": ", prefer "
								},
