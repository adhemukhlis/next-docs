							"type": "inlineCode",
							"value": "\"use cache\""
						}
					]
				},
				{
					"type": "text",
					"value": " and keep its cache lifetime without generating its result for every link into the route."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Use "
				},
				{
					"type": "inlineCode",
					"value": "connection()"
				},
				{
					"type": "text",
					"value": " when the work must run for a real request. Use "
				},
				{
					"type": "inlineCode",
					"value": "prefetch()"
				},
				{
					"type": "text",
					"value": " when the work is reusable but should only run for a selected per-link prefetch or a navigation."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "When to use it"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Use "
				},
				{
					"type": "inlineCode",
					"value": "prefetch()"
				},
				{
					"type": "text",
					"value": " when the content below it is expensive to produce and should not be generated in the App Shell that every "
				},
				{
					"type": "inlineCode",
					"value": "<Link>"
				},
				{
					"type": "text",
					"value": " into the route loads."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Producing the App Shell does not run that code, so its upstream requests are not issued until a per-link prefetch or the navigation."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Leaving content uncached also keeps it out of the shell, but gives up its cache lifetime and cannot make it available during a per-link prefetch. With "
				},
				{
					"type": "inlineCode",
					"value": "prefetch()"
				},
				{
					"type": "text",
					"value": ", the content can be cached with "
				},
				{
					"type": "link",
					"title": null,
					"url": "../01-directives/use-cache.md",
					"children": [
						{
							"type": "inlineCode",
							"value": "use cache"
						}
					]
				},
				{
					"type": "text",
					"value": " or "
				},
				{
					"type": "link",
					"title": null,
					"url": "../01-directives/use-cache-private.md",
					"children": [
						{
							"type": "inlineCode",
							"value": "use cache: private"
						}
					]
				},
				{
					"type": "text",
					"value": ", given a lifetime, and deferred to a per-link prefetch or navigation."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Uncached reads, values with a short "
				},
				{
					"type": "link",
					"title": null,
					"url": "./cacheLife.md#stale",
					"children": [
						{
							"type": "inlineCode",
							"value": "stale"
						}
					]
				},
				{
					"type": "text",
					"value": " time, and anything behind "
				},
				{
					"type": "inlineCode",
					"value": "params"
				},
				{
					"type": "text",
					"value": " or "
				},
				{
					"type": "inlineCode",
					"value": "searchParams"
				},
				{
					"type": "text",
					"value": " are already left out of the shell on their own."
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Keeping the App Shell static"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "When every read of "
				},
				{
					"type": "link",
					"title": null,
					"url": "./cookies.md",
					"children": [
						{
							"type": "inlineCode",
							"value": "cookies()"
						}
					]
				},
				{
					"type": "text",
					"value": " and "
				},
				{
					"type": "link",
					"title": null,
					"url": "./headers.md",
					"children": [
						{
							"type": "inlineCode",
							"value": "headers()"
						}
					]
				},
				{
					"type": "text",
					"value": " sits below "
				},
				{
					"type": "inlineCode",
					"value": "prefetch()"
				},
				{
					"type": "text",
					"value": ", the prerender a shell prefetch would trigger cannot produce more than the static output the build already generated, so the shell is served from that output instead. Shaping a route this way is an optional optimization: a static response can be cached in a CDN, so a default "
				},
				{
					"type": "inlineCode",
					"value": "<Link>"
				},
				{
					"type": "text",
					"value": " into the route costs no server CPU at all. A route that resolves "
				},
				{
					"type": "inlineCode",
					"value": "params"
				},
				{
					"type": "text",
					"value": " or "
				},
				{
					"type": "inlineCode",
					"value": "searchParams"
				},
				{
					"type": "text",
					"value": " gets that prerender instead, and so does the example above: its greeting reads the session in the shell, so the shell renders once per visitor and only the recommendations are deferred."
				}
			]
		},
		{
