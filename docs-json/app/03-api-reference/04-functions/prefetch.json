		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/dashboard/page.tsx\" highlight={25} switcher",
			"value": "import { Suspense } from 'react'\nimport { cookies } from 'next/headers'\nimport { cacheLife, prefetch } from 'next/cache'\n\nexport default function Page() {\n\treturn (\n\t\t<>\n\t\t\t<Suspense fallback={<p>Loading greeting...</p>}>\n\t\t\t\t<Greeting /> {/* in the App Shell */}\n\t\t\t</Suspense>\n\t\t\t<Suspense fallback={<p>Loading recommendations...</p>}>\n\t\t\t\t{/* the fallback is in the App Shell, the recommendations are not */}\n\t\t\t\t<Recommendations />\n\t\t\t</Suspense>\n\t\t</>\n\t)\n}\n\nasync function Greeting() {\n\tconst session = (await cookies()).get('session')?.value\n\treturn <p>{session ? 'Welcome back' : 'Welcome'}</p>\n}\n\nasync function Recommendations() {\n\tawait prefetch() // runtime work below renders on a per-link prefetch or navigation\n\tconst items = await getRecommendations()\n\treturn <List items={items} />\n}\n\nasync function getRecommendations() {\n\t'use cache: private'\n\tcacheLife('hours')\n\tconst session = (await cookies()).get('session')?.value\n\treturn db.recommendations.rank({ session })\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/dashboard/page.js\" highlight={25} switcher",
			"value": "import { Suspense } from 'react'\nimport { cookies } from 'next/headers'\nimport { cacheLife, prefetch } from 'next/cache'\n\nexport default function Page() {\n\treturn (\n\t\t<>\n\t\t\t<Suspense fallback={<p>Loading greeting...</p>}>\n\t\t\t\t<Greeting /> {/* in the App Shell */}\n\t\t\t</Suspense>\n\t\t\t<Suspense fallback={<p>Loading recommendations...</p>}>\n\t\t\t\t{/* the fallback is in the App Shell, the recommendations are not */}\n\t\t\t\t<Recommendations />\n\t\t\t</Suspense>\n\t\t</>\n\t)\n}\n\nasync function Greeting() {\n\tconst session = (await cookies()).get('session')?.value\n\treturn <p>{session ? 'Welcome back' : 'Welcome'}</p>\n}\n\nasync function Recommendations() {\n\tawait prefetch() // runtime work below renders on a per-link prefetch or navigation\n\tconst items = await getRecommendations()\n\treturn <List items={items} />\n}\n\nasync function getRecommendations() {\n\t'use cache: private'\n\tcacheLife('hours')\n\tconst session = (await cookies()).get('session')?.value\n\treturn db.recommendations.rank({ session })\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The greeting reads the session and stays in the App Shell. The recommendations read it too, inside "
				},
				{
					"type": "inlineCode",
					"value": "getRecommendations"
				},
				{
					"type": "text",
					"value": ", so that read is deferred along with the ranking. Remove "
				},
				{
					"type": "inlineCode",
					"value": "prefetch()"
				},
				{
					"type": "text",
					"value": " and they become part of the App Shell that every link into the route loads."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Put the directive on a function called below it, as "
				},
				{
					"type": "inlineCode",
					"value": "getRecommendations"
				},
				{
					"type": "text",
					"value": " does here. Awaiting "
