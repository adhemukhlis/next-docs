			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "How "
				},
				{
					"type": "inlineCode",
					"value": "prefetch()"
				},
				{
					"type": "text",
					"value": " differs from "
				},
				{
					"type": "inlineCode",
					"value": "connection()"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The "
				},
				{
					"type": "link",
					"title": null,
					"url": "./connection.md",
					"children": [
						{
							"type": "inlineCode",
							"value": "connection()"
						}
					]
				},
				{
					"type": "text",
					"value": " function waits for a real request. It excludes the code that follows from prerendering and prefetching, making that work request-dependent."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Awaiting "
				},
				{
					"type": "inlineCode",
					"value": "prefetch()"
				},
				{
					"type": "text",
					"value": " excludes the code that follows from the App Shell. It can resolve during a per-link prefetch without making that work request-dependent. A function called after "
				},
				{
					"type": "inlineCode",
					"value": "await prefetch()"
				},
				{
					"type": "text",
					"value": " can therefore use "
