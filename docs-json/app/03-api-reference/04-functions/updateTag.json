	"children": [
		{
			"type": "yaml",
			"value": "title: updateTag\ndescription: API Reference for the updateTag function."
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "inlineCode",
					"value": "updateTag"
				},
				{
					"type": "text",
					"value": " allows you to update cached data on-demand for a specific cache tag from within "
				},
				{
					"type": "link",
					"title": null,
					"url": "../../01-getting-started/07-mutating-data.md",
					"children": [
						{
							"type": "text",
							"value": "Server Actions"
						}
					]
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "This function is designed for "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "read-your-own-writes"
						}
					]
				},
				{
					"type": "text",
					"value": " scenarios, where a user makes a change (like creating a post), and the UI immediately shows the change, rather than stale data."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Usage"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "inlineCode",
					"value": "updateTag"
				},
				{
					"type": "text",
					"value": " can "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "only"
						}
					]
				},
				{
					"type": "text",
					"value": " be called from within "
				},
				{
					"type": "link",
					"title": null,
					"url": "../../01-getting-started/07-mutating-data.md",
					"children": [
						{
							"type": "text",
							"value": "Server Actions"
						}
					]
				},
				{
					"type": "text",
					"value": ". It cannot be used in Route Handlers, Client Components, or any other context."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "If you need to invalidate cache tags in Route Handlers or other contexts, use "
				},
				{
					"type": "link",
					"title": null,
					"url": "./revalidateTag.md",
					"children": [
						{
							"type": "inlineCode",
							"value": "revalidateTag"
						}
					]
				},
				{
					"type": "text",
					"value": " instead."
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know"
								}
							]
						},
						{
							"type": "text",
							"value": ": "
						},
						{
							"type": "inlineCode",
							"value": "updateTag"
						},
						{
							"type": "text",
							"value": " immediately expires the cached data for the specified tag. The next request will wait to fetch fresh data rather than serving stale content from the cache, ensuring users see their changes immediately."
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Parameters"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": null,
			"value": "updateTag(tag: string): void;"
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "inlineCode",
									"value": "tag"
								},
								{
									"type": "text",
									"value": ": A string representing the cache tag associated with the data you want to update. Must not exceed 256 characters. This value is case-sensitive."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Tags must first be assigned to cached data. You can do this in two ways:"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
