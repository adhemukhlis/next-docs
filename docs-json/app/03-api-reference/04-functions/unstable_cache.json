					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "inlineCode",
									"value": "fetchData"
								},
								{
									"type": "text",
									"value": ": This is an asynchronous function that fetches the data you want to cache. It must be a function that returns a "
								},
								{
									"type": "inlineCode",
									"value": "Promise"
								},
								{
									"type": "text",
									"value": "."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "inlineCode",
									"value": "keyParts"
								},
								{
									"type": "text",
									"value": ": This is an extra array of keys that further adds identification to the cache. By default, "
								},
								{
									"type": "inlineCode",
									"value": "unstable_cache"
								},
								{
									"type": "text",
									"value": " already uses the arguments and the stringified version of your function as the cache key. It is optional in most cases; the only time you need to use it is when you use external variables without passing them as parameters. However, it is important to add closures used within the function if you do not pass them as parameters."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "inlineCode",
									"value": "options"
								},
								{
									"type": "text",
									"value": ": This is an object that controls how the cache behaves. It can contain the following properties:"
								}
							]
						},
						{
							"type": "list",
							"ordered": false,
							"start": null,
							"spread": false,
							"children": [
								{
									"type": "listItem",
									"spread": false,
									"checked": null,
									"children": [
										{
											"type": "paragraph",
											"children": [
												{
													"type": "inlineCode",
													"value": "tags"
												},
												{
													"type": "text",
													"value": ": An array of tags that can be used to control cache invalidation. Next.js will not use this to uniquely identify the function."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"spread": false,
									"checked": null,
									"children": [
										{
											"type": "paragraph",
											"children": [
												{
													"type": "inlineCode",
													"value": "revalidate"
												},
												{
													"type": "text",
													"value": ": The number of seconds after which the cache should be revalidated. Omit or pass "
												},
												{
													"type": "inlineCode",
													"value": "false"
												},
												{
													"type": "text",
													"value": " to cache indefinitely or until matching "
												},
												{
													"type": "inlineCode",
													"value": "revalidateTag()"
												},
												{
													"type": "text",
													"value": " or "
												},
												{
													"type": "inlineCode",
													"value": "revalidatePath()"
												},
												{
													"type": "text",
													"value": " methods are called."
												}
											]
										}
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Returns"
