		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "inlineCode",
					"value": "unstable_cache"
				},
				{
					"type": "text",
					"value": " returns a function that when invoked, returns a Promise that resolves to the cached data. If the data is not in the cache, the provided function will be invoked, and its result will be cached and returned."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Example"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/page.tsx\" switcher",
			"value": "import { unstable_cache } from 'next/cache'\n\nexport default async function Page({ params }: { params: Promise<{ userId: string }> }) {\n\tconst { userId } = await params\n\tconst getCachedUser = unstable_cache(\n\t\tasync () => {\n\t\t\treturn { id: userId }\n\t\t},\n\t\t[userId], // add the user ID to the cache key\n\t\t{\n\t\t\ttags: ['users'],\n\t\t\trevalidate: 60,\n\t\t},\n\t)\n\n\t//...\n}"
		},
