								}
							]
						},
						{
							"type": "text",
							"value": " causes client-side rendering up to the closest "
						},
						{
							"type": "inlineCode",
							"value": "Suspense"
						},
						{
							"type": "text",
							"value": " boundary during "
						},
						{
							"type": "link",
							"title": null,
							"url": "../../04-glossary.md#prerendering",
							"children": [
								{
									"type": "text",
									"value": "prerendering"
								}
							]
						},
						{
							"type": "text",
							"value": ". "
						},
						{
							"type": "link",
							"title": null,
							"url": "./use-search-params.md#behavior",
							"children": [
								{
									"type": "text",
									"value": "Learn more"
								}
							]
						},
						{
							"type": "text",
							"value": "."
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Disabling scroll to top"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "By default, Next.js will scroll to the top of the page when navigating to a new route. You can disable this behavior by passing "
				},
				{
					"type": "inlineCode",
					"value": "scroll: false"
				},
				{
					"type": "text",
					"value": " to "
				},
				{
					"type": "inlineCode",
					"value": "router.push()"
				},
				{
					"type": "text",
					"value": " or "
				},
				{
					"type": "inlineCode",
					"value": "router.replace()"
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/example-client-component.tsx\" switcher",
			"value": "'use client'\n\nimport { useRouter } from 'next/navigation'\n\nexport default function Page() {\n\tconst router = useRouter()\n\n\treturn (\n\t\t<button\n\t\t\ttype=\"button\"\n\t\t\tonClick={() => router.push('/dashboard', { scroll: false })}>\n\t\t\tDashboard\n\t\t</button>\n\t)\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/example-client-component.jsx\" switcher",
			"value": "'use client'\n\nimport { useRouter } from 'next/navigation'\n\nexport default function Page() {\n\tconst router = useRouter()\n\n\treturn (\n\t\t<button\n\t\t\ttype=\"button\"\n\t\t\tonClick={() => router.push('/dashboard', { scroll: false })}>\n\t\t\tDashboard\n\t\t</button>\n\t)\n}"
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "inlineCode",
					"value": "bfcacheId"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "inlineCode",
					"value": "router.bfcacheId"
				},
				{
					"type": "text",
					"value": " is an opaque string identifier scoped to the current route segment. It changes when the surrounding segment is freshly created by a push or replace navigation, and stays the same for back/forward navigations, "
				},
				{
					"type": "inlineCode",
					"value": "router.refresh()"
				},
				{
					"type": "text",
					"value": ", and search-param- or hash-only navigations."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The recommended use is to pass it as a React "
				},
				{
					"type": "inlineCode",
					"value": "key"
				},
				{
					"type": "text",
					"value": " to opt out of state preservation on fresh navigations, while still restoring it during a back/forward navigation:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/example/page.tsx\"",
			"value": "'use client'\n\nimport { useRouter } from 'next/navigation'\n\nexport default function Page() {\n\tconst { bfcacheId } = useRouter()\n\treturn <form key={bfcacheId}>{/* ... */}</form>\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "When "
				},
				{
					"type": "inlineCode",
					"value": "cacheComponents"
				},
				{
					"type": "text",
					"value": " is enabled, the App Router preserves Client Component state across navigations using React "
				},
				{
					"type": "inlineCode",
					"value": "<Activity>"
				},
				{
					"type": "text",
					"value": ". Keying a component on "
				},
				{
					"type": "inlineCode",
					"value": "bfcacheId"
				},
				{
					"type": "text",
					"value": " resets it on each fresh navigation while still preserving its state across browser back/forward navigations. See "
				},
				{
					"type": "link",
					"title": null,
					"url": "../../02-guides/preserving-ui-state.md",
					"children": [
						{
							"type": "text",
							"value": "Preserving UI state"
						}
					]
				},
				{
					"type": "text",
					"value": " for the recommended per-pattern resets."
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know"
								}
							]
						},
						{
							"type": "text",
							"value": ": Instead of "
						},
						{
							"type": "inlineCode",
							"value": "bfcacheId"
						},
						{
							"type": "text",
							"value": ", prefer resetting state explicitly in an event handler (for example, "
						},
						{
							"type": "inlineCode",
							"value": "onSubmit"
						},
						{
							"type": "text",
							"value": ") or deriving a key from your data (for example, a draft id from the server). Use "
						},
						{
							"type": "inlineCode",
							"value": "bfcacheId"
						},
						{
							"type": "text",
							"value": " only as a last resort, like when migrating an existing codebase."
						}
					]
				}
			]
