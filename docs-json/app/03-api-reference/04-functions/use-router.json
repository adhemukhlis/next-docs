				{
					"type": "text",
					"value": "Router events"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "You can listen for page changes by composing other Client Component hooks like "
				},
				{
					"type": "inlineCode",
					"value": "usePathname"
				},
				{
					"type": "text",
					"value": " and "
				},
				{
					"type": "inlineCode",
					"value": "useSearchParams"
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/components/navigation-events.js\"",
			"value": "'use client'\n\nimport { useEffect } from 'react'\nimport { usePathname, useSearchParams } from 'next/navigation'\n\nexport function NavigationEvents() {\n\tconst pathname = usePathname()\n\tconst searchParams = useSearchParams()\n\n\tuseEffect(() => {\n\t\tconst url = `${pathname}?${searchParams}`\n\t\tconsole.log(url)\n\t\t// You can now use the current URL\n\t\t// ...\n\t}, [pathname, searchParams])\n\n\treturn '...'\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Which can be imported into a layout."
				}
			]
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/layout.js\" highlight={2,10-12}",
			"value": "import { Suspense } from 'react'\nimport { NavigationEvents } from './components/navigation-events'\n\nexport default function Layout({ children }) {\n\treturn (\n\t\t<html lang=\"en\">\n\t\t\t<body>\n\t\t\t\t{children}\n\n\t\t\t\t<Suspense fallback={null}>\n\t\t\t\t\t<NavigationEvents />\n\t\t\t\t</Suspense>\n\t\t\t</body>\n\t\t</html>\n\t)\n}"
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know"
								}
							]
						},
						{
							"type": "text",
							"value": ": "
						},
						{
							"type": "inlineCode",
							"value": "<NavigationEvents>"
						},
						{
							"type": "text",
							"value": " is wrapped in a "
						},
						{
							"type": "link",
							"title": null,
							"url": "../03-file-conventions/loading.md#examples",
							"children": [
								{
									"type": "inlineCode",
									"value": "Suspense"
								},
								{
									"type": "text",
									"value": " boundary"
								}
							]
						},
						{
							"type": "text",
							"value": " because"
						},
						{
							"type": "link",
							"title": null,
							"url": "./use-search-params.md",
							"children": [
								{
									"type": "inlineCode",
