		{
			"type": "html",
			"value": "<details id=\"after-serverless\">\n  <summary>Reference: supporting `after` for serverless platforms</summary>"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Using "
				},
				{
					"type": "inlineCode",
					"value": "after"
				},
				{
					"type": "text",
					"value": " in a serverless context requires waiting for asynchronous tasks to finish after the response has been sent. In Next.js and Vercel, this is achieved using a primitive called "
				},
				{
					"type": "inlineCode",
					"value": "waitUntil(promise)"
				},
				{
					"type": "text",
					"value": ", which extends the lifetime of a serverless invocation until all promises passed to "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://vercel.com/docs/functions/functions-api-reference#waituntil",
					"children": [
						{
							"type": "inlineCode",
							"value": "waitUntil"
						}
					]
				},
				{
					"type": "text",
					"value": " have settled."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "If you want your users to be able to run "
				},
				{
					"type": "inlineCode",
					"value": "after"
				},
				{
					"type": "text",
					"value": ", you will have to provide your implementation of "
				},
				{
					"type": "inlineCode",
					"value": "waitUntil"
				},
				{
					"type": "text",
					"value": " that behaves in an analogous way."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "When "
				},
				{
					"type": "inlineCode",
					"value": "after"
				},
				{
					"type": "text",
					"value": " is called, Next.js will access "
				},
				{
					"type": "inlineCode",
					"value": "waitUntil"
				},
				{
					"type": "text",
					"value": " like this:"
				}
			]
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": null,
			"value": "const RequestContext = globalThis[Symbol.for('@next/request-context')]\nconst contextValue = RequestContext?.get()\nconst waitUntil = contextValue?.waitUntil"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Which means that "
				},
				{
					"type": "inlineCode",
					"value": "globalThis[Symbol.for('@next/request-context')]"
				},
				{
					"type": "text",
					"value": " is expected to contain an object like this:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": null,
			"value": "type NextRequestContext = {\n\tget(): NextRequestContextValue | undefined\n}\n\ntype NextRequestContextValue = {\n\twaitUntil?: (promise: Promise<any>) => void\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Here is an example of the implementation."
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": null,
			"value": "import { AsyncLocalStorage } from 'node:async_hooks'\n\nconst RequestContextStorage = new AsyncLocalStorage<NextRequestContextValue>()\n\n// Define and inject the accessor that next.js will use\nconst RequestContext: NextRequestContext = {\n\tget() {\n\t\treturn RequestContextStorage.getStore()\n\t},\n}\nglobalThis[Symbol.for('@next/request-context')] = RequestContext\n\nconst handler = (req, res) => {\n\tconst contextValue = { waitUntil: YOUR_WAITUNTIL }\n\t// Provide the value\n\treturn RequestContextStorage.run(contextValue, () => nextJsHandler(req, res))\n}"
		},
