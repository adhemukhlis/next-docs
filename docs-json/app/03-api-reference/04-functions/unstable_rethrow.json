	"children": [
		{
			"type": "yaml",
			"value": "title: unstable_rethrow\ndescription: API Reference for the unstable_rethrow function.\nversion: unstable"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "inlineCode",
					"value": "unstable_rethrow"
				},
				{
					"type": "text",
					"value": " can be used to avoid catching internal errors thrown by Next.js when attempting to handle errors thrown in your application code."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "For example, calling the "
				},
				{
					"type": "inlineCode",
					"value": "notFound"
				},
				{
					"type": "text",
					"value": " function will throw an internal Next.js error and render the "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/api-reference/file-conventions/not-found",
					"children": [
						{
							"type": "inlineCode",
							"value": "not-found.js"
						}
					]
				},
				{
					"type": "text",
					"value": " component. However, if used inside the "
				},
				{
					"type": "inlineCode",
					"value": "try"
				},
				{
					"type": "text",
					"value": " block of a "
				},
				{
					"type": "inlineCode",
					"value": "try/catch"
				},
				{
					"type": "text",
					"value": " statement, the error will be caught, preventing "
				},
				{
					"type": "inlineCode",
					"value": "not-found.js"
				},
				{
					"type": "text",
					"value": " from rendering:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"@/app/ui/component.tsx\"",
			"value": "import { notFound } from 'next/navigation'\n\nexport default async function Page() {\n\ttry {\n\t\tconst post = await fetch('https://.../posts/1').then((res) => {\n\t\t\tif (res.status === 404) notFound()\n\t\t\tif (!res.ok) throw new Error(res.statusText)\n\t\t\treturn res.json()\n\t\t})\n\t} catch (err) {\n\t\tconsole.error(err)\n\t}\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "You can use "
				},
				{
					"type": "inlineCode",
					"value": "unstable_rethrow"
				},
				{
					"type": "text",
					"value": " API to re-throw the internal error and continue with the expected behavior:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"@/app/ui/component.tsx\"",
			"value": "import { notFound, unstable_rethrow } from 'next/navigation'\n\nexport default async function Page() {\n\ttry {\n\t\tconst post = await fetch('https://.../posts/1').then((res) => {\n\t\t\tif (res.status === 404) notFound()\n\t\t\tif (!res.ok) throw new Error(res.statusText)\n\t\t\treturn res.json()\n\t\t})\n\t} catch (err) {\n\t\tunstable_rethrow(err)\n\t\tconsole.error(err)\n\t}\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The following Next.js APIs rely on throwing an error which should be rethrown and handled by Next.js itself:"
				}
			]
		},
