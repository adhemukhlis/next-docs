							"checked": null,
							"children": [
								{
									"type": "paragraph",
									"children": [
										{
											"type": "text",
											"value": "This method should be called at the top of the catch block, passing the error object as its only argument. It can also be used within a "
										},
										{
											"type": "inlineCode",
											"value": ".catch"
										},
										{
											"type": "text",
											"value": " handler of a promise."
										}
									]
								}
							]
						},
						{
							"type": "listItem",
							"spread": false,
							"checked": null,
							"children": [
								{
									"type": "paragraph",
									"children": [
										{
											"type": "text",
											"value": "You may be able to avoid using "
										},
										{
											"type": "inlineCode",
											"value": "unstable_rethrow"
										},
										{
											"type": "text",
											"value": " if you encapsulate your API calls that throw and let the "
										},
										{
											"type": "strong",
											"children": [
												{
													"type": "text",
													"value": "caller"
												}
											]
										},
										{
											"type": "text",
											"value": " handle the exception."
										}
									]
								}
							]
						},
						{
							"type": "listItem",
							"spread": false,
							"checked": null,
							"children": [
								{
									"type": "paragraph",
									"children": [
										{
											"type": "text",
											"value": "Only use "
										},
										{
											"type": "inlineCode",
											"value": "unstable_rethrow"
										},
										{
											"type": "text",
											"value": " if your caught exceptions may include both application errors and framework-controlled exceptions (like "
										},
										{
											"type": "inlineCode",
											"value": "redirect()"
										},
										{
											"type": "text",
											"value": " or "
										},
										{
											"type": "inlineCode",
											"value": "notFound()"
										},
										{
											"type": "text",
											"value": ")."
										}
									]
								}
							]
						},
						{
							"type": "listItem",
							"spread": false,
							"checked": null,
							"children": [
								{
									"type": "paragraph",
									"children": [
										{
											"type": "text",
											"value": "Any resource cleanup (like clearing intervals, timers, etc) would have to either happen prior to the call to "
										},
										{
											"type": "inlineCode",
											"value": "unstable_rethrow"
										},
										{
											"type": "text",
											"value": " or within a "
										},
										{
											"type": "inlineCode",
											"value": "finally"
										},
										{
											"type": "text",
											"value": " block."
										}
									]
								}
							]
						}
