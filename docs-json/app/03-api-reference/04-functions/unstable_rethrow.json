							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know"
								}
							]
						},
						{
							"type": "text",
							"value": ":"
						}
					]
				},
				{
					"type": "list",
					"ordered": false,
					"start": null,
					"spread": false,
					"children": [
