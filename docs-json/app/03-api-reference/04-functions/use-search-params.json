					"type": "link",
					"title": null,
					"url": "./cookies.md",
					"children": [
						{
							"type": "inlineCode",
							"value": "cookies()"
						}
					]
				},
				{
					"type": "text",
					"value": ", Next.js renders the boundary on the server at request time with the real search params. To keep a component that reads browser-only APIs, such as "
				},
				{
					"type": "inlineCode",
					"value": "sessionStorage"
				},
				{
					"type": "text",
					"value": ", out of the server render, use "
