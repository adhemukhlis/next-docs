		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Avoid hydration mismatch with rewrites"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "When a page is prerendered, the HTML is generated for its path, such as "
				},
				{
					"type": "inlineCode",
					"value": "/blog/hello"
				},
				{
					"type": "text",
					"value": " for "
				},
				{
					"type": "inlineCode",
					"value": "app/blog/[slug]/page.tsx"
				},
				{
					"type": "text",
					"value": ". If a rewrite in "
				},
				{
					"type": "inlineCode",
					"value": "next.config"
				},
				{
					"type": "text",
					"value": " or "
				},
				{
					"type": "inlineCode",
					"value": "Proxy"
				},
