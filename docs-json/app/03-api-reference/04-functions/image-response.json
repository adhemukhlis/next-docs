					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Maximum bundle size of "
								},
								{
									"type": "inlineCode",
									"value": "500KB"
								},
								{
									"type": "text",
									"value": ". The bundle size includes your JSX, CSS, fonts, images, and any other assets. If you exceed the limit, consider reducing the size of any assets or fetching at runtime."
