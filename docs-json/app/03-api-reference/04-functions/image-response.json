									"type": "inlineCode",
									"value": "woff"
								},
								{
									"type": "text",
									"value": " font formats are supported. To maximize the font parsing speed, "
								},
								{
									"type": "inlineCode",
									"value": "ttf"
								},
								{
									"type": "text",
									"value": " or "
