			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "You can use custom fonts in your "
				},
				{
					"type": "inlineCode",
					"value": "ImageResponse"
				},
				{
					"type": "text",
					"value": " by providing a "
				},
				{
					"type": "inlineCode",
					"value": "fonts"
				},
				{
					"type": "text",
					"value": " array in the options. The font doesn't depend on request data, so read it once at module scope. See "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/getting-started/caching#predictable-values",
					"children": [
