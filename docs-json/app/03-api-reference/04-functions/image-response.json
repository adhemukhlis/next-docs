			"type": "yaml",
			"value": "title: ImageResponse\ndescription: API Reference for the ImageResponse constructor."
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The "
				},
				{
					"type": "inlineCode",
					"value": "ImageResponse"
				},
				{
					"type": "text",
					"value": " constructor allows you to generate dynamic images using JSX and CSS. This is useful for generating social media images such as Open Graph images, Twitter cards, and more."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
