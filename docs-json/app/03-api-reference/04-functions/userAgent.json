				{
					"type": "text",
					"value": " with additional properties and methods to interact with the user agent object from the request."
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": "filename=\"proxy.ts\" switcher",
			"value": "import { NextRequest, NextResponse, userAgent } from 'next/server'\n\nexport function proxy(request: NextRequest) {\n\tconst url = request.nextUrl\n\tconst { device } = userAgent(request)\n\n\t// device.type can be: 'mobile', 'tablet', 'console', 'smarttv',\n\t// 'wearable', 'embedded', or undefined (for desktop browsers)\n\tconst viewport = device.type || 'desktop'\n\n\turl.searchParams.set('viewport', viewport)\n\treturn NextResponse.rewrite(url)\n}"
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"proxy.js\" switcher",
			"value": "import { NextResponse, userAgent } from 'next/server'\n\nexport function proxy(request) {\n\tconst url = request.nextUrl\n\tconst { device } = userAgent(request)\n\n\t// device.type can be: 'mobile', 'tablet', 'console', 'smarttv',\n\t// 'wearable', 'embedded', or undefined (for desktop browsers)\n\tconst viewport = device.type || 'desktop'\n\n\turl.searchParams.set('viewport', viewport)\n\treturn NextResponse.rewrite(url)\n}"
		},
