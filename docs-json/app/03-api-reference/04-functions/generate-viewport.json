				},
				{
					"type": "text",
					"value": " is enabled, "
				},
				{
					"type": "inlineCode",
					"value": "generateViewport"
				},
				{
					"type": "text",
					"value": " follows the same rules as other components. If viewport accesses runtime data ("
				},
				{
					"type": "inlineCode",
					"value": "cookies()"
				},
				{
					"type": "text",
					"value": ", "
				},
				{
					"type": "inlineCode",
					"value": "headers()"
				},
				{
					"type": "text",
					"value": ", "
				},
				{
					"type": "inlineCode",
					"value": "params"
				},
				{
					"type": "text",
					"value": ", "
				},
				{
					"type": "inlineCode",
					"value": "searchParams"
				},
				{
					"type": "text",
					"value": ") or performs uncached data fetching, it defers to request time."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Unlike metadata, viewport cannot be streamed because it affects initial page load UI. If "
				},
				{
					"type": "inlineCode",
					"value": "generateViewport"
				},
				{
					"type": "text",
					"value": " defers to request time, the page would need to block until resolved."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "If viewport depends on external data but not runtime data, use "
				},
				{
					"type": "inlineCode",
					"value": "use cache"
				},
				{
					"type": "text",
					"value": ":"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/layout.tsx\" highlight={2}",
			"value": "export async function generateViewport() {\n\t'use cache'\n\tconst { width, initialScale } = await db.query('viewport-size')\n\treturn { width, initialScale }\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "If viewport genuinely requires runtime data, wrap the document "
				},
				{
					"type": "inlineCode",
					"value": "<body>"
				},
				{
					"type": "text",
					"value": " in a "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://react.dev/reference/react/Suspense",
					"children": [
						{
							"type": "inlineCode",
							"value": "<Suspense>"
						}
					]
				},
				{
					"type": "text",
					"value": " boundary to signal that the entire route should be dynamic. The shell ships immediately and the document streams in once the viewport resolves:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/layout.tsx\" highlight={1,13,17}",
			"value": "import { Suspense } from 'react'\nimport { cookies } from 'next/headers'\n\nexport async function generateViewport() {\n\tconst cookieJar = await cookies()\n\treturn {\n\t\tthemeColor: cookieJar.get('theme-color')?.value,\n\t}\n}\n\nexport default function RootLayout({ children }) {\n\treturn (\n\t\t<Suspense>\n\t\t\t<html>\n\t\t\t\t<body>{children}</body>\n\t\t\t</html>\n\t\t</Suspense>\n\t)\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Alternatively, opt the segment out of instant-navigation validation with "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-file-conventions/02-route-segment-config/instant.md",
					"children": [
						{
							"type": "inlineCode",
							"value": "instant = false"
						}
					]
				},
				{
					"type": "text",
					"value": ". The route renders on every request and the navigation blocks until the render completes:"
				}
			]
		},
		{
			"type": "code",
