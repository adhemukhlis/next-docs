			"children": [
				{
					"type": "text",
					"value": "With Cache Components"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "When "
				},
				{
					"type": "link",
					"title": null,
					"url": "../../01-getting-started/08-caching.md",
