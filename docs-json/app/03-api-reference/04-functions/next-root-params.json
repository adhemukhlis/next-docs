				{
					"type": "link",
					"title": null,
					"url": "../../04-glossary.md#server-component",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Server Components"
								}
							]
						}
					]
				},
				{
					"type": "text",
					"value": ". Each root parameter is exported as an async function that resolves to the parameter value for the current route."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The export names are generated from your dynamic segment folder names. For example, if your root layout is inside "
