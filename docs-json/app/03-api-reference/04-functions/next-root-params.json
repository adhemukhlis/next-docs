				{
					"type": "inlineCode",
					"value": "app/[locale]"
				},
				{
					"type": "text",
					"value": ", you import "
				},
				{
					"type": "inlineCode",
					"value": "locale"
				},
				{
					"type": "text",
					"value": " from "
				},
				{
					"type": "inlineCode",
					"value": "next/root-params"
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "This is useful for values like a language or locale segment that need to be accessed across your application, for example in shared utilities, layouts, and deeply nested components, without passing them down as props."
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/[lang]/layout.tsx\" highlight={1,5} switcher",
			"value": "import { lang } from 'next/root-params'\n\nexport default async function RootLayout(props: LayoutProps<'/[lang]'>) {\n\treturn (\n\t\t<html lang={await lang()}>\n\t\t\t<body>{props.children}</body>\n\t\t</html>\n\t)\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/[lang]/layout.js\" highlight={1,5} switcher",
			"value": "import { lang } from 'next/root-params'\n\nexport default async function RootLayout({ children }) {\n\treturn (\n\t\t<html lang={await lang()}>\n\t\t\t<body>{children}</body>\n\t\t</html>\n\t)\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Root parameters are the "
