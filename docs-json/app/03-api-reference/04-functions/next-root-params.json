		},
		{
			"type": "code",
			"lang": "txt",
			"meta": null,
			"value": "app/\n  [lang]/              ← root parameter (shared by all routes below)\n    layout.tsx         ← root layout\n    page.tsx           ← has no slug, doesn't know about blog or store\n    blog/\n      [slug]/          ← route parameter\n        page.tsx\n    store/\n      [...slug]/       ← catch-all route parameter with the same name\n        page.tsx"
