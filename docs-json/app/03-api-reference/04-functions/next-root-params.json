		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Behavior with caching directives"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Because root parameter getters are imported functions, Next.js can track which ones a "
				},
				{
					"type": "link",
					"title": null,
					"url": "../01-directives/use-cache.md",
					"children": [
						{
							"type": "text",
							"value": "cached"
						}
					]
				},
				{
					"type": "text",
					"value": " function uses. Only those root parameters become part of the "
				},
				{
					"type": "link",
					"title": null,
					"url": "../01-directives/use-cache.md#cache-keys",
					"children": [
						{
							"type": "text",
							"value": "cache key"
						}
					]
				},
				{
					"type": "text",
					"value": ", so cache entries are not split across unrelated parameter values."
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/[lang]/components/cached-nav.tsx\" highlight={7} switcher",
			"value": "import { lang } from 'next/root-params'\n\n// The cache key for this function only includes `lang`,\n// not every dynamic segment in the route.\nasync function getNavigation() {\n\t'use cache'\n\tconst language = await lang()\n\tconst res = await fetch(`https://api.example.com/nav?lang=${language}`)\n\treturn res.json()\n}\n\nexport default async function CachedNav() {\n\tconst nav = await getNavigation()\n\treturn <nav>{/* render nav items */}</nav>\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/[lang]/components/cached-nav.js\" highlight={7} switcher",
			"value": "import { lang } from 'next/root-params'\n\n// The cache key for this function only includes `lang`,\n// not every dynamic segment in the route.\nasync function getNavigation() {\n\t'use cache'\n\tconst language = await lang()\n\tconst res = await fetch(`https://api.example.com/nav?lang=${language}`)\n\treturn res.json()\n}\n\nexport default async function CachedNav() {\n\tconst nav = await getNavigation()\n\treturn <nav>{/* render nav items */}</nav>\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "With the regular "
