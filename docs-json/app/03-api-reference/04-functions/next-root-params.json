			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Root parameters are the route parameters from "
				},
				{
					"type": "link",
					"title": null,
					"url": "../../04-glossary.md#dynamic-route-segments",
					"children": [
						{
							"type": "text",
							"value": "dynamic segments"
						}
					]
				},
				{
					"type": "text",
					"value": " that appear in the path up to the root layout file. Other route parameters deeper in the route tree are accessed through the "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-file-conventions/page.md#params-optional",
					"children": [
						{
							"type": "inlineCode",
							"value": "params"
						},
						{
							"type": "text",
							"value": " prop"
						}
					]
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Given this file structure:"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
