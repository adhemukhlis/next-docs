			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/[lang]/posts/[slug]/page.tsx\" highlight={1,7} switcher",
			"value": "import { lang } from 'next/root-params'\n\nexport default async function PostPage(props: PageProps<'/[lang]/posts/[slug]'>) {\n\tconst { slug } = await props.params\n\tconst language = await lang()\n\n\treturn (\n\t\t<article>\n\t\t\t<p>Language: {language}</p>\n\t\t\t<p>Post: {slug}</p>\n\t\t</article>\n\t)\n}"
