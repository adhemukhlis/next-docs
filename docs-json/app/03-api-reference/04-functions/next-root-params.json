			"meta": "filename=\"app/[lang]/posts/[slug]/page.js\" highlight={1,5} switcher",
			"value": "import { lang } from 'next/root-params'\n\nexport default async function PostPage({ params }) {\n\tconst { slug } = await params\n\tconst language = await lang()\n\n\treturn (\n\t\t<article>\n\t\t\t<p>Language: {language}</p>\n\t\t\t<p>Post: {slug}</p>\n\t\t</article>\n\t)\n}"
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Accessing root parameters in shared code"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Root parameter getters are module imports, they can be called from any Server Component or server-side utility, not just layouts and pages:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"lib/get-translations.ts\" highlight={4}",
			"value": "import { lang } from 'next/root-params'\n\nexport async function getTranslations() {\n\tconst language = await lang()\n\t// Load translations based on the root language parameter\n\treturn import(`@/locales/${language}.json`)\n}"
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know:"
