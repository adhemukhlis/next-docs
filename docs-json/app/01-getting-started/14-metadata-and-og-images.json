					"type": "inlineCode",
					"value": "opengraph-image.jpg"
				},
				{
					"type": "text",
					"value": " deeper down the folder structure. For example, to create an OG image specific to the "
				},
				{
					"type": "inlineCode",
					"value": "/blog"
				},
				{
					"type": "text",
					"value": " route, add a "
				},
