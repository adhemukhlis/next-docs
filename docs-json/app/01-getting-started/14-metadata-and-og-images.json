					"value": "<Image\nalt=\"OG image special file inside the App folder with sibling layout and page files\"\nsrcLight=\"/docs/light/opengraph-image.png\"\nsrcDark=\"/docs/dark/opengraph-image.png\"\nwidth=\"1600\"\nheight=\"444\"\n/>"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "You can also add OG images for specific routes by creating a "
				},
