				{
					"type": "inlineCode",
					"value": "blog/[slug]"
				},
				{
					"type": "text",
					"value": " folder, and import the "
				},
				{
					"type": "inlineCode",
					"value": "ImageResponse"
				},
				{
					"type": "text",
					"value": " constructor from "
				},
				{
					"type": "inlineCode",
					"value": "next/og"
				},
				{
					"type": "text",
					"value": ":"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/blog/[slug]/opengraph-image.tsx\" switcher",
			"value": "import { ImageResponse } from 'next/og'\nimport { getPost } from '@/app/lib/data'\n\n// Image metadata\nexport const size = {\n\twidth: 1200,\n\theight: 630,\n}\n\nexport const contentType = 'image/png'\n\n// Image generation\nexport default async function Image({ params }: { params: Promise<{ slug: string }> }) {\n\tconst { slug } = await params\n\tconst post = await getPost(slug)\n\n\treturn new ImageResponse(\n\t\t// ImageResponse JSX element\n\t\t<div\n\t\t\tstyle={{\n\t\t\t\tfontSize: 128,\n\t\t\t\tbackground: 'white',\n\t\t\t\twidth: '100%',\n\t\t\t\theight: '100%',\n\t\t\t\tdisplay: 'flex',\n\t\t\t\talignItems: 'center',\n\t\t\t\tjustifyContent: 'center',\n\t\t\t}}>\n\t\t\t{post.title}\n\t\t</div>,\n\t)\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/blog/[slug]/opengraph-image.js\" switcher",
			"value": "import { ImageResponse } from 'next/og'\nimport { getPost } from '@/app/lib/data'\n\n// Image metadata\nexport const size = {\n\twidth: 1200,\n\theight: 630,\n}\n\nexport const contentType = 'image/png'\n\n// Image generation\nexport default async function Image({ params }) {\n\tconst { slug } = await params\n\tconst post = await getPost(slug)\n\n\treturn new ImageResponse(\n\t\t// ImageResponse JSX element\n\t\t<div\n\t\t\tstyle={{\n\t\t\t\tfontSize: 128,\n\t\t\t\tbackground: 'white',\n\t\t\t\twidth: '100%',\n\t\t\t\theight: '100%',\n\t\t\t\tdisplay: 'flex',\n\t\t\t\talignItems: 'center',\n\t\t\t\tjustifyContent: 'center',\n\t\t\t}}>\n\t\t\t{post.title}\n\t\t</div>,\n\t)\n}"
		},
