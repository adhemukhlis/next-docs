		{
			"type": "code",
			"lang": "json",
			"meta": "filename=\"package.json\"",
			"value": "{\n\t\"scripts\": {\n\t\t\"dev\": \"next dev\",\n\t\t\"build\": \"next build\",\n\t\t\"start\": \"next start\",\n\t\t\"lint\": \"eslint\",\n\t\t\"lint:fix\": \"eslint --fix\"\n\t}\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "These scripts refer to the different stages of developing an application:"
