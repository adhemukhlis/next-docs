					"value": " and run "
				},
				{
					"type": "inlineCode",
					"value": "next dev"
				},
				{
					"type": "text",
					"value": ". Next.js will automatically install the necessary dependencies and add a "
				},
				{
					"type": "inlineCode",
					"value": "tsconfig.json"
				},
				{
					"type": "text",
					"value": " file with the recommended config options."
