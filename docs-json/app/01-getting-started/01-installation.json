							"type": "text",
							"value": " scripts."
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "See the "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/05-config/03-eslint.md",
					"children": [
						{
							"type": "text",
							"value": "ESLint Plugin"
						}
					]
				},
				{
					"type": "text",
					"value": " reference for more information."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Set up Absolute Imports and Module Path Aliases"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Next.js has in-built support for the "
				},
				{
					"type": "inlineCode",
					"value": "\"paths\""
				},
				{
					"type": "text",
					"value": " and "
				},
				{
					"type": "inlineCode",
					"value": "\"baseUrl\""
				},
				{
					"type": "text",
					"value": " options of "
				},
				{
					"type": "inlineCode",
					"value": "tsconfig.json"
				},
				{
					"type": "text",
					"value": " and "
				},
				{
					"type": "inlineCode",
					"value": "jsconfig.json"
				},
				{
					"type": "text",
					"value": " files."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "These options allow you to alias project directories to absolute paths, making it easier and cleaner to import modules. For example:"
				}
			]
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": null,
			"value": "// Before\nimport { Button } from '../../../components/button'\n\n// After\nimport { Button } from '@/components/button'"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To configure absolute imports, add the "
				},
				{
					"type": "inlineCode",
					"value": "baseUrl"
				},
				{
					"type": "text",
					"value": " configuration option to your "
				},
				{
					"type": "inlineCode",
					"value": "tsconfig.json"
				},
				{
					"type": "text",
					"value": " or "
				},
				{
					"type": "inlineCode",
					"value": "jsconfig.json"
				},
				{
					"type": "text",
					"value": " file. For example:"
				}
			]
		},
		{
			"type": "code",
			"lang": "json",
			"meta": "filename=\"tsconfig.json or jsconfig.json\"",
			"value": "{\n\t\"compilerOptions\": {\n\t\t\"baseUrl\": \"src/\"\n\t}\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "In addition to configuring the "
				},
				{
					"type": "inlineCode",
					"value": "baseUrl"
				},
				{
					"type": "text",
					"value": " path, you can use the "
				},
				{
					"type": "inlineCode",
					"value": "\"paths\""
				},
				{
					"type": "text",
					"value": " option to "
				},
				{
					"type": "inlineCode",
					"value": "\"alias\""
				},
				{
					"type": "text",
					"value": " module paths."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "For example, the following configuration maps "
				},
				{
					"type": "inlineCode",
					"value": "@/components/*"
				},
				{
					"type": "text",
					"value": " to "
				},
				{
					"type": "inlineCode",
					"value": "components/*"
				},
				{
					"type": "text",
					"value": ":"
				}
			]
		},
		{
			"type": "code",
			"lang": "json",
			"meta": "filename=\"tsconfig.json or jsconfig.json\"",
			"value": "{\n\t\"compilerOptions\": {\n\t\t\"baseUrl\": \"src/\",\n\t\t\"paths\": {\n\t\t\t\"@/styles/*\": [\"styles/*\"],\n\t\t\t\"@/components/*\": [\"components/*\"]\n\t\t}\n\t}\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Each of the "
				},
				{
					"type": "inlineCode",
					"value": "\"paths\""
				},
				{
					"type": "text",
					"value": " are relative to the "
				},
				{
					"type": "inlineCode",
					"value": "baseUrl"
				},
				{
					"type": "text",
					"value": " location."
				}
			]
		}
	]
}
