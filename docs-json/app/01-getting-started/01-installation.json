								{
									"type": "inlineCode",
									"value": "next build"
								},
								{
									"type": "text",
									"value": ": Builds the application for production."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "inlineCode",
									"value": "next start"
								},
								{
									"type": "text",
									"value": ": Starts the production server."
