			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/layout.tsx\" switcher",
			"value": "export default function RootLayout({ children }: { children: React.ReactNode }) {\n\treturn (\n\t\t<html lang=\"en\">\n\t\t\t<body>{children}</body>\n\t\t</html>\n\t)\n}"
		},
