					"type": "list",
					"ordered": false,
					"start": null,
					"spread": false,
					"children": [
						{
							"type": "listItem",
							"spread": false,
							"checked": null,
							"children": [
								{
									"type": "paragraph",
									"children": [
										{
											"type": "text",
											"value": "The "
										},
										{
											"type": "inlineCode",
											"value": "App Router"
										},
										{
											"type": "text",
											"value": " uses "
										},
										{
											"type": "link",
											"title": null,
											"url": "https://react.dev/blog/2023/05/03/react-canaries",
											"children": [
												{
													"type": "text",
													"value": "React canary releases"
												}
											]
										},
										{
											"type": "text",
											"value": " built-in, which include all the stable React 19 changes, as well as newer features being validated in frameworks, but you should still declare react and react-dom in package.json for tooling and ecosystem compatibility."
										}
									]
								}
							]
						},
						{
							"type": "listItem",
							"spread": false,
							"checked": null,
							"children": [
								{
									"type": "paragraph",
									"children": [
										{
											"type": "text",
											"value": "The "
										},
										{
											"type": "inlineCode",
											"value": "Pages Router"
										},
										{
											"type": "text",
											"value": " uses the React version from your "
										},
										{
											"type": "inlineCode",
											"value": "package.json"
										},
										{
											"type": "text",
											"value": "."
										}
									]
								}
							]
