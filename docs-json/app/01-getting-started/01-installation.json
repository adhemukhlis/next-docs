			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To manually create a new Next.js app, install the required packages:"
				}
			]
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"pnpm\"",
			"value": "pnpm i next@latest react@latest react-dom@latest"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"npm\"",
			"value": "npm i next@latest react@latest react-dom@latest"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"yarn\"",
			"value": "yarn add next@latest react@latest react-dom@latest"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"bun\"",
			"value": "bun add next@latest react@latest react-dom@latest"
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know"
