			"value": "title: Installation\ndescription: Check the system requirements, create a Next.js App Router app with `create-next-app`, run the development server, and review the generated project."
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Create a new Next.js app and run it locally."
				}
			]
		},
