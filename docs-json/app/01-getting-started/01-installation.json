			"type": "yaml",
			"value": "title: Installation\ndescription: Create a Next.js App Router app with `create-next-app`, structure the `app` and `public` directories, run the development server, and set up TypeScript, linting, and module path aliases."
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Create a new Next.js app and run it locally."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Quick start"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Create a Next.js app named "
				},
				{
					"type": "inlineCode",
					"value": "my-app"
				},
				{
					"type": "text",
					"value": " with explicit options, then start the development server on "
				},
				{
					"type": "inlineCode",
					"value": "http://localhost:3000"
				},
				{
					"type": "text",
					"value": ":"
				}
			]
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"pnpm\"",
			"value": "pnpm create next-app my-app \\\n  --app \\\n  --src-dir \\\n  --typescript \\\n  --import-alias \"@/*\" \\\n  --turbopack \\\n  --cache-components \\\n  --react-compiler \\\n  --biome \\\n  --tailwind \\\n  --use-pnpm\ncd my-app\npnpm dev"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"npm\"",
			"value": "npx create-next-app@latest my-app \\\n  --app \\\n  --src-dir \\\n  --typescript \\\n  --import-alias \"@/*\" \\\n  --turbopack \\\n  --cache-components \\\n  --react-compiler \\\n  --biome \\\n  --tailwind \\\n  --use-npm\ncd my-app\nnpm run dev"
		},
