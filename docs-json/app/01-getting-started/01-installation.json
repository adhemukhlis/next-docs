		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Set up your editor"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The App Router names files by convention, like "
				},
				{
					"type": "inlineCode",
					"value": "page.tsx"
				},
				{
					"type": "text",
					"value": ", "
				},
				{
					"type": "inlineCode",
					"value": "layout.tsx"
				},
				{
					"type": "text",
					"value": ", and "
				},
				{
					"type": "inlineCode",
					"value": "route.ts"
				},
				{
					"type": "text",
					"value": ", so your editor quickly fills with same-named tabs. Label each tab with its enclosing folders, like "
				},
				{
					"type": "inlineCode",
					"value": "blog/[id]"
				},
				{
					"type": "text",
					"value": ", so you can tell them apart."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "In VS Code 1.88+ or Cursor, add "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://code.visualstudio.com/updates/v1_88#_customize-editor-labels",
					"children": [
						{
							"type": "text",
							"value": "custom editor labels"
						}
					]
				},
				{
					"type": "text",
					"value": " to "
				},
				{
					"type": "inlineCode",
					"value": ".vscode/settings.json"
				},
				{
					"type": "text",
					"value": ". Labeling two folders deep keeps dynamic routes like "
				},
				{
					"type": "inlineCode",
					"value": "blog/[id]/page.tsx"
				},
				{
					"type": "text",
					"value": " from all collapsing to the same "
				},
				{
					"type": "inlineCode",
					"value": "[id]"
				},
				{
					"type": "text",
					"value": " label:"
				}
			]
		},
		{
			"type": "code",
			"lang": "json",
			"meta": "filename=\".vscode/settings.json\"",
			"value": "{\n\t\"workbench.editor.customLabels.patterns\": {\n\t\t\"**/app/**/page.tsx\": \"${dirname(1)}/${dirname} - page.tsx\",\n\t\t\"**/app/**/layout.tsx\": \"${dirname(1)}/${dirname} - layout.tsx\",\n\t\t\"**/app/**/loading.tsx\": \"${dirname(1)}/${dirname} - loading.tsx\",\n\t\t\"**/app/**/error.tsx\": \"${dirname(1)}/${dirname} - error.tsx\",\n\t\t\"**/app/**/not-found.tsx\": \"${dirname(1)}/${dirname} - not-found.tsx\",\n\t\t\"**/app/**/template.tsx\": \"${dirname(1)}/${dirname} - template.tsx\",\n\t\t\"**/app/**/default.tsx\": \"${dirname(1)}/${dirname} - default.tsx\",\n\t\t\"**/app/**/route.ts\": \"${dirname(1)}/${dirname} - route.ts\"\n\t}\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Or copy this prompt to have your coding agent set it up:"
				}
			]
		},
		{
			"type": "code",
			"lang": "prompt",
			"meta": null,
			"value": "Set up custom editor labels so my Next.js App Router files are easy to tell apart. Read https://nextjs.org/docs/app/getting-started/installation#set-up-your-editor and add the workbench.editor.customLabels.patterns config shown there to my .vscode/settings.json, creating the file if it doesn't exist. Adjust the labels to taste. If I use a different editor, apply the equivalent setting or tell me it's automatic, and leave my other settings untouched."
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know:"
								}
							]
						},
						{
							"type": "text",
							"value": " JetBrains IDEs (WebStorm, IntelliJ) show the folder for same-named files automatically, so no setup is needed."
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Set up linting"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Next.js supports linting with either ESLint or Biome. Choose a linter and run it directly via "
				},
				{
					"type": "inlineCode",
					"value": "package.json"
				},
				{
					"type": "text",
					"value": " scripts."
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Use "
								},
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "ESLint"
										}
									]
								},
								{
									"type": "text",
									"value": " (comprehensive rules):"
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "code",
			"lang": "json",
			"meta": "filename=\"package.json\"",
			"value": "{\n\t\"scripts\": {\n\t\t\"lint\": \"eslint\",\n\t\t\"lint:fix\": \"eslint --fix\"\n\t}\n}"
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Or use "
								},
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "Biome"
										}
									]
								},
								{
									"type": "text",
									"value": " (fast linter + formatter):"
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "code",
			"lang": "json",
			"meta": "filename=\"package.json\"",
			"value": "{\n\t\"scripts\": {\n\t\t\"lint\": \"biome check\",\n\t\t\"format\": \"biome format --write\"\n\t}\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "If your project previously used "
				},
				{
					"type": "inlineCode",
					"value": "next lint"
				},
				{
					"type": "text",
					"value": ", migrate your scripts to the ESLint CLI with the codemod:"
				}
			]
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "filename=\"Terminal\"",
			"value": "npx @next/codemod@canary next-lint-to-eslint-cli ."
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "If you use ESLint, create an explicit config (recommended "
				},
				{
					"type": "inlineCode",
					"value": "eslint.config.mjs"
				},
				{
					"type": "text",
					"value": "). ESLint supports both "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://eslint.org/docs/latest/use/configure/configuration-files#configuring-eslint",
					"children": [
						{
							"type": "text",
							"value": "the legacy "
						},
						{
							"type": "inlineCode",
							"value": ".eslintrc.*"
						},
						{
							"type": "text",
							"value": " and the newer "
						},
						{
							"type": "inlineCode",
							"value": "eslint.config.mjs"
						},
						{
							"type": "text",
							"value": " formats"
						}
					]
				},
				{
					"type": "text",
					"value": ". See the "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/05-config/03-eslint.md#with-core-web-vitals",
					"children": [
						{
							"type": "text",
							"value": "ESLint API reference"
						}
					]
				},
				{
					"type": "text",
					"value": " for a recommended setup."
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know"
								}
							]
						},
						{
							"type": "text",
							"value": ": Starting with Next.js 16, "
						},
						{
							"type": "inlineCode",
							"value": "next build"
						},
						{
							"type": "text",
							"value": " no longer runs the linter automatically. Instead, you can run your linter through NPM scripts."
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "See the "
				},
				{
					"type": "link",
					"title": null,
					"url": "../03-api-reference/05-config/03-eslint.md",
					"children": [
						{
							"type": "text",
							"value": "ESLint Plugin"
						}
					]
				},
				{
					"type": "text",
					"value": " page for more information."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Set up Absolute Imports and Module Path Aliases"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Next.js has in-built support for the "
				},
				{
					"type": "inlineCode",
					"value": "\"paths\""
				},
				{
					"type": "text",
					"value": " and "
				},
				{
					"type": "inlineCode",
					"value": "\"baseUrl\""
				},
				{
					"type": "text",
					"value": " options of "
				},
				{
					"type": "inlineCode",
					"value": "tsconfig.json"
				},
				{
					"type": "text",
					"value": " and "
				},
				{
					"type": "inlineCode",
					"value": "jsconfig.json"
				},
				{
					"type": "text",
					"value": " files."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "These options allow you to alias project directories to absolute paths, making it easier and cleaner to import modules. For example:"
				}
			]
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": null,
			"value": "// Before\nimport { Button } from '../../../components/button'\n\n// After\nimport { Button } from '@/components/button'"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To configure absolute imports, add the "
				},
				{
					"type": "inlineCode",
					"value": "baseUrl"
				},
				{
					"type": "text",
					"value": " configuration option to your "
				},
				{
					"type": "inlineCode",
					"value": "tsconfig.json"
				},
				{
					"type": "text",
					"value": " or "
				},
				{
					"type": "inlineCode",
					"value": "jsconfig.json"
				},
				{
					"type": "text",
					"value": " file. For example:"
				}
			]
		},
		{
			"type": "code",
			"lang": "json",
			"meta": "filename=\"tsconfig.json or jsconfig.json\"",
			"value": "{\n\t\"compilerOptions\": {\n\t\t\"baseUrl\": \"src/\"\n\t}\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "In addition to configuring the "
				},
				{
					"type": "inlineCode",
					"value": "baseUrl"
				},
				{
					"type": "text",
					"value": " path, you can use the "
				},
				{
					"type": "inlineCode",
					"value": "\"paths\""
				},
				{
					"type": "text",
					"value": " option to "
				},
				{
					"type": "inlineCode",
					"value": "\"alias\""
				},
				{
					"type": "text",
					"value": " module paths."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "For example, the following configuration maps "
				},
				{
					"type": "inlineCode",
					"value": "@/components/*"
				},
				{
					"type": "text",
					"value": " to "
				},
				{
					"type": "inlineCode",
					"value": "components/*"
				},
				{
					"type": "text",
					"value": ":"
				}
			]
		},
		{
			"type": "code",
			"lang": "json",
			"meta": "filename=\"tsconfig.json or jsconfig.json\"",
			"value": "{\n\t\"compilerOptions\": {\n\t\t\"baseUrl\": \"src/\",\n\t\t\"paths\": {\n\t\t\t\"@/styles/*\": [\"styles/*\"],\n\t\t\t\"@/components/*\": [\"components/*\"]\n\t\t}\n\t}\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Each of the "
				},
				{
					"type": "inlineCode",
					"value": "\"paths\""
				},
				{
					"type": "text",
					"value": " are relative to the "
				},
				{
					"type": "inlineCode",
					"value": "baseUrl"
				},
				{
					"type": "text",
					"value": " location."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Upgrade your Next.js app"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Keep your Next.js version up to date. Each release ships security patches, bug fixes, and performance optimizations alongside new features, and staying current keeps every individual upgrade small. Run the "
				},
				{
					"type": "inlineCode",
					"value": "upgrade"
				},
				{
					"type": "text",
					"value": " command:"
				}
			]
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"pnpm\"",
			"value": "pnpm next upgrade"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"npm\"",
			"value": "npx next upgrade"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"yarn\"",
			"value": "yarn next upgrade"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"bun\"",
			"value": "bunx next upgrade"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Upgrading also updates the documentation bundled inside the "
				},
				{
					"type": "inlineCode",
					"value": "next"
				},
				{
					"type": "text",
					"value": " package at "
				},
				{
					"type": "inlineCode",
					"value": "node_modules/next/dist/docs/"
				},
				{
					"type": "text",
					"value": ". New features arrive with their docs, and existing pages pick up new guidance and pitfalls discovered along the way. "
				},
				{
					"type": "link",
					"title": null,
					"url": "../02-guides/ai-agents.md",
					"children": [
						{
							"type": "text",
							"value": "AI coding agents"
						}
					]
				},
				{
					"type": "text",
					"value": " in your project then work from the version you have installed rather than their training data."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To have a coding agent perform and verify the upgrade, run "
				},
				{
					"type": "inlineCode",
					"value": "npx next@canary upgrade --agent=latest"
				},
				{
					"type": "text",
					"value": ". See "
				},
				{
					"type": "link",
					"title": null,
					"url": "../02-guides/upgrading/agent-upgrade.md",
					"children": [
						{
							"type": "text",
							"value": "Upgrade with a coding agent"
						}
					]
				},
				{
					"type": "text",
					"value": " for other policies."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "See "
				},
				{
					"type": "link",
					"title": null,
					"url": "./18-upgrading.md",
					"children": [
						{
							"type": "text",
							"value": "Upgrading"
						}
					]
				},
				{
					"type": "text",
					"value": " for version guides and manual upgrade steps, or the "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://preview.nextjs.org",
					"children": [
						{
							"type": "text",
							"value": "preview docs"
						}
					]
				},
				{
					"type": "text",
					"value": " to explore features before they ship in a stable version."
				}
			]
		}
	]
}
