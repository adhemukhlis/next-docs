					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "inlineCode",
									"value": "cd my-app"
								},
								{
									"type": "text",
									"value": " and start the dev server."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Visit "
