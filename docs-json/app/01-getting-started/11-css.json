								{
									"type": "inlineCode",
									"value": "link"
								},
								{
									"type": "text",
									"value": " documentation"
								}
							]
						},
						{
							"type": "text",
							"value": " for more information."
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Ordering and Merging"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Next.js optimizes CSS during production builds by automatically chunking (merging) stylesheets. The "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "order of your CSS"
						}
					]
				},
				{
					"type": "text",
					"value": " depends on the "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "order you import styles in your code"
						}
					]
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "For example, "
				},
				{
					"type": "inlineCode",
					"value": "base-button.module.css"
				},
				{
					"type": "text",
					"value": " will be ordered before "
				},
				{
					"type": "inlineCode",
					"value": "page.module.css"
				},
				{
					"type": "text",
					"value": " since "
				},
				{
					"type": "inlineCode",
					"value": "<BaseButton>"
				},
				{
					"type": "text",
					"value": " is imported before "
				},
				{
					"type": "inlineCode",
					"value": "page.module.css"
				},
				{
					"type": "text",
					"value": ":"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"page.tsx\" switcher",
			"value": "import { BaseButton } from './base-button'\nimport styles from './page.module.css'\n\nexport default function Page() {\n\treturn <BaseButton className={styles.primary} />\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"page.js\" switcher",
			"value": "import { BaseButton } from './base-button'\nimport styles from './page.module.css'\n\nexport default function Page() {\n\treturn <BaseButton className={styles.primary} />\n}"
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"base-button.tsx\" switcher",
			"value": "import styles from './base-button.module.css'\n\nexport function BaseButton() {\n\treturn <button className={styles.primary} />\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"base-button.js\" switcher",
			"value": "import styles from './base-button.module.css'\n\nexport function BaseButton() {\n\treturn <button className={styles.primary} />\n}"
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Recommendations"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To keep CSS ordering predictable:"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Try to contain CSS imports to a single JavaScript or TypeScript entry file"
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Import global styles and Tailwind stylesheets in the root of your application."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "Use Tailwind CSS"
										}
									]
								},
								{
									"type": "text",
									"value": " for most styling needs as it covers common design patterns with utility classes."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Use CSS Modules for component-specific styles when Tailwind utilities aren't sufficient."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
