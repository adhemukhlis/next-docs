		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Install Tailwind CSS:"
				}
			]
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"pnpm\"",
			"value": "pnpm add -D tailwindcss @tailwindcss/postcss"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"npm\"",
			"value": "npm install -D tailwindcss @tailwindcss/postcss"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"yarn\"",
			"value": "yarn add -D tailwindcss @tailwindcss/postcss"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"bun\"",
			"value": "bun add -D tailwindcss @tailwindcss/postcss"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Add the PostCSS plugin to your "
				},
				{
					"type": "inlineCode",
					"value": "postcss.config.mjs"
				},
				{
					"type": "text",
					"value": " file:"
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"postcss.config.mjs\"",
			"value": "export default {\n\tplugins: {\n\t\t'@tailwindcss/postcss': {},\n\t},\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Import Tailwind in your global CSS file:"
				}
			]
		},
		{
			"type": "code",
			"lang": "css",
			"meta": "filename=\"app/globals.css\"",
			"value": "@import 'tailwindcss';"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Import the CSS file in your root layout:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/layout.tsx\" switcher",
			"value": "import './globals.css'\n\nexport default function RootLayout({ children }: { children: React.ReactNode }) {\n\treturn (\n\t\t<html lang=\"en\">\n\t\t\t<body>{children}</body>\n\t\t</html>\n\t)\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/layout.js\" switcher",
			"value": "import './globals.css'\n\nexport default function RootLayout({ children }) {\n\treturn (\n\t\t<html lang=\"en\">\n\t\t\t<body>{children}</body>\n\t\t</html>\n\t)\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Now you can start using Tailwind's utility classes in your application:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/page.tsx\" switcher",
			"value": "export default function Page() {\n\treturn (\n\t\t<main className=\"flex min-h-screen flex-col items-center justify-between p-24\">\n\t\t\t<h1 className=\"text-4xl font-bold\">Welcome to Next.js!</h1>\n\t\t</main>\n\t)\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/page.js\" switcher",
			"value": "export default function Page() {\n\treturn (\n\t\t<main className=\"flex min-h-screen flex-col items-center justify-between p-24\">\n\t\t\t<h1 className=\"text-4xl font-bold\">Welcome to Next.js!</h1>\n\t\t</main>\n\t)\n}"
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know:"
								}
							]
						},
						{
							"type": "text",
							"value": " If you need broader browser support for very old browsers, see the "
						},
						{
							"type": "link",
							"title": null,
							"url": "/docs/app/guides/tailwind-v3-css",
							"children": [
								{
									"type": "text",
									"value": "Tailwind CSS v3 setup instructions"
								}
							]
						},
						{
							"type": "text",
							"value": "."
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "CSS Modules"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "CSS Modules locally scope CSS by generating unique class names. This allows you to use the same class in different files without worrying about naming collisions."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To start using CSS Modules, create a new file with the extension "
				},
				{
					"type": "inlineCode",
					"value": ".module.css"
				},
				{
					"type": "text",
					"value": " and import it into any component inside the "
				},
				{
					"type": "inlineCode",
					"value": "app"
				},
				{
					"type": "text",
					"value": " directory:"
				}
			]
		},
		{
			"type": "code",
			"lang": "css",
			"meta": "filename=\"app/blog/blog.module.css\"",
			"value": ".blog {\n\tpadding: 24px;\n}"
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/blog/page.tsx\" switcher",
			"value": "import styles from './blog.module.css'\n\nexport default function Page() {\n\treturn <main className={styles.blog}></main>\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/blog/page.js\" switcher",
			"value": "import styles from './blog.module.css'\n\nexport default function Page() {\n\treturn <main className={styles.blog}></main>\n}"
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Global CSS"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "You can use global CSS to apply styles across your application."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Create a "
				},
				{
					"type": "inlineCode",
					"value": "app/global.css"
				},
				{
					"type": "text",
					"value": " file and import it in the root layout to apply the styles to "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "every route"
						}
					]
				},
				{
					"type": "text",
					"value": " in your application:"
				}
			]
		},
		{
			"type": "code",
			"lang": "css",
			"meta": "filename=\"app/global.css\"",
			"value": "body {\n\tpadding: 20px 20px 60px;\n\tmax-width: 680px;\n\tmargin: 0 auto;\n}"
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/layout.tsx\" switcher",
			"value": "// These styles apply to every route in the application\nimport './global.css'\n\nexport default function RootLayout({ children }: { children: React.ReactNode }) {\n\treturn (\n\t\t<html lang=\"en\">\n\t\t\t<body>{children}</body>\n\t\t</html>\n\t)\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/layout.js\" switcher",
			"value": "// These styles apply to every route in the application\nimport './global.css'\n\nexport default function RootLayout({ children }) {\n\treturn (\n\t\t<html lang=\"en\">\n\t\t\t<body>{children}</body>\n\t\t</html>\n\t)\n}"
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know:"
								}
							]
						},
						{
							"type": "text",
							"value": " Global styles can be imported into any layout, page, or component inside the "
						},
						{
							"type": "inlineCode",
							"value": "app"
						},
						{
							"type": "text",
							"value": " directory. However, since Next.js uses React's built-in support for stylesheets to integrate with Suspense, this currently does not remove stylesheets as you navigate between routes which can lead to conflicts. We recommend using global styles for "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "truly"
								}
							]
						},
						{
							"type": "text",
							"value": " global CSS (like Tailwind's base styles), "
						},
						{
							"type": "link",
							"title": null,
							"url": "#tailwind-css",
							"children": [
								{
									"type": "text",
									"value": "Tailwind CSS"
								}
							]
						},
						{
							"type": "text",
							"value": " for component styling, and "
						},
						{
							"type": "link",
							"title": null,
							"url": "#css-modules",
							"children": [
								{
									"type": "text",
									"value": "CSS Modules"
								}
							]
						},
						{
							"type": "text",
							"value": " for custom scoped CSS when needed."
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "External stylesheets"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Stylesheets published by external packages can be imported anywhere in the "
				},
				{
					"type": "inlineCode",
					"value": "app"
				},
				{
					"type": "text",
					"value": " directory, including colocated components:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/layout.tsx\" switcher",
			"value": "import 'bootstrap/dist/css/bootstrap.css'\n\nexport default function RootLayout({ children }: { children: React.ReactNode }) {\n\treturn (\n\t\t<html lang=\"en\">\n\t\t\t<body className=\"container\">{children}</body>\n\t\t</html>\n\t)\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/layout.js\" switcher",
			"value": "import 'bootstrap/dist/css/bootstrap.css'\n\nexport default function RootLayout({ children }) {\n\treturn (\n\t\t<html lang=\"en\">\n\t\t\t<body className=\"container\">{children}</body>\n\t\t</html>\n\t)\n}"
		},
		{
			"type": "blockquote",
			"children": [
				{
