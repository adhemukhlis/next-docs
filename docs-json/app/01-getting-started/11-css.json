						{
							"type": "inlineCode",
							"value": "<link rel=\"stylesheet\" href=\"...\" />"
						},
						{
							"type": "text",
							"value": " can also be used. See the "
						},
						{
							"type": "link",
							"title": null,
							"url": "https://react.dev/reference/react-dom/components/link",
							"children": [
								{
									"type": "text",
