{
	"type": "root",
	"children": [
		{
			"type": "yaml",
			"value": "title: Upgrading\ndescription: Learn how to upgrade your Next.js application to the latest version or canary.\nrelated:\n title: Version guides\n description: See the version guides for in-depth upgrade instructions.\n links:\n  - app/guides/upgrading/version-16\n  - app/guides/upgrading/version-15\n  - app/guides/upgrading/version-14"
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Latest version"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To update to the latest version of Next.js, you can use the "
				},
				{
					"type": "inlineCode",
					"value": "upgrade"
				},
				{
					"type": "text",
					"value": " command:"
				}
			]
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"pnpm\"",
			"value": "pnpm next upgrade"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"npm\"",
			"value": "npx next upgrade"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"yarn\"",
			"value": "yarn next upgrade"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"bun\"",
			"value": "bunx next upgrade"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Versions before Next.js 16.1.0 do not support the "
				},
				{
					"type": "inlineCode",
					"value": "upgrade"
				},
				{
					"type": "text",
					"value": " command and need to use a separate package instead:"
				}
			]
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "filename=\"Terminal\"",
			"value": "npx @next/codemod@canary upgrade latest"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To have a coding agent perform and verify the upgrade, run:"
				}
			]
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "filename=\"Terminal\"",
			"value": "npx next@canary upgrade --agent=latest"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "See "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/guides/upgrading/agent-upgrade",
					"children": [
						{
							"type": "text",
							"value": "Upgrade with a coding agent"
						}
					]
				},
				{
					"type": "text",
					"value": " for other policies and upgrade reminders."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "If you prefer to upgrade manually, install the latest Next.js and React versions:"
				}
			]
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"pnpm\"",
			"value": "pnpm i next@latest react@latest react-dom@latest eslint-config-next@latest"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"npm\"",
			"value": "npm i next@latest react@latest react-dom@latest eslint-config-next@latest"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"yarn\"",
			"value": "yarn add next@latest react@latest react-dom@latest eslint-config-next@latest"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"bun\"",
			"value": "bun add next@latest react@latest react-dom@latest eslint-config-next@latest"
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Canary version"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To update to the latest canary, make sure you're on the latest version of Next.js and everything is working as expected. Then, run the following command:"
				}
			]
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"pnpm\"",
			"value": "pnpm add next@canary"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"npm\"",
			"value": "npm i next@canary"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"yarn\"",
			"value": "yarn add next@canary"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"bun\"",
			"value": "bun add next@canary"
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Features available in canary"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The following features are currently available in canary:"
				}
			]
		},
