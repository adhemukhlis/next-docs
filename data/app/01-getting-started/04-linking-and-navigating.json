					"value": " for a deep dive into how streaming works in Next.js."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "For dynamic routes, it means they can be "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "partially prefetched"
						}
					]
				},
				{
					"type": "text",
					"value": ". That is, shared layouts and loading skeletons can be requested ahead of time."
				}
			]
		},
