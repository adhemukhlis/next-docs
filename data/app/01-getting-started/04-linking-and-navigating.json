		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Prefetching"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Prefetching is the process of loading a route in the background before the user navigates to it. This makes navigation between routes in your application feel instant, because by the time a user clicks on a link, the data to render the next route is already available client side."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Next.js automatically prefetches routes linked with the "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/api-reference/components/link",
					"children": [
						{
							"type": "inlineCode",
							"value": "<Link>"
						},
						{
							"type": "text",
							"value": " component"
						}
					]
				},
				{
					"type": "text",
					"value": " when they enter the user's viewport."
				}
			]
		},
		{
			"type": "code",
