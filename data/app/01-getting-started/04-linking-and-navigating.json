			"meta": "filename=\"app/layout.js\" switcher",
			"value": "import Link from 'next/link'\n\nexport default function Layout({ children }) {\n\treturn (\n\t\t<html>\n\t\t\t<body>\n\t\t\t\t<nav>\n\t\t\t\t\t{/* Prefetched when the link is hovered or enters the viewport */}\n\t\t\t\t\t<Link href=\"/blog\">Blog</Link>\n\t\t\t\t\t{/* No prefetching */}\n\t\t\t\t\t<a href=\"/contact\">Contact</a>\n\t\t\t\t</nav>\n\t\t\t\t{children}\n\t\t\t</body>\n\t\t</html>\n\t)\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "How much of the route is prefetched depends on whether it's static or dynamic:"
