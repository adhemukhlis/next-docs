		{
			"type": "yaml",
			"value": "title: Proxy\nnav_title: Proxy\ndescription: Use Next.js Proxy to rewrite, redirect, modify headers, or respond directly before a request completes.\nrelated:\n title: API Reference\n description: Learn more about Proxy\n links:\n  - app/api-reference/file-conventions/proxy\n  - app/guides/backend-for-frontend"
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Proxy"
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know"
								}
							]
						},
						{
							"type": "text",
							"value": ": Starting with Next.js 16, Middleware is now called Proxy to better reflect its purpose. The functionality remains the same."
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Proxy allows you to run code before a request is completed. Then, based on the incoming request, you can modify the response by rewriting, redirecting, modifying the request or response headers, or responding directly."
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Use cases"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Some common scenarios where Proxy is effective include:"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Modifying headers for all pages or a subset of pages"
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Rewriting to different pages based on A/B tests or experiments"
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Programmatic redirects based on incoming request properties"
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "For simple redirects, consider using the "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/api-reference/config/next-config-js/redirects",
					"children": [
						{
							"type": "inlineCode",
							"value": "redirects"
						}
					]
				},
				{
					"type": "text",
					"value": " configuration in "
				},
				{
					"type": "inlineCode",
					"value": "next.config.ts"
				},
				{
					"type": "text",
					"value": " first. Proxy should be used when you need access to request data or more complex logic."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Proxy is "
				},
				{
					"type": "emphasis",
					"children": [
						{
							"type": "text",
							"value": "not"
						}
					]
				},
				{
					"type": "text",
					"value": " intended for slow data fetching. While Proxy can be helpful for "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/guides/authentication#optimistic-checks-with-proxy-optional",
					"children": [
						{
							"type": "text",
							"value": "optimistic checks"
						}
					]
				},
				{
					"type": "text",
					"value": " such as permission-based redirects, it should not be used as a full session management or authorization solution."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Using fetch with "
				},
				{
					"type": "inlineCode",
					"value": "options.cache"
				},
				{
					"type": "text",
					"value": ", "
				},
				{
					"type": "inlineCode",
					"value": "options.next.revalidate"
				},
				{
					"type": "text",
					"value": ", or "
				},
				{
					"type": "inlineCode",
					"value": "options.next.tags"
				},
				{
					"type": "text",
					"value": ", has no effect in Proxy."
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Convention"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Create a "
				},
				{
					"type": "inlineCode",
					"value": "proxy.ts"
				},
				{
					"type": "text",
					"value": " (or "
				},
				{
					"type": "inlineCode",
					"value": ".js"
				},
				{
					"type": "text",
					"value": ") file in the project root, or inside "
				},
				{
					"type": "inlineCode",
					"value": "src"
				},
				{
					"type": "text",
					"value": " if applicable, so that it is located at the same level as "
				},
				{
					"type": "inlineCode",
					"value": "pages"
				},
				{
					"type": "text",
					"value": " or "
				},
				{
					"type": "inlineCode",
					"value": "app"
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Note"
								}
							]
						},
						{
							"type": "text",
							"value": ": While only one "
						},
						{
							"type": "inlineCode",
							"value": "proxy.ts"
						},
						{
							"type": "text",
							"value": " file is supported per project, you can still organize your proxy logic into modules. Break out proxy functionalities into separate "
						},
						{
							"type": "inlineCode",
							"value": ".ts"
						},
						{
							"type": "text",
							"value": " or "
						},
						{
							"type": "inlineCode",
							"value": ".js"
						},
						{
							"type": "text",
							"value": " files and import them into your main "
						},
						{
							"type": "inlineCode",
							"value": "proxy.ts"
						},
						{
							"type": "text",
							"value": " file. This allows for cleaner management of route-specific proxy, aggregated in the "
						},
						{
							"type": "inlineCode",
							"value": "proxy.ts"
						},
						{
							"type": "text",
							"value": " for centralized control. By enforcing a single proxy file, it simplifies configuration, prevents potential conflicts, and optimizes performance by avoiding multiple proxy layers."
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Example"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "You can export your proxy function as either a default export or a named "
				},
				{
					"type": "inlineCode",
					"value": "proxy"
				},
				{
					"type": "text",
					"value": " export:"
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": "filename=\"proxy.ts\" switcher",
			"value": "import { NextResponse } from 'next/server'\nimport type { NextRequest } from 'next/server'\n\n// This function can be marked `async` if using `await` inside\nexport function proxy(request: NextRequest) {\n\treturn NextResponse.redirect(new URL('/home', request.url))\n}\n\n// Alternatively, you can use a default export:\n// export default function proxy(request: NextRequest) { ... }\n\nexport const config = {\n\tmatcher: '/about/:path*',\n}"
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"proxy.js\" switcher",
			"value": "import { NextResponse } from 'next/server'\n\n// This function can be marked `async` if using `await` inside\nexport function proxy(request) {\n\treturn NextResponse.redirect(new URL('/home', request.url))\n}\n\n// Alternatively, you can use a default export:\n// export default function proxy(request) { ... }\n\nexport const config = {\n\tmatcher: '/about/:path*',\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The "
				},
				{
					"type": "inlineCode",
					"value": "matcher"
				},
				{
					"type": "text",
					"value": " config allows you to filter Proxy to run on specific paths. See the "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/api-reference/file-conventions/proxy#matcher",
					"children": [
						{
							"type": "text",
							"value": "Matcher"
						}
					]
				},
				{
					"type": "text",
					"value": " documentation for more details on path matching."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Read more about "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/guides/backend-for-frontend#proxy",
					"children": [
						{
							"type": "text",
							"value": "using "
						},
						{
							"type": "inlineCode",
							"value": "proxy"
						}
					]
				},
				{
					"type": "text",
					"value": ", or refer to the "
