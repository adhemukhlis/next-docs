			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Next.js "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/guides/prefetching",
					"children": [
						{
							"type": "text",
							"value": "prefetching"
						}
					]
				},
				{
					"type": "text",
					"value": " can place a route's React Server Component payload in the client cache before navigation."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The cache layers keep independent freshness policies and do not need matching durations. Cache identities and mutation invalidation must stay coordinated across layers."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Coordinate mutations"
