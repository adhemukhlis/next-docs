					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "An optimistic update should restore the previous browser value if the write fails. If the server read is not cached, there is no server tag to invalidate."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "After a mutation, invalidate any cached server read that provided the initial data:"
