								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "The data-fetching library"
										}
									]
								},
								{
									"type": "text",
									"value": " stores the browser value under a shared cache identity."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
