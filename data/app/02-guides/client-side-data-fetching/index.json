			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Server Components, data-fetching libraries, and mutations manage different parts of the data flow:"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "Server Components"
										}
									]
								},
								{
									"type": "text",
									"value": " provide the initial data, scoped to the segment that owns it."
