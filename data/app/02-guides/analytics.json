{
	"type": "root",
	"children": [
		{
			"type": "yaml",
			"value": "title: How to add analytics to your Next.js application\nnav_title: Analytics\ndescription: Measure and track page performance using Next.js Speed Insights"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Next.js has built-in support for measuring and reporting performance metrics. You can either use the "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/api-reference/functions/use-report-web-vitals",
					"children": [
						{
							"type": "inlineCode",
							"value": "useReportWebVitals"
						}
					]
				},
				{
					"type": "text",
					"value": " hook to manage reporting yourself, or alternatively, Vercel provides a "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://vercel.com/analytics?utm_source=next-site&utm_medium=docs&utm_campaign=next-website",
					"children": [
						{
							"type": "text",
							"value": "managed service"
						}
					]
				},
				{
					"type": "text",
					"value": " to automatically collect and visualize metrics for you."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Client Instrumentation"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "For more advanced analytics and monitoring needs, Next.js provides a "
				},
				{
					"type": "inlineCode",
					"value": "instrumentation-client.js|ts"
				},
				{
					"type": "text",
					"value": " file that runs before your application's frontend code starts executing. This is ideal for setting up global analytics, error tracking, or performance monitoring tools."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To use it, create an "
				},
				{
					"type": "inlineCode",
					"value": "instrumentation-client.js"
				},
				{
					"type": "text",
					"value": " or "
				},
				{
					"type": "inlineCode",
					"value": "instrumentation-client.ts"
				},
				{
					"type": "text",
					"value": " file in your application's root directory:"
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"instrumentation-client.js\"",
			"value": "// Initialize analytics before the app starts\nconsole.log('Analytics initialized')\n\n// Set up global error tracking\nwindow.addEventListener('error', (event) => {\n\t// Send to your error tracking service\n\treportError(event.error)\n})"
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Build Your Own"
				}
			]
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/_components/web-vitals.js\"",
			"value": "'use client'\n\nimport { useReportWebVitals } from 'next/web-vitals'\n\nexport function WebVitals() {\n\tuseReportWebVitals((metric) => {\n\t\tconsole.log(metric)\n\t})\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/layout.js\"",
			"value": "import { WebVitals } from './_components/web-vitals'\n\nexport default function Layout({ children }) {\n\treturn (\n\t\t<html>\n\t\t\t<body>\n\t\t\t\t<WebVitals />\n\t\t\t\t{children}\n\t\t\t</body>\n\t\t</html>\n\t)\n}"
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "Since the "
						},
						{
							"type": "inlineCode",
							"value": "useReportWebVitals"
						},
						{
							"type": "text",
							"value": " hook must be used in a Client Component, create a separate file for the "
						},
						{
							"type": "inlineCode",
							"value": "WebVitals"
						},
						{
							"type": "text",
							"value": " component with "
						},
						{
							"type": "inlineCode",
							"value": "'use client'"
						},
						{
							"type": "text",
							"value": " at the top, before any imports. Import this component into the root layout to keep the client boundary limited to this module and its imports."
						}
					]
				}
			]
		},
