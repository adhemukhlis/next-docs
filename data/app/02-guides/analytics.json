			"lang": "tsx",
			"meta": "filename=\"app/_components/web-vitals.tsx\" switcher",
			"value": "'use client'\n\nimport { useReportWebVitals } from 'next/web-vitals'\n\nexport function WebVitals() {\n\tuseReportWebVitals((metric) => {\n\t\tswitch (metric.name) {\n\t\t\tcase 'FCP': {\n\t\t\t\t// handle FCP results\n\t\t\t}\n\t\t\tcase 'LCP': {\n\t\t\t\t// handle LCP results\n\t\t\t}\n\t\t\t// ...\n\t\t}\n\t})\n}"
