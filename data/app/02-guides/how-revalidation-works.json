{
	"type": "root",
	"children": [
		{
			"type": "yaml",
			"value": "title: How revalidation works in Next.js\nnav_title: How Revalidation Works\ndescription: A deep dive into how Next.js revalidates cached content, including the tag system, cache consistency, and multi-instance coordination.\nrelated:\n description: Related guides and references.\n links:\n  - app/getting-started/caching\n  - app/guides/incremental-static-regeneration\n  - app/api-reference/config/next-config-js/cacheHandlers\n  - app/api-reference/functions/revalidateTag"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/getting-started/caching",
					"children": [
						{
							"type": "text",
							"value": "Caching"
						}
					]
				},
				{
					"type": "text",
					"value": " page covers how to use "
				},
				{
					"type": "inlineCode",
					"value": "use cache"
				},
				{
					"type": "text",
					"value": ", "
				},
				{
					"type": "inlineCode",
					"value": "cacheTag"
				},
				{
					"type": "text",
					"value": ", and "
				},
				{
					"type": "inlineCode",
					"value": "cacheLife"
				},
				{
					"type": "text",
					"value": ". This page explains "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "how revalidation works internally"
						}
					]
				},
				{
					"type": "text",
					"value": ", for platform engineers and advanced users who need to understand the system to implement "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/api-reference/config/next-config-js/cacheHandlers",
					"children": [
						{
							"type": "text",
							"value": "custom cache handlers"
						}
					]
				},
				{
					"type": "text",
					"value": " or debug revalidation behavior."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "The Revalidation Model"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Most routes in Next.js can be revalidated on demand. This includes App Router routes and Pages Router routes that produce ISR/prerender cache entries. Pages Router routes that are automatically statically optimized (pure static output) are not revalidated on demand. The ability to update cached content without redeploying is a core part of Next.js's "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/guides/rendering-philosophy",
					"children": [
						{
							"type": "text",
							"value": "rendering model"
						}
					]
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "There are two types of revalidation:"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "Time-based revalidation"
										}
									]
								},
								{
									"type": "text",
									"value": " uses a stale-while-revalidate pattern. The cached content is served immediately, and a background regeneration is triggered when the content's age exceeds the "
								},
								{
									"type": "link",
									"title": null,
									"url": "/docs/app/api-reference/functions/cacheLife",
									"children": [
										{
											"type": "inlineCode",
											"value": "cacheLife"
										}
									]
								},
								{
									"type": "text",
									"value": " or "
								},
								{
									"type": "inlineCode",
									"value": "revalidate"
								},
								{
									"type": "text",
									"value": " duration. The stale content continues to be served until the fresh content is ready."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "On-demand revalidation"
										}
									]
								},
								{
									"type": "text",
									"value": " explicitly invalidates cached content by calling "
								},
								{
									"type": "link",
									"title": null,
									"url": "/docs/app/api-reference/functions/revalidateTag",
									"children": [
										{
											"type": "inlineCode",
											"value": "revalidateTag()"
										}
									]
								},
								{
									"type": "text",
									"value": " or "
								},
								{
									"type": "link",
									"title": null,
									"url": "/docs/app/api-reference/functions/revalidatePath",
									"children": [
										{
											"type": "inlineCode",
											"value": "revalidatePath()"
										}
									]
								},
								{
									"type": "text",
									"value": ". The next request to that content triggers a fresh render."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know:"
								}
							]
						},
						{
							"type": "text",
							"value": " Pages Router on-demand ISR APIs (for example "
						},
						{
							"type": "inlineCode",
							"value": "res.revalidate()"
						},
						{
							"type": "text",
							"value": " and the "
						},
						{
							"type": "inlineCode",
							"value": "x-prerender-revalidate"
						},
						{
							"type": "text",
							"value": " flow) are still supported and use the server cache handler ("
						},
						{
							"type": "inlineCode",
							"value": "cacheHandler"
						},
						{
							"type": "text",
							"value": ", singular). The "
						},
						{
							"type": "inlineCode",
							"value": "cacheHandlers"
						},
						{
							"type": "text",
							"value": " option (plural) is for "
						},
						{
							"type": "inlineCode",
							"value": "'use cache'"
						},
						{
							"type": "text",
							"value": " directives."
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "What Gets Revalidated"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "When a route is revalidated, Next.js regenerates "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "both"
						}
					]
				},
				{
					"type": "text",
					"value": " the HTML response and the RSC payload (React Server Components payload) from the same React component tree. Both artifacts are stored together in the same cache entry."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "This consistency matters because the RSC payload is used for client-side navigations. Browser navigations and client-side navigations should hold the same content."
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "What happens if they get out of sync"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "If a platform's cache serves HTML from one render and an RSC payload from a different render, users may see stale or mismatched content during client-side navigation. The primary mitigation is to cache HTML and RSC responses together with the same TTL and invalidation policy, and to respect the "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/guides/cdn-caching",
					"children": [
						{
							"type": "inlineCode",
							"value": "Vary"
						},
						{
							"type": "text",
							"value": " header"
						}
					]
				},
				{
					"type": "text",
					"value": " that Next.js sets. See "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/guides/cdn-caching",
					"children": [
						{
							"type": "text",
							"value": "CDN Caching"
						}
					]
				},
				{
					"type": "text",
					"value": " for details."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "A separate but related problem is "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "cross-deployment skew"
						}
					]
				},
				{
					"type": "text",
					"value": ": during rolling deployments, a client built with deploy A may receive responses from a server running deploy B. "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/api-reference/config/next-config-js/deploymentId",
					"children": [
						{
							"type": "inlineCode",
							"value": "deploymentId"
						}
					]
				},
				{
					"type": "text",
					"value": " mitigates this: when the client detects a different deployment ID from the server, it triggers a hard navigation to fetch consistent content."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Tag System Architecture"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Next.js uses a tag-based system to track which cached content needs to be invalidated. There are two types of tags:"
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Explicit tags"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Explicit tags are set by the developer using "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/api-reference/functions/cacheTag",
					"children": [
						{
							"type": "inlineCode",
							"value": "cacheTag()"
						}
					]
				},
				{
					"type": "text",
					"value": " inside a "
				},
				{
					"type": "inlineCode",
					"value": "use cache"
				},
				{
					"type": "text",
					"value": " function, or via "
				},
				{
					"type": "inlineCode",
					"value": "next: { tags: [...] }"
				},
				{
					"type": "text",
					"value": " on a "
				},
				{
					"type": "inlineCode",
					"value": "fetch"
				},
				{
					"type": "text",
					"value": " call. When "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/api-reference/functions/revalidateTag",
					"children": [
						{
							"type": "inlineCode",
							"value": "revalidateTag('my-tag', 'max')"
						}
					]
				},
				{
					"type": "text",
					"value": " is called, all cache entries with that tag are invalidated."
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Soft tags"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Soft tags are automatically generated by Next.js based on the route path, prefixed with "
				},
				{
					"type": "inlineCode",
					"value": "_N_T_"
				},
				{
					"type": "text",
					"value": ". For example, the route "
				},
				{
					"type": "inlineCode",
					"value": "/blog/hello"
				},
				{
					"type": "text",
					"value": " generates soft tags like "
				},
				{
					"type": "inlineCode",
					"value": "_N_T_/layout"
				},
				{
					"type": "text",
					"value": ", "
				},
				{
					"type": "inlineCode",
					"value": "_N_T_/blog/layout"
				},
				{
					"type": "text",
					"value": ", "
				},
				{
					"type": "inlineCode",
					"value": "_N_T_/blog/hello/layout"
				},
				{
					"type": "text",
					"value": ", and "
				},
				{
					"type": "inlineCode",
					"value": "_N_T_/blog/hello"
				},
				{
					"type": "text",
					"value": ". Each segment in the path gets a layout tag, plus the leaf route itself."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Soft tags enable "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/api-reference/functions/revalidatePath",
					"children": [
						{
							"type": "inlineCode",
							"value": "revalidatePath()"
						}
					]
				},
				{
					"type": "text",
					"value": " to work through the same tag-based system. When "
				},
				{
					"type": "inlineCode",
					"value": "revalidatePath('/blog/hello')"
				},
				{
					"type": "text",
					"value": " is called, it invalidates cache entries associated with that path's leaf route tag and its ancestor layout soft tags (for example "
				},
				{
					"type": "inlineCode",
					"value": "_N_T_/layout"
				},
				{
					"type": "text",
					"value": ", "
				},
				{
					"type": "inlineCode",
					"value": "_N_T_/blog/layout"
				},
				{
					"type": "text",
					"value": ", "
				},
				{
					"type": "inlineCode",
					"value": "_N_T_/blog/hello/layout"
				},
				{
					"type": "text",
					"value": ", and "
				},
				{
					"type": "inlineCode",
					"value": "_N_T_/blog/hello"
				},
				{
					"type": "text",
					"value": ")."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "In the "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/api-reference/config/next-config-js/cacheHandlers",
					"children": [
						{
							"type": "text",
							"value": "cache handler API"
						}
					]
				},
				{
					"type": "text",
					"value": ", soft tags are passed to the "
				},
				{
					"type": "inlineCode",
					"value": "get()"
				},
				{
					"type": "text",
					"value": " method as the "
				},
				{
					"type": "inlineCode",
					"value": "softTags"
				},
				{
					"type": "text",
					"value": " parameter. Your handler should check whether any soft tag has been invalidated after the cache entry's timestamp. The "
				},
				{
					"type": "inlineCode",
					"value": "getExpiration()"
				},
				{
					"type": "text",
					"value": " method returns the most recent revalidation timestamp across all provided tags, or "
				},
				{
					"type": "inlineCode",
					"value": "0"
				},
				{
					"type": "text",
					"value": " if none have been revalidated. It can also return "
				},
				{
					"type": "inlineCode",
					"value": "Infinity"
				},
				{
					"type": "text",
					"value": " to signal that the soft tags should instead be passed to "
				},
				{
					"type": "inlineCode",
					"value": "get()"
				},
				{
					"type": "text",
					"value": " and checked for expiration there. Your handler should treat an entry as stale if the returned timestamp is newer than the entry's own timestamp. See the "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/api-reference/config/next-config-js/cacheHandlers#getexpiration",
					"children": [
						{
							"type": "text",
							"value": "cache handler API reference"
						}
					]
				},
				{
					"type": "text",
					"value": " for the full semantics."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Multi-Instance Considerations"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "When running multiple Next.js instances behind a load balancer, revalidation events are local by default. Calling "
				},
				{
					"type": "inlineCode",
					"value": "revalidateTag()"
				},
				{
					"type": "text",
					"value": " on instance A only invalidates the cache on that instance. Other instances continue serving the stale content until they learn about the invalidation."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The cache handler API provides two hooks for distributed coordination:"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "inlineCode",
											"value": "updateTags()"
										}
									]
								},
								{
									"type": "text",
									"value": " is called when "
								},
								{
									"type": "inlineCode",
									"value": "revalidateTag()"
								},
								{
									"type": "text",
									"value": " is invoked. Your handler should write the invalidation event to shared storage (for example, Redis or a database) so other instances can discover it."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "inlineCode",
											"value": "refreshTags()"
										}
									]
								},
								{
									"type": "text",
									"value": " is called periodically, but always before starting a new request. Your handler should check shared storage for recent invalidation events and update its local tag state accordingly."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "For implementation details and a Redis example, see "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/api-reference/config/next-config-js/cacheHandlers",
					"children": [
						{
							"type": "text",
							"value": "Custom Cache Handlers"
						}
					]
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Implementation Patterns for Platforms"
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Single instance"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The default file-system cache handles consistency automatically. Cache writes are atomic on the local filesystem, and tag state is maintained in memory. No additional configuration is needed."
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Multi-instance with shared cache"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Without coordination, each instance independently serves content and handles revalidation using only its local cache. Different users may see different content depending on which instance serves their request, and on-demand revalidation only takes effect on the instance that received the call."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To reduce this window and ensure revalidation propagates across instances:"
				}
			]
		},
		{
			"type": "list",
			"ordered": true,
			"start": 1,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Store tag invalidation timestamps in a shared service (Redis, DynamoDB, or a simple HTTP API)."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Implement "
								},
								{
									"type": "inlineCode",
									"value": "updateTags()"
								},
								{
									"type": "text",
									"value": " to write to the shared service."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Implement "
								},
								{
									"type": "inlineCode",
									"value": "refreshTags()"
								},
								{
									"type": "text",
									"value": " to read from the shared service. Your handler must catch errors in "
								},
								{
									"type": "inlineCode",
									"value": "refreshTags()"
								},
								{
									"type": "text",
									"value": ": if it throws, the exception propagates as a request failure. Catching the error allows requests to continue with the last known local tag state, serving potentially stale content until connectivity is restored."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Store cache entries (HTML + RSC payload) in shared storage. Atomic writes reduce the mismatch window further but are not required for correctness."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "CDN integration"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "If a CDN caches Next.js responses, it should respect the "
				},
				{
					"type": "inlineCode",
					"value": "Vary"
				},
				{
					"type": "text",
					"value": " header and the "
				},
				{
					"type": "inlineCode",
					"value": "Cache-Control"
				},
				{
					"type": "text",
					"value": " directives that Next.js sets. Do not cache HTML and RSC payload responses separately with different TTLs. See "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/guides/cdn-caching",
					"children": [
						{
							"type": "text",
							"value": "CDN Caching"
						}
					]
				},
				{
					"type": "text",
					"value": " for details."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Graceful Degradation"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The revalidation system prioritizes availability over strict consistency. Content is always served, even when infrastructure guarantees cannot be fully met:"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "Cache write failure"
										}
									]
								},
								{
									"type": "text",
									"value": ": the response is still served to the user because writes are asynchronous. The cache entry is lost, and the next request triggers a fresh render."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "Cache read failure"
										}
									]
								},
								{
									"type": "text",
									"value": ": your handler should catch internal errors and return "
								},
								{
									"type": "inlineCode",
									"value": "undefined"
								},
								{
									"type": "text",
									"value": " (the cache miss signal). The route is then server-rendered fresh. A thrown error is not treated as a cache miss; it propagates as a render error, so always return "
								},
								{
									"type": "inlineCode",
									"value": "undefined"
								},
								{
									"type": "text",
									"value": " to signal a miss."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "HTML/RSC cache inconsistency"
										}
									]
								},
								{
									"type": "text",
									"value": ": if a CDN caches HTML and RSC responses with different TTLs or invalidation timing, users may see mismatched content during client-side navigation. Cache them together and respect the "
								},
								{
									"type": "inlineCode",
									"value": "Vary"
								},
								{
									"type": "text",
									"value": " header to avoid this."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "Cross-deployment skew"
										}
									]
								},
								{
									"type": "text",
									"value": ": during rolling deployments, configure "
								},
								{
									"type": "link",
									"title": null,
									"url": "/docs/app/api-reference/config/next-config-js/deploymentId",
									"children": [
										{
											"type": "inlineCode",
											"value": "deploymentId"
										}
									]
								},
								{
									"type": "text",
									"value": " so that a build ID change triggers a hard navigation to fetch consistent content."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Cache failures result in degraded performance (stale content, extra renders), not broken applications."
				}
			]
		}
	]
}
