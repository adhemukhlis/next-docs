					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "link",
									"title": null,
									"url": "/docs/app/api-reference/functions/revalidatePath",
									"children": [
										{
											"type": "inlineCode",
											"value": "revalidatePath"
										}
									]
								},
								{
									"type": "text",
									"value": ": invalidate by URL path. Use when one route is affected and tagging is overkill."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "link",
									"title": null,
									"url": "/docs/app/api-reference/functions/refresh",
									"children": [
										{
											"type": "inlineCode",
											"value": "refresh"
										}
									]
								},
								{
									"type": "text",
									"value": ": refetch the current route's RSC Payload without invalidating cached data. Use when the view depends on state outside the cache that the action just changed."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "When "
				},
				{
					"type": "inlineCode",
					"value": "updateTag"
				},
				{
					"type": "text",
					"value": ", "
				},
				{
					"type": "inlineCode",
					"value": "revalidatePath"
				},
