	"children": [
		{
			"type": "yaml",
			"value": "title: How to optimize third-party libraries\nnav_title: Third Party Libraries\ndescription: Optimize the performance of third-party libraries in your application with the `@next/third-parties` package."
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "strong",
					"children": [
						{
							"type": "inlineCode",
							"value": "@next/third-parties"
						}
					]
				},
				{
					"type": "text",
					"value": " is a library that provides a collection of components and utilities that improve the performance and developer experience of loading popular third-party libraries in your Next.js application."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "All third-party integrations provided by "
				},
				{
					"type": "inlineCode",
					"value": "@next/third-parties"
				},
				{
					"type": "text",
					"value": " have been optimized for performance and ease of use."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Getting Started"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To get started, install the "
				},
				{
					"type": "inlineCode",
					"value": "@next/third-parties"
				},
				{
					"type": "text",
					"value": " library:"
				}
			]
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"pnpm\"",
			"value": "pnpm add @next/third-parties@latest next@latest"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"npm\"",
			"value": "npm install @next/third-parties@latest next@latest"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"yarn\"",
			"value": "yarn add @next/third-parties@latest next@latest"
		},
		{
			"type": "code",
			"lang": "bash",
			"meta": "package=\"bun\"",
			"value": "bun add @next/third-parties@latest next@latest"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "inlineCode",
					"value": "@next/third-parties"
				},
				{
					"type": "text",
					"value": " is currently an "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "experimental"
						}
					]
				},
				{
					"type": "text",
					"value": " library under active development. We recommend installing it with the "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "latest"
						}
					]
				},
				{
					"type": "text",
					"value": " or "
				},
