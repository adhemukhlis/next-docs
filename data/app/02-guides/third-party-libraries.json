					"type": "text",
					"value": " flags while we work on adding more third-party integrations."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Google Third-Parties"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "All supported third-party libraries from Google can be imported from "
				},
				{
					"type": "inlineCode",
					"value": "@next/third-parties/google"
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "Google Tag Manager"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The "
				},
				{
					"type": "inlineCode",
					"value": "GoogleTagManager"
				},
				{
					"type": "text",
					"value": " component can be used to instantiate a "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://developers.google.com/tag-platform/tag-manager",
					"children": [
						{
							"type": "text",
							"value": "Google Tag Manager"
						}
					]
				},
				{
					"type": "text",
					"value": " container to your page. By default, it fetches the original inline script after hydration occurs on the page."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To load Google Tag Manager for all routes, include the component directly in your root layout and pass in your GTM container ID:"
				}
			]
		},
		{
			"type": "code",
			"lang": "tsx",
			"meta": "filename=\"app/layout.tsx\" switcher",
			"value": "import { GoogleTagManager } from '@next/third-parties/google'\n\nexport default function RootLayout({ children }: { children: React.ReactNode }) {\n\treturn (\n\t\t<html lang=\"en\">\n\t\t\t<GoogleTagManager gtmId=\"GTM-XYZ\" />\n\t\t\t<body>{children}</body>\n\t\t</html>\n\t)\n}"
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/layout.js\" switcher",
			"value": "import { GoogleTagManager } from '@next/third-parties/google'\n\nexport default function RootLayout({ children }) {\n\treturn (\n\t\t<html lang=\"en\">\n\t\t\t<GoogleTagManager gtmId=\"GTM-XYZ\" />\n\t\t\t<body>{children}</body>\n\t\t</html>\n\t)\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "To load Google Tag Manager for a single route, include the component in your page file:"
				}
			]
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/page.js\"",
			"value": "import { GoogleTagManager } from '@next/third-parties/google'\n\nexport default function Page() {\n\treturn <GoogleTagManager gtmId=\"GTM-XYZ\" />\n}"
		},
		{
			"type": "heading",
			"depth": 4,
			"children": [
				{
					"type": "text",
					"value": "Sending Events"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The "
				},
				{
					"type": "inlineCode",
					"value": "sendGTMEvent"
				},
				{
					"type": "text",
					"value": " function can be used to track user interactions on your page by sending events using the "
				},
				{
					"type": "inlineCode",
					"value": "dataLayer"
				},
				{
					"type": "text",
					"value": " object. For this function to work, the "
				},
				{
					"type": "inlineCode",
					"value": "<GoogleTagManager />"
				},
				{
					"type": "text",
					"value": " component must be included in either a parent layout, page, or component, or directly in the same file."
				}
			]
		},
		{
			"type": "code",
			"lang": "jsx",
			"meta": "filename=\"app/page.js\"",
			"value": "'use client'\n\nimport { sendGTMEvent } from '@next/third-parties/google'\n\nexport function EventButton() {\n\treturn (\n\t\t<div>\n\t\t\t<button onClick={() => sendGTMEvent({ event: 'buttonClicked', value: 'xyz' })}>Send Event</button>\n\t\t</div>\n\t)\n}"
		},
