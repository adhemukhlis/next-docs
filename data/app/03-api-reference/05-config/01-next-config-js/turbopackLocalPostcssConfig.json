{
	"type": "root",
	"children": [
		{
			"type": "yaml",
			"value": "title: turbopackLocalPostcssConfig\ndescription: Enable per-directory PostCSS config resolution in Turbopack so that the config closest to each CSS file takes precedence over the project root config."
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The "
				},
				{
					"type": "inlineCode",
					"value": "turbopackLocalPostcssConfig"
				},
				{
					"type": "text",
					"value": " option changes how Turbopack resolves "
				},
				{
					"type": "inlineCode",
					"value": "postcss.config.js"
				},
				{
					"type": "text",
					"value": " files. When enabled, Turbopack searches for the config starting from the CSS file's own directory first, then falls back to the project root. By default, Turbopack checks the project root first, meaning a root-level "
				},
				{
					"type": "inlineCode",
					"value": "postcss.config.js"
				},
				{
					"type": "text",
					"value": " always takes precedence over configs in subdirectories."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "This option is only relevant when using Turbopack ("
				},
				{
					"type": "inlineCode",
					"value": "next dev"
				},
				{
					"type": "text",
					"value": " or "
				},
				{
					"type": "inlineCode",
					"value": "next build"
				},
				{
					"type": "text",
					"value": ")."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Usage"
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": "filename=\"next.config.ts\" switcher",
			"value": "import type { NextConfig } from 'next'\n\nconst nextConfig: NextConfig = {\n\texperimental: {\n\t\tturbopackLocalPostcssConfig: true,\n\t},\n}\n\nexport default nextConfig"
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\" switcher",
			"value": "/** @type {import('next').NextConfig} */\nconst nextConfig = {\n\texperimental: {\n\t\tturbopackLocalPostcssConfig: true,\n\t},\n}\n\nmodule.exports = nextConfig"
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Behavior"
				}
			]
		},
		{
			"type": "table",
			"align": [
				null,
				null
			],
			"children": [
				{
					"type": "tableRow",
					"children": [
						{
							"type": "tableCell",
							"children": [
								{
									"type": "text",
									"value": "Setting"
								}
							]
						},
						{
							"type": "tableCell",
							"children": [
								{
									"type": "text",
									"value": "Config resolution order"
								}
							]
						}
					]
				},
				{
					"type": "tableRow",
					"children": [
						{
							"type": "tableCell",
							"children": [
								{
									"type": "inlineCode",
									"value": "false"
								},
								{
									"type": "text",
									"value": " (default)"
								}
							]
						},
						{
							"type": "tableCell",
							"children": [
								{
									"type": "text",
									"value": "Project root → CSS file's directory"
								}
							]
						}
					]
				},
				{
					"type": "tableRow",
					"children": [
						{
							"type": "tableCell",
							"children": [
								{
									"type": "inlineCode",
									"value": "true"
								}
							]
						},
						{
							"type": "tableCell",
							"children": [
								{
									"type": "text",
									"value": "CSS file's directory → project root"
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "With the default behavior, a "
				},
				{
					"type": "inlineCode",
					"value": "postcss.config.js"
				},
				{
					"type": "text",
					"value": " at the project root is used for all CSS files, and per-directory configs are only applied if no root config exists. Enabling "
				},
				{
					"type": "inlineCode",
					"value": "turbopackLocalPostcssConfig"
				},
				{
					"type": "text",
					"value": " reverses this: per-directory configs take precedence, and the root config serves as the fallback."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Example"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "This is useful for projects that need different PostCSS transforms in different directories, such as a monorepo with multiple apps or design system packages:"
				}
			]
		},
		{
			"type": "code",
			"lang": null,
			"meta": null,
			"value": "my-app/\n├── postcss.config.js          ← fallback (applied if no local config is found)\n├── app/\n│   └── page.module.css        ← uses root config\n└── packages/\n    └── ui/\n        ├── postcss.config.js  ← takes precedence for files in this directory\n        └── button.module.css  ← uses packages/ui/postcss.config.js"
		},
		{
