{
	"type": "root",
	"children": [
		{
			"type": "yaml",
			"value": "title: transpilePackages\ndescription: Transpile and bundle dependencies from monorepo workspace packages or `node_modules` libraries that ship TypeScript, JSX, or modern syntax."
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Use "
				},
				{
					"type": "inlineCode",
					"value": "transpilePackages"
				},
				{
					"type": "text",
					"value": " to compile and bundle a dependency instead of treating it as untouched runtime code. Values are package names, including scoped names like "
				},
				{
					"type": "inlineCode",
					"value": "@scope/pkg"
				},
				{
					"type": "text",
					"value": ". Paths and glob patterns are not supported."
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\"",
			"value": "/** @type {import('next').NextConfig} */\nconst nextConfig = {\n\ttranspilePackages: ['package-name', '@scope/pkg'],\n}\n\nmodule.exports = nextConfig"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "This replaces the "
				},
				{
					"type": "inlineCode",
					"value": "next-transpile-modules"
				},
				{
					"type": "text",
					"value": " package."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "When you need it"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Turbopack transpiles workspace packages (npm, pnpm, or Yarn workspaces) in your monorepo automatically under both routers. Webpack does the same for the App Router. Add a package to "
				},
				{
					"type": "inlineCode",
					"value": "transpilePackages"
				},
				{
					"type": "text",
					"value": " when:"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "A "
										},
										{
											"type": "inlineCode",
											"value": "node_modules"
										},
										{
											"type": "text",
											"value": " dependency ships raw TypeScript or JSX."
										}
									]
								},
								{
									"type": "text",
									"value": " Next.js does not compile code inside "
								},
								{
									"type": "inlineCode",
									"value": "node_modules"
								},
								{
									"type": "text",
									"value": " by default. Listing the package opts it in, or you can build the package to plain JavaScript and point its "
								},
								{
									"type": "inlineCode",
									"value": "main"
								},
								{
									"type": "text",
									"value": "/"
								},
								{
									"type": "inlineCode",
									"value": "exports"
								},
								{
									"type": "text",
									"value": " at the compiled output."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "You build with webpack for the Pages Router and the dependency's source lives outside the next app's directory."
										}
									]
								},
								{
									"type": "text",
									"value": " For example, an "
								},
								{
									"type": "inlineCode",
									"value": "apps/web"
								},
								{
									"type": "text",
									"value": " app importing "
								},
								{
									"type": "inlineCode",
									"value": "packages/ui"
								},
								{
									"type": "text",
									"value": " in the same monorepo."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "You use the Pages Router and want a "
										},
										{
											"type": "inlineCode",
											"value": "node_modules"
										},
										{
											"type": "text",
											"value": " dependency bundled into the route."
										}
									]
								},
								{
									"type": "text",
									"value": " Pages Router loads "
								},
								{
									"type": "inlineCode",
									"value": "node_modules"
								},
								{
									"type": "text",
									"value": " server-side dependencies through Node.js "
								},
								{
									"type": "inlineCode",
									"value": "require"
								},
								{
									"type": "text",
									"value": " at runtime. List the package to bundle its source into the route instead. App Router already bundles Server Component and Route Handler dependencies unless the package is listed in "
								},
								{
									"type": "link",
									"title": null,
									"url": "/docs/app/api-reference/config/next-config-js/serverExternalPackages",
									"children": [
										{
											"type": "inlineCode",
											"value": "serverExternalPackages"
										}
									]
								},
								{
									"type": "text",
									"value": "."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know"
								}
							]
						},
						{
							"type": "text",
							"value": ": A package cannot appear in both "
						},
						{
							"type": "inlineCode",
							"value": "transpilePackages"
						},
						{
							"type": "text",
							"value": " and "
						},
						{
							"type": "link",
							"title": null,
							"url": "/docs/app/api-reference/config/next-config-js/serverExternalPackages",
							"children": [
								{
									"type": "inlineCode",
									"value": "serverExternalPackages"
								}
							]
						},
						{
							"type": "text",
							"value": "; Next.js throws at build start if it does. Packages listed in "
						},
						{
							"type": "link",
							"title": null,
							"url": "/docs/app/api-reference/config/next-config-js/optimizePackageImports",
							"children": [
								{
									"type": "inlineCode",
									"value": "optimizePackageImports"
								}
							]
						},
						{
							"type": "text",
							"value": " and the entries in "
						},
						{
							"type": "link",
							"title": null,
							"url": "https://github.com/vercel/next.js/blob/canary/packages/next/src/lib/default-transpiled-packages.json",
							"children": [
								{
									"type": "inlineCode",
									"value": "default-transpiled-packages.json"
								}
							]
						},
						{
							"type": "text",
							"value": " are added automatically; you do not need to repeat them."
						}
					]
				}
			]
		},
