									"type": "text",
									"value": "Good to know"
								}
							]
						},
						{
							"type": "text",
							"value": ": Since Next.js 13.5.1, Strict Mode is "
						},
						{
							"type": "inlineCode",
							"value": "true"
						},
						{
							"type": "text",
							"value": " by default with "
						},
						{
							"type": "inlineCode",
							"value": "app"
						},
						{
							"type": "text",
							"value": " router, so the above configuration is only necessary for "
						},
						{
							"type": "inlineCode",
							"value": "pages"
