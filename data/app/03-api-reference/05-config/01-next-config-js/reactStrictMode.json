						{
							"type": "text",
							"value": ". You can still disable Strict Mode by setting "
						},
						{
							"type": "inlineCode",
							"value": "reactStrictMode: false"
						},
						{
							"type": "text",
							"value": "."
						}
					]
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Suggested"
								}
							]
						},
						{
							"type": "text",
							"value": ": We strongly suggest you enable Strict Mode in your Next.js application to better prepare your application for the future of React."
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "React's "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://react.dev/reference/react/StrictMode",
					"children": [
						{
							"type": "text",
							"value": "Strict Mode"
						}
					]
				},
				{
					"type": "text",
					"value": " is a development mode only feature for highlighting potential problems in an application. It helps to identify unsafe lifecycles, legacy API usage, and a number of other features."
