{
	"type": "root",
	"children": [
		{
			"type": "yaml",
			"value": "title: Turbopack Memory Eviction\nnav_title: turbopackMemoryEviction\ndescription: Learn how to control Turbopack's memory eviction strategy for the persistent cache."
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Usage"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "inlineCode",
					"value": "turbopackMemoryEviction"
				},
				{
					"type": "text",
					"value": " controls whether Turbopack reclaims memory while the persistent (FileSystem) cache is enabled. After Turbopack writes a snapshot of its cache to disk, it can 'evict' the in-memory copies of that data and reload them from disk on demand."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Currently there are three options"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "inlineCode",
									"value": "false"
								},
								{
									"type": "text",
									"value": ": never evict. Cached data stays in memory for the lifetime of the process."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "inlineCode",
									"value": "'auto'"
								},
								{
									"type": "text",
									"value": " (default): evict after a snapshot only once enough memory has been allocated since the last eviction to make it worthwhile. Leverages thresholds and memory pressure feedback from the operating system."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "inlineCode",
									"value": "'full'"
								},
								{
									"type": "text",
									"value": ": evict all possible data from memory every time we save to disk."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know:"
								}
							]
						},
						{
							"type": "text",
							"value": " This option only has an effect in "
						},
						{
							"type": "inlineCode",
							"value": "next dev"
						},
						{
							"type": "text",
							"value": " sessions when the "
						},
						{
							"type": "link",
							"title": null,
							"url": "/docs/app/api-reference/config/next-config-js/turbopackFileSystemCache",
							"children": [
								{
									"type": "text",
									"value": "FileSystem Cache"
								}
							]
						},
						{
							"type": "text",
							"value": " is enabled, since eviction relies on data already being persisted to disk. It is experimental and under active development."
						}
					]
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": "filename=\"next.config.ts\" switcher",
			"value": "import type { NextConfig } from 'next'\n\nconst nextConfig: NextConfig = {\n\texperimental: {\n\t\tturbopackMemoryEviction: 'auto',\n\t},\n}\n\nexport default nextConfig"
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\" switcher",
			"value": "/** @type {import('next').NextConfig} */\nconst nextConfig = {\n\texperimental: {\n\t\tturbopackMemoryEviction: 'auto',\n\t},\n}\n\nmodule.exports = nextConfig"
		},
