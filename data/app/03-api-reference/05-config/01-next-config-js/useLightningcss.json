{
	"type": "root",
	"children": [
		{
			"type": "yaml",
			"value": "title: useLightningcss\ndescription: Enable experimental support for Lightning CSS.\nversion: experimental"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Experimental support for using "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://lightningcss.dev",
					"children": [
						{
							"type": "text",
							"value": "Lightning CSS"
						}
					]
				},
				{
					"type": "text",
					"value": " with webpack. Lightning CSS is a fast CSS transformer and minifier, written in Rust."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "If this option is not set, Next.js on webpack uses "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://postcss.org/",
					"children": [
						{
							"type": "text",
							"value": "PostCSS"
						}
					]
				},
				{
					"type": "text",
					"value": " with "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://www.npmjs.com/package/postcss-preset-env",
					"children": [
						{
							"type": "inlineCode",
							"value": "postcss-preset-env"
						}
					]
				},
				{
					"type": "text",
					"value": " by default."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Turbopack uses Lightning CSS by default since Next 14.2. This configuration option has no effect on Turbopack. Turbopack always uses Lightning CSS."
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": "filename=\"next.config.ts\" switcher",
			"value": "import type { NextConfig } from 'next'\n\nconst nextConfig: NextConfig = {\n\texperimental: {\n\t\tuseLightningcss: false, // default, ignored on Turbopack\n\t},\n}\n\nexport default nextConfig"
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\" switcher",
			"value": "/** @type {import('next').NextConfig} */\nconst nextConfig = {\n\texperimental: {\n\t\tuseLightningcss: true, // disables PostCSS on webpack\n\t},\n}\n\nmodule.exports = nextConfig"
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "inlineCode",
					"value": "lightningCssFeatures"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "By default, Lightning CSS decides which CSS features to transpile based on your "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://browsersl.ist/",
					"children": [
						{
							"type": "text",
							"value": "browserslist"
						}
					]
				},
				{
					"type": "text",
					"value": " targets. The "
				},
				{
					"type": "inlineCode",
					"value": "lightningCssFeatures"
				},
				{
					"type": "text",
					"value": " option lets you override this by forcing specific features to always be transpiled ("
				},
				{
					"type": "inlineCode",
					"value": "include"
				},
				{
					"type": "text",
					"value": ") or never be transpiled ("
				},
				{
					"type": "inlineCode",
					"value": "exclude"
				},
				{
					"type": "text",
					"value": "), regardless of browser support."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "This applies to both webpack (when "
				},
				{
					"type": "inlineCode",
					"value": "useLightningcss"
				},
				{
					"type": "text",
					"value": " is enabled) and Turbopack."
				}
			]
		},
		{
			"type": "code",
			"lang": "ts",
			"meta": "filename=\"next.config.ts\" switcher",
			"value": "import type { NextConfig } from 'next'\n\nconst nextConfig: NextConfig = {\n\texperimental: {\n\t\tuseLightningcss: true,\n\t\tlightningCssFeatures: {\n\t\t\t// Always transpile these features, even if targets support them\n\t\t\tinclude: ['light-dark', 'oklab-colors'],\n\t\t\t// Never transpile these features, even if targets don't support them\n\t\t\texclude: ['nesting'],\n\t\t},\n\t},\n}\n\nexport default nextConfig"
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\" switcher",
			"value": "/** @type {import('next').NextConfig} */\nconst nextConfig = {\n\texperimental: {\n\t\tuseLightningcss: true,\n\t\tlightningCssFeatures: {\n\t\t\t// Always transpile these features, even if targets support them\n\t\t\tinclude: ['light-dark', 'oklab-colors'],\n\t\t\t// Never transpile these features, even if targets don't support them\n\t\t\texclude: ['nesting'],\n\t\t},\n\t},\n}\n\nmodule.exports = nextConfig"
		},
