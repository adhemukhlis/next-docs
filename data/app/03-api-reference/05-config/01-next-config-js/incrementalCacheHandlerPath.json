{
	"type": "root",
	"children": [
		{
			"type": "yaml",
			"value": "title: Custom Next.js Cache Handler\nnav_title: cacheHandler\ndescription: Configure the Next.js cache used for storing and revalidating data to use any external service like Redis, Memcached, or others."
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "You can configure the Next.js cache location if you want to persist cached pages and data to durable storage, or share the cache across multiple containers or instances of your Next.js application."
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know"
								}
							]
						},
						{
							"type": "text",
							"value": ": The "
						},
						{
							"type": "inlineCode",
							"value": "cacheHandler"
						},
						{
							"type": "text",
							"value": " (singular) configuration is specifically used by Next.js for server cache operations such as storing and revalidating ISR, route handler responses, and optimized images. It is "
						},
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "not"
								}
							]
						},
						{
							"type": "text",
							"value": " used by "
						},
						{
							"type": "inlineCode",
							"value": "'use cache'"
						},
						{
							"type": "text",
							"value": " directives. For "
						},
						{
							"type": "inlineCode",
							"value": "'use cache'"
						},
						{
							"type": "text",
							"value": " directives, use "
						},
						{
							"type": "link",
							"title": null,
							"url": "/docs/app/api-reference/config/next-config-js/cacheHandlers",
							"children": [
								{
									"type": "inlineCode",
									"value": "cacheHandlers"
								}
							]
						},
						{
							"type": "text",
							"value": " (plural) instead. "
						},
						{
							"type": "link",
							"title": null,
							"url": "/docs/app/api-reference/config/next-config-js/cacheMaxMemorySize",
							"children": [
								{
									"type": "inlineCode",
									"value": "cacheMaxMemorySize"
								}
							]
						},
						{
							"type": "text",
							"value": " is separate from both, and sizes the in-memory cache for each."
						}
					]
				}
			]
		},
		{
			"type": "code",
			"lang": "js",
			"meta": "filename=\"next.config.js\"",
			"value": "module.exports = {\n\tcacheHandler: require.resolve('./cache-handler.js'),\n\tcacheMaxMemorySize: 0, // disable default in-memory caching\n}"
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "See the "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://github.com/vercel/next.js/tree/canary/examples/cache-handler-redis",
					"children": [
						{
							"type": "text",
							"value": "Redis "
						},
						{
							"type": "inlineCode",
							"value": "cacheHandler"
						},
						{
							"type": "text",
							"value": " example"
						}
					]
				},
				{
					"type": "text",
					"value": " for a working implementation, and "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/guides/self-hosting#configuring-caching",
					"children": [
						{
							"type": "text",
							"value": "Configuring Caching"
						}
					]
				},
				{
					"type": "text",
					"value": " for what a handler backed by a shared store needs."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "API Reference"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The cache handler can implement the following methods: "
				},
				{
					"type": "inlineCode",
