									"value": "ctx"
								}
							]
						},
						{
							"type": "tableCell",
							"children": [
								{
									"type": "inlineCode",
									"value": "object"
								}
							]
						},
						{
							"type": "tableCell",
							"children": [
								{
									"type": "text",
									"value": "Context including the cache entry kind."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The "
				},
				{
					"type": "inlineCode",
					"value": "ctx"
				},
				{
					"type": "text",
					"value": " parameter contains a "
				},
				{
					"type": "inlineCode",
					"value": "kind"
				},
				{
					"type": "text",
					"value": " property that indicates the type of cache entry being retrieved. Possible values include "
				},
				{
					"type": "inlineCode",
					"value": "'APP_PAGE'"
				},
				{
					"type": "text",
					"value": ", "
				},
				{
					"type": "inlineCode",
					"value": "'APP_ROUTE'"
				},
				{
					"type": "text",
					"value": ", "
				},
				{
					"type": "inlineCode",
					"value": "'PAGES'"
				},
				{
					"type": "text",
					"value": ", "
				},
				{
					"type": "inlineCode",
					"value": "'FETCH'"
				},
				{
					"type": "text",
					"value": ", and "
				},
				{
					"type": "inlineCode",
					"value": "'IMAGE'"
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Cache keys are opaque identifiers. Preserve the entire key when reading and writing entries; a key is not a request pathname."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Response keys include the response kind and a SHA-256 hash of the source route to keep different routes from sharing entries. Pages Router sources use the route definition's canonical "
				},
				{
					"type": "inlineCode",
					"value": "pathname"
				},
				{
					"type": "text",
					"value": ", so an index module has the same identity in both bundlers. App Router sources use the full "
				},
				{
					"type": "inlineCode",
					"value": "page"
				},
				{
					"type": "text",
					"value": " module name, including route groups and parallel slots. For example, a Pages Router response for "
				},
				{
					"type": "inlineCode",
					"value": "/blog/post"
				},
				{
					"type": "text",
					"value": " generated by "
				},
				{
					"type": "inlineCode",
					"value": "/blog/[slug]"
				},
				{
					"type": "text",
					"value": " uses "
				},
				{
					"type": "inlineCode",
					"value": "/route-cache/PAGES/<route-hash>/$/blog/post"
				},
				{
					"type": "text",
					"value": ", where "
				},
				{
					"type": "inlineCode",
					"value": "<route-hash>"
				},
				{
					"type": "text",
					"value": " is the 64-character hexadecimal SHA-256 digest of the UTF-8 source string "
				},
				{
					"type": "inlineCode",
					"value": "/blog/[slug]"
				},
				{
					"type": "text",
					"value": ". This bounds the added directory depth and avoids expanding Unicode source names on disk. The request pathname remains readable; the source route cannot be recovered from its hash. Handlers that previously interpreted keys as pathnames must account for this namespace. Fetch cache keys are unchanged."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Without a build adapter, prerendered responses remain at their historical "
				},
				{
					"type": "inlineCode",
					"value": "server/pages"
				},
				{
					"type": "text",
					"value": " and "
				},
				{
					"type": "inlineCode",
					"value": "server/app"
				},
				{
					"type": "text",
					"value": " paths. Their metadata identifies the exact scoped key, source owner, and fallback status that produced each immutable build seed. The built-in filesystem cache verifies that metadata before reading a historical seed, then promotes the complete response to "
				},
				{
					"type": "inlineCode",
					"value": "server/route-cache"
				},
				{
					"type": "text",
					"value": " while retaining the original artifact and its age. When an adapter is configured, build-time response artifacts are written directly to their scoped "
				},
				{
					"type": "inlineCode",
					"value": "server/route-cache"
				},
				{
					"type": "text",
					"value": " keys so colliding routes cannot overwrite one another before the adapter packages them. Static "
				},
				{
					"type": "inlineCode",
					"value": "output: 'export'"
				},
				{
					"type": "text",
					"value": " continues to emit normal public export files. Runtime reads and writes use only scoped keys. Custom cache handlers receive the opaque scoped key and are never queried with a historical pathname; an external response cache must preserve that key unchanged."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Runtime packaging must preserve the existing source-route metadata in the prerender manifest. Next.js also uses it to verify the allowed parameters and rendering mode of the selected route."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Integrations that read cached responses before invoking Next.js must also preserve source-route ownership when selecting entries. Removing the route namespace or falling back to pathname-only cache entries defeats that isolation."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Returns the cached value or "
				},
				{
					"type": "inlineCode",
					"value": "null"
				},
				{
					"type": "text",
					"value": " if not found."
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "inlineCode",
					"value": "set()"
				}
			]
		},
