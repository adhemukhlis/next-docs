				},
				{
					"type": "text",
					"value": ", "
				},
				{
					"type": "inlineCode",
					"value": "set"
				},
				{
					"type": "text",
					"value": ", "
				},
				{
					"type": "inlineCode",
					"value": "revalidateTag"
				},
				{
					"type": "text",
					"value": ", and "
				},
				{
					"type": "inlineCode",
					"value": "resetRequestCache"
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
