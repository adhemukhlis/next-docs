		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "For example, when a 404 page is streamed to the client, Next.js includes a "
				},
				{
					"type": "inlineCode",
					"value": "<meta name=\"robots\" content=\"noindex\">"
				},
				{
					"type": "text",
					"value": " tag in the streamed HTML. This prevents search engines from indexing that URL even if the HTTP status is 200. See Google’s guidance on the "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://developers.google.com/search/docs/crawling-indexing/robots-meta-tag",
					"children": [
						{
							"type": "inlineCode",
							"value": "robots"
						},
						{
							"type": "text",
							"value": " meta tag"
