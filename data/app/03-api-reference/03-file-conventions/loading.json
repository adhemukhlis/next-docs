				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Since streaming is server-rendered, it does not impact SEO. You can use the "
								},
								{
									"type": "link",
									"title": null,
