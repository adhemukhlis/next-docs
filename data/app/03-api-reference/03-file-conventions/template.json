							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "DOM reset"
										}
									]
								},
								{
									"type": "text",
									"value": ": DOM elements inside the template are fully recreated."
								}
							]
						}
					]
				}
