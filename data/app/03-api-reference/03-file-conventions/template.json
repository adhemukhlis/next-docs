			"value": "title: template.js\ndescription: API Reference for the template.js file."
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "A "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "template"
						}
					]
				},
				{
					"type": "text",
					"value": " file is similar to a "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/getting-started/layouts-and-pages#creating-a-layout",
					"children": [
						{
							"type": "text",
							"value": "layout"
						}
					]
				},
				{
					"type": "text",
					"value": " in that it wraps a layout or page. Unlike layouts that persist across routes and maintain state, templates are given a unique key, meaning children Client Components reset their state on navigation."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "They are useful when you need to:"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Resynchronize "
								},
								{
									"type": "inlineCode",
									"value": "useEffect"
								},
								{
									"type": "text",
									"value": " on navigation."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Reset the state of a child Client Components on navigation. For example, an input field."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "To change default framework behavior. For example, Suspense boundaries inside layouts only show a fallback on first load, while templates show it on every navigation."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Convention"
				}
