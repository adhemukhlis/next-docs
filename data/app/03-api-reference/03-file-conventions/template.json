						{
							"type": "paragraph",
							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "Server Components"
										}
									]
								},
								{
									"type": "text",
									"value": ": By default, templates are Server Components."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
