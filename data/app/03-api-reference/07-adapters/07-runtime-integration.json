{
	"type": "root",
	"children": [
		{
			"type": "yaml",
			"value": "title: Runtime Integration\ndescription: Understand how build-time adapters and runtime cache interfaces work together."
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The Deployment Adapter API is a "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "build-time"
						}
					]
				},
				{
					"type": "text",
					"value": " interface. It tells your platform what was built and how to route requests. "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "Runtime"
						}
					]
				},
				{
					"type": "text",
					"value": " behavior (request handling, streaming, caching) is handled by the Next.js server itself and by the cache interfaces "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/api-reference/config/next-config-js/incrementalCacheHandlerPath",
					"children": [
						{
							"type": "inlineCode",
							"value": "cacheHandler"
						}
					]
				},
				{
					"type": "text",
					"value": " and "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/api-reference/config/next-config-js/cacheHandlers",
					"children": [
						{
							"type": "inlineCode",
							"value": "cacheHandlers"
						}
					]
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Together, the adapter and cache interfaces form the complete platform integration surface:"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "Adapter"
										}
									]
								},
								{
									"type": "text",
									"value": " (build-time): processes build outputs, configures routing, and sets up platform-specific infrastructure."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "Cache Interfaces"
										}
									]
								},
								{
									"type": "text",
									"value": " (runtime): "
								},
								{
									"type": "inlineCode",
									"value": "cacheHandler"
								},
								{
									"type": "text",
									"value": " manages ISR/server cache storage and revalidation across instances; "
								},
								{
									"type": "inlineCode",
									"value": "cacheHandlers"
								},
								{
									"type": "text",
									"value": " configures "
								},
								{
									"type": "inlineCode",
									"value": "'use cache'"
								},
								{
									"type": "text",
									"value": " directive backends and tag coordination."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "Handler Context"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "When invoking entrypoints, adapters pass a "
				},
				{
					"type": "inlineCode",
					"value": "ctx"
				},
				{
					"type": "text",
					"value": " object to the Next.js handler. Key fields include:"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "inlineCode",
											"value": "ctx.waitUntil"
										}
									]
								},
								{
									"type": "text",
									"value": ": a function that accepts a promise. Use this to keep the serverless function alive after the response is sent, allowing background work like cache revalidation to complete."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "inlineCode",
											"value": "requestMeta.onCacheEntryV2"
										}
									]
								},
								{
									"type": "text",
									"value": " (set via "
								},
								{
									"type": "inlineCode",
									"value": "addRequestMeta"
								},
								{
									"type": "text",
									"value": "): a callback that fires when a cache entry is generated or looked up. Use this to observe all cache operations (not just PPR) and propagate cache updates to your platform's storage backend. This callback fires on the instance that handled the request. For multi-instance deployments, your adapter should propagate updates to shared storage. See "
								},
								{
									"type": "link",
									"title": null,
									"url": "/docs/app/guides/how-revalidation-works",
									"children": [
										{
											"type": "text",
											"value": "How Revalidation Works"
										}
									]
								},
								{
									"type": "text",
									"value": " for coordination patterns."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
					"type": "text",
					"value": "PPR Chain Headers"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "In the "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/api-reference/adapters/output-types#prerenders-outputsprerenders",
					"children": [
						{
							"type": "text",
							"value": "prerenders output type"
						}
					]
				},
				{
					"type": "text",
					"value": ", "
				},
				{
					"type": "inlineCode",
					"value": "pprChain.headers"
				},
				{
					"type": "text",
					"value": " contains the headers needed for the "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/api-reference/adapters/implementing-ppr-in-an-adapter",
					"children": [
						{
							"type": "text",
							"value": "resume protocol"
						}
					]
				},
				{
					"type": "text",
					"value": ". Specifically, it contains "
				},
				{
					"type": "inlineCode",
					"value": "{ 'next-resume': '1' }"
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "When your adapter detects a PPR-enabled route with a cached static shell:"
				}
			]
		},
		{
			"type": "list",
			"ordered": true,
			"start": 1,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Set the "
								},
								{
									"type": "inlineCode",
									"value": "pprChain.headers"
								},
								{
									"type": "text",
									"value": " on the internal request to the Next.js handler."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "Send the request as a "
								},
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "POST"
										}
									]
								},
								{
									"type": "text",
									"value": " with the "
								},
								{
									"type": "inlineCode",
									"value": "postponedState"
								},
								{
									"type": "text",
									"value": " as the request body."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "The handler will render only the deferred Suspense boundaries and stream the result."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "strong",
							"children": [
								{
									"type": "text",
									"value": "Good to know:"
								}
							]
						},
						{
							"type": "text",
							"value": " In standard "
						},
						{
							"type": "inlineCode",
							"value": "next start"
						},
						{
							"type": "text",
							"value": ", the server handles both the shell and dynamic render in a single pass automatically. The resume protocol is useful for adapter-based deployments and CDN-to-origin architectures that want to serve the shell separately. See the "
						},
						{
							"type": "link",
							"title": null,
							"url": "/docs/app/guides/ppr-platform-guide",
							"children": [
								{
									"type": "text",
									"value": "PPR Platform Guide"
								}
							]
						},
						{
							"type": "text",
							"value": " for the full implementation context."
						}
					]
				}
			]
		}
	]
}
