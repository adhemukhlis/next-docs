					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "Static routes and routes with "
										},
										{
											"type": "link",
											"title": null,
											"url": "/docs/app/api-reference/functions/generate-static-params",
											"children": [
												{
													"type": "inlineCode",
													"value": "generateStaticParams"
												}
											]
										}
									]
								},
								{
									"type": "text",
									"value": ": every route segment, including dynamic params, is known at build time. The active segment can be resolved during prerendering, so "
								},
								{
									"type": "inlineCode",
									"value": "useSelectedLayoutSegment"
								},
								{
									"type": "text",
									"value": " resolves on the server and no "
								},
								{
									"type": "inlineCode",
									"value": "Suspense"
								},
								{
									"type": "text",
									"value": " boundary is required."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "Routes with dynamic params not covered by "
										},
										{
											"type": "inlineCode",
											"value": "generateStaticParams"
										}
									]
								},
								{
									"type": "text",
									"value": ": the param is a "
								},
								{
									"type": "link",
									"title": null,
									"url": "/docs/app/api-reference/functions/generate-static-params#all-paths-at-build-time",
									"children": [
										{
											"type": "text",
											"value": "fallback param"
										}
									]
								},
								{
									"type": "text",
									"value": " that is not known until request time. The active segment cannot be resolved during prerendering, so "
								},
								{
									"type": "inlineCode",
									"value": "useSelectedLayoutSegment"
								},
								{
									"type": "text",
									"value": " suspends. Wrap the component (or a parent) in a "
								},
								{
									"type": "inlineCode",
									"value": "Suspense"
								},
								{
									"type": "text",
									"value": " boundary so its fallback can be rendered during prerendering; otherwise, the build fails."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "This applies even when the component that calls "
				},
				{
					"type": "inlineCode",
					"value": "useSelectedLayoutSegment"
				},
				{
					"type": "text",
					"value": " is itself static. For example, a tab bar rendered in a parent layout suspends on any page below it that has an unknown dynamic param. To keep the rest of the layout prerendered, wrap the component that calls "
				},
				{
					"type": "inlineCode",
					"value": "useSelectedLayoutSegment"
				},
				{
					"type": "text",
					"value": " (or a parent) in a "
				},
				{
					"type": "inlineCode",
					"value": "Suspense"
				},
				{
					"type": "text",
					"value": " boundary with a fallback."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "See "
				},
