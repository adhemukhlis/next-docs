				{
					"type": "inlineCode",
					"value": "useSelectedLayoutSegment"
				},
				{
					"type": "text",
					"value": " to create an active link component that changes style depending on the active segment. For example, a featured posts list in the sidebar of a blog:"
				}
			]
		},
