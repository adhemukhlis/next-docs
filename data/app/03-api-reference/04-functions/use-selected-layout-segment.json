					"value": " is enabled, "
				},
				{
					"type": "inlineCode",
					"value": "useSelectedLayoutSegment"
				},
				{
					"type": "text",
					"value": " may require a "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://react.dev/reference/react/Suspense",
					"children": [
						{
							"type": "inlineCode",
							"value": "Suspense"
						}
					]
				},
				{
					"type": "text",
					"value": " boundary. This depends on whether the active segment can be resolved during prerendering."
				}
