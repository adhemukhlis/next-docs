							"value": "Next.js encountered URL data in a Client Component outside of Suspense"
						}
					]
				},
				{
					"type": "text",
					"value": " for full fix options and trade-offs."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
				{
