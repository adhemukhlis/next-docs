			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "When "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/app/api-reference/config/next-config-js/cacheComponents",
					"children": [
						{
							"type": "inlineCode",
							"value": "cacheComponents"
						}
					]
				},
				{
					"type": "text",
					"value": " is enabled, "
				},
				{
					"type": "inlineCode",
					"value": "useSelectedLayoutSegments"
				},
				{
					"type": "text",
					"value": " may require a "
				},
				{
					"type": "link",
					"title": null,
					"url": "https://react.dev/reference/react/Suspense",
					"children": [
						{
							"type": "inlineCode",
							"value": "Suspense"
						}
					]
				},
				{
					"type": "text",
					"value": " boundary. This depends on whether the active segments can be resolved during prerendering."
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": false,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "Static routes and routes with "
										},
										{
											"type": "link",
											"title": null,
											"url": "/docs/app/api-reference/functions/generate-static-params",
											"children": [
												{
													"type": "inlineCode",
													"value": "generateStaticParams"
												}
											]
										}
									]
								},
								{
									"type": "text",
									"value": ": every route segment, including dynamic params, is known at build time. The active segments can be resolved during prerendering, so "
								},
								{
									"type": "inlineCode",
									"value": "useSelectedLayoutSegments"
								},
								{
									"type": "text",
									"value": " resolves on the server and no "
								},
								{
									"type": "inlineCode",
									"value": "Suspense"
								},
								{
									"type": "text",
									"value": " boundary is required."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "Routes with dynamic params not covered by "
										},
										{
											"type": "inlineCode",
											"value": "generateStaticParams"
										}
									]
								},
								{
									"type": "text",
									"value": ": the param is a "
								},
								{
									"type": "link",
									"title": null,
									"url": "/docs/app/api-reference/functions/generate-static-params#all-paths-at-build-time",
									"children": [
										{
											"type": "text",
											"value": "fallback param"
										}
									]
								},
								{
									"type": "text",
									"value": " that is not known until request time. The active segments cannot be resolved during prerendering, so "
								},
								{
									"type": "inlineCode",
									"value": "useSelectedLayoutSegments"
								},
								{
									"type": "text",
									"value": " suspends. Wrap the component (or a parent) in a "
								},
								{
									"type": "inlineCode",
									"value": "Suspense"
								},
								{
									"type": "text",
									"value": " boundary so its fallback can be rendered during prerendering; otherwise, the build fails."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "This applies even when the component that calls "
				},
				{
					"type": "inlineCode",
					"value": "useSelectedLayoutSegments"
				},
				{
					"type": "text",
					"value": " is itself static. For example, a breadcrumb component rendered in a parent layout suspends on any page below it that has an unknown dynamic param. To keep the rest of the layout prerendered, wrap the component that calls "
				},
				{
					"type": "inlineCode",
					"value": "useSelectedLayoutSegments"
				},
				{
					"type": "text",
					"value": " (or a parent) in a "
				},
				{
					"type": "inlineCode",
					"value": "Suspense"
				},
				{
					"type": "text",
					"value": " boundary with a fallback."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "See "
				},
				{
					"type": "link",
					"title": null,
					"url": "/docs/messages/blocking-prerender-client-hook",
					"children": [
						{
