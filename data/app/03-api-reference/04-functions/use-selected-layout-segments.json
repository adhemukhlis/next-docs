					"value": " the Layout it is called from."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "It is useful for creating UI in parent Layouts that need knowledge of active child segments such as breadcrumbs."
				}
			]
		},
		{
			"type": "code",
