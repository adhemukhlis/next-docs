		},
		{
			"type": "heading",
			"depth": 3,
			"children": [
				{
					"type": "text",
					"value": "React version handling"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The App Router and Pages Router handle React versions differently:"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"spread": true,
			"children": [
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "App Router"
										}
									]
								},
								{
									"type": "text",
									"value": ": Uses "
								},
								{
									"type": "link",
									"title": null,
									"url": "https://react.dev/blog/2023/05/03/react-canaries",
									"children": [
										{
											"type": "text",
											"value": "React canary releases"
										}
									]
								},
								{
									"type": "text",
									"value": " built-in, which include all the stable React 19 changes, as well as newer features being validated in frameworks, prior to a new React release."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"spread": false,
					"checked": null,
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "strong",
									"children": [
										{
											"type": "text",
											"value": "Pages Router"
										}
									]
								},
								{
									"type": "text",
									"value": ": Uses the React version installed in your project's "
								},
								{
									"type": "inlineCode",
									"value": "package.json"
								},
								{
									"type": "text",
									"value": "."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "This approach ensures new React features work reliably in the App Router while maintaining backwards compatibility for existing Pages Router applications."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"children": [
